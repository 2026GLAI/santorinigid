---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reviews from '../components/Reviews.astro';
import ReviewForm from '../components/ReviewForm.astro';
import CtaBand from '../components/CtaBand.astro';
import { WHATSAPP, pageUrl } from '../data/site';
import { REVIEWS } from '../data/reviews';
import { fillDeep } from '../data/fill';
import data from '../data/pages/reviews-page.json';

/*
 * ТЕКСТЫ СТРАНИЦЫ ЖИВУТ В src/data/pages/reviews-page.json, сами отзывы —
 * в src/data/reviews.json; владелец правит и то и другое через /admin.
 * Числа в текстах — метки {ОТЗЫВОВ_СЛОВОМ}, {ПЛОЩАДКИ_ОТЗЫВОВ} и др.:
 * считаются из самих отзывов (fill.ts). Заголовок укорочен 06.08.2026
 * (был 63 знака — Google резал хвост) и ведёт ключевой запрос владельца
 * «гид на Санторини».
 */
const t = fillDeep(data);

/**
 * Самый свежий отзыв выносим в шапку: пусть страницу открывает живой голос
 * гостя, а не декоративная картинка. Длинный текст подрезаем по границе
 * предложения — в шапке нужен фрагмент, целиком он ниже в общем списке.
 */
const latest = REVIEWS[0];
const MAX_EXCERPT = 260;
const latestExcerpt = (() => {
  if (!latest || latest.text.length <= MAX_EXCERPT) return latest?.text ?? '';
  const cut = latest.text.slice(0, MAX_EXCERPT);
  const lastStop = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('! '), cut.lastIndexOf('? '));
  return lastStop > 120 ? cut.slice(0, lastStop + 1) : `${cut.slice(0, cut.lastIndexOf(' '))}…`;
})();

/**
 * ⚠️ Разметки Review здесь НЕТ — и это решение, а не забывчивость
 * (стояла до 06.08.2026, убрана по итогам аудита):
 *  1. Оценок нет в источнике — на Tourister у отзывов нет поля рейтинга,
 *     на NeedGuide рейтинг отключён (ratingOff: true). Проставить «5» =
 *     выдумать цифру, которую клиенты не ставили. А Review без оценки
 *     Google считает ошибкой схемы и сыпал бы её в Search Console.
 *  2. Даже с оценками звёзд в Google не будет: по правилам Google страницы
 *     LocalBusiness/Organization с отзывами о самих себе не участвуют в
 *     показе звёзд. [ПРОВЕРЕНО: developers.google.com/search/docs/appearance/
 *     structured-data/review-snippet]
 *
 * Поисковики и ИИ ничего не теряют: все 22 отзыва с именами и датами
 * целиком лежат в HTML этой страницы (принцип №1 в Reviews.astro)
 * и описаны в llms.txt. Звёзды в поиске появляются из Google Business
 * Profile — это отдельная задача владельца, см. docs/promotion-plan.md
 */
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: pageUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Отзывы', item: pageUrl('/reviews') },
    ],
  },
];
---

<BaseLayout
  title={t.seo.title}
  description={t.seo.description}
  schema={schema}
  edit={[
    { label: 'Тексты страницы', entry: 'pages/reviews-page' },
    { label: 'Сами отзывы', entry: 'content/reviews' },
  ]}
>
  <section class="section rv-hero">
    <div class="container rv-hero-grid">
      <div class="rv-hero-text">
        <p class="eyebrow">{t.header.eyebrow}</p>
        <h1>{t.header.title}</h1>
        <p class="lede">{t.header.lede}</p>
        <div class="rv-hero-actions">
          <a href="#review-form" class="btn btn-primary">{t.header.buttonLeave}</a>
          <a href={WHATSAPP.tour} class="btn btn-whatsapp" target="_blank" rel="noopener">
            {t.header.buttonDiscuss}
          </a>
        </div>
      </div>

      {/* Самый свежий отзыв — вместо декоративной картинки говорит гость */}
      {
        latest && (
          <figure class="rv-hero-quote">
            <blockquote>{latestExcerpt}</blockquote>
            <figcaption>
              <strong>{latest.author}</strong>
              <span>
                {latest.tripDate || latest.published}
                {latest.tripWith && ` · ${latest.tripWith}`}
              </span>
            </figcaption>
          </figure>
        )
      }
    </div>
  </section>

  {/* Сразу видно 9 (три ряда по три колонки), остальные — под кнопкой
      «Ещё N отзывов». Решение владельца 28.07.2026: отзывов будет
      становиться больше, страница не должна расти бесконечно.
      Скрытые физически лежат в HTML — поисковики видят все. */}
  <Reviews title={t.listTitle} eyebrow="" lede="" visible={9} showForm={false} />

  <ReviewForm />

  <CtaBand />
</BaseLayout>

<style>
  .rv-hero {
    padding-bottom: 0;
    background:
      radial-gradient(
        90% 120% at 88% 0%,
        color-mix(in srgb, var(--accent) 10%, transparent),
        transparent 60%
      );
  }

  .rv-hero-grid {
    display: grid;
    gap: var(--sp-7);
    align-items: center;
  }

  .rv-hero h1 {
    font-size: var(--fs-3xl);
    margin-top: var(--sp-3);
  }

  .rv-hero .lede {
    margin-top: var(--sp-4);
  }

  .rv-hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
  }

  /* Свежий отзыв в шапке: крупная цитата вместо картинки */
  .rv-hero-quote {
    position: relative;
    padding: var(--sp-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  .rv-hero-quote::before {
    content: '”';
    position: absolute;
    top: -0.35em;
    left: var(--sp-5);
    font-family: var(--font-display);
    font-size: 5rem;
    line-height: 1;
    color: color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .rv-hero-quote blockquote {
    position: relative;
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-style: italic;
    line-height: 1.6;
    color: var(--text);
    text-wrap: pretty;
  }

  .rv-hero-quote figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: var(--sp-4);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--border);
  }

  .rv-hero-quote figcaption strong {
    font-size: var(--fs-sm);
  }

  .rv-hero-quote figcaption span {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  @container page (min-width: 960px) {
    .rv-hero-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--sp-8);
    }
  }
</style>
