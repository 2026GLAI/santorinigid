---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../data/url';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import Reviews from '../components/Reviews.astro';
import {
  WHATSAPP,
  EXTERNAL,
  SITE_URL,
  OWNER_FULL_NAME,
  PROFILES,
  ON_ISLAND_SINCE,
  CURRENT_YEAR,
  ISLAND_YEARS_TEXT,
  GUIDE_YEARS_TEXT,
  YEARS_AS_GUIDE,
  plural,
  pageUrl,
} from '../data/site';
import { YACHTS } from '../data/yachts';
import { getImg } from '../data/images';
import { fillDeep } from '../data/fill';
import data from '../data/pages/index.json';

/*
 * СОДЕРЖИМОЕ СТРАНИЦЫ ЖИВЁТ В src/data/pages/index.json — его правит
 * владелец через админку /admin (этап 2, 06.08.2026). Здесь только каркас,
 * вычисления и разметка для поисковиков. Метки {ГОД}, {ЛЕТ_НА_ОСТРОВЕ},
 * {СУДОВ_ВО_ФЛОТЕ} и другие подставляет сборка — см. src/data/fill.ts.
 */
const t = fillDeep(data);

const heroOia = getImg(t.hero.image);

/** Разметка для поисковиков: сайт + личность гида. */
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    url: pageUrl('/'),
    name: 'Гид на Санторини — Владимир',
    inLanguage: 'ru',
    publisher: { '@id': `${SITE_URL}/#business` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: OWNER_FULL_NAME,
    alternateName: 'Владимир',
    jobTitle: 'Частный русскоязычный гид на Санторини',
    knowsLanguage: ['ru', 'el'],
    worksFor: { '@id': `${SITE_URL}/#business` },
    sameAs: [...PROFILES],
    description: `Живёт на Санторини с ${ON_ISLAND_SINCE} года (${ISLAND_YEARS_TEXT}), ${GUIDE_YEARS_TEXT} профессионального опыта проведения индивидуальных экскурсий.`,
  },
];

/*
 * Плашки-факты СЧИТАЮТСЯ и в админку не выносятся намеренно: числа и
 * склонения («14 лет как гид», «8 судов во флоте») обновляются сами —
 * в 2033 году стаж станет 21 год, и «21 лет» выглядело бы ошибкой.
 * Это единственный блок главной, который правится только в коде.
 * Версия 2: плашка лежит тёмной полосой в низу первого экрана (как в
 * брифе), а не в блоке «Знакомство».
 */
const YEARS_ON_ISLAND = CURRENT_YEAR - ON_ISLAND_SINCE;
const facts = [
  {
    n: String(YEARS_ON_ISLAND),
    label: `${plural(YEARS_ON_ISLAND, 'год', 'года', 'лет')} на Санторини`,
    sub: `с ${ON_ISLAND_SINCE} года`,
  },
  {
    n: String(YEARS_AS_GUIDE),
    label: `${plural(YEARS_AS_GUIDE, 'год', 'года', 'лет')} как гид`,
    sub: 'индивидуальные экскурсии',
  },
  {
    n: String(YACHTS.length),
    label: plural(YACHTS.length, 'судно во флоте', 'судна во флоте', 'судов во флоте'),
    sub: 'яхты и катамараны',
  },
  /* «24/7 на связи» было про Владимира — неправда для живого человека
     (его замечание 06.08.2026): круглосуточно дежурит ИИ-помощник. */
  { n: '24/7', label: 'ИИ-помощник на связи', sub: 'ответит в любое время' },
];
---

<BaseLayout
  title={t.seo.title}
  description={t.seo.description}
  schema={schema}
  edit={[{ label: 'Тексты главной', entry: 'pages/main' }]}
  darkTop
>
  <Hero
    image={heroOia}
    alt={t.hero.alt}
    size="full"
    focusMobile="76% 50%"
    priority
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    subtitle={t.hero.subtitle}
    text={t.hero.text}
  >
    <a href={url('/tours')} class="btn btn-primary btn-lg">{t.hero.buttonTour}</a>
    <a href={WHATSAPP.tour} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener">
      {t.hero.buttonWhatsApp}
    </a>

    <div slot="bar" class="hero-bar">
      <ul class="container hero-facts">
        {
          facts.map((f) => (
            <li>
              <strong>{f.n}</strong>
              <span class="fact-label">{f.label}</span>
              <span class="fact-sub">{f.sub}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Hero>

  <!-- Знакомство -->
  <section class="section" id="content">
    <div class="container about-grid">
      <div class="about-photo reveal-zoom">
        <Image
          src={getImg(t.about.photo)}
          alt={t.about.photoAlt}
          widths={[380, 560, 760, 980]}
          sizes="(min-width: 900px) 420px, 90vw"
          quality={86}
        />
        <div class="about-badge">
          <strong>{ISLAND_YEARS_TEXT}</strong>
          <span>{t.about.badgeLabel}</span>
        </div>
      </div>

      <div class="about-text reveal">
        <p class="eyebrow">{t.about.eyebrow}</p>
        <h2 class="section-title">{t.about.title}</h2>
        <p class="lede">{t.about.lede}</p>
        <p>{t.about.text}</p>
        <p class="signature">{t.about.signature}</p>
        <a href={url('/about')} class="btn btn-ghost">{t.about.button}</a>
      </div>
    </div>
  </section>

  <!-- Услуги -->
  <section class="section section-alt">
    <div class="container container-wide">
      <header class="section-head reveal">
        <p class="eyebrow">{t.servicesSection.eyebrow}</p>
        <h2 class="section-title">{t.servicesSection.title}</h2>
        <p class="lede">{t.servicesSection.lede}</p>
      </header>

      <div class="grid-auto services-grid reveal-stagger">
        {
          t.services.map((s) => (
            <a href={url(s.href)} class="card service-card">
              <div class="service-media">
                <Image
                  src={getImg(s.image)}
                  alt={s.title}
                  widths={[380, 560, 760, 980, 1500]}
                  sizes="(min-width: 1024px) calc((100vw - 232px) * 0.45), (min-width: 700px) 45vw, 92vw"
                  quality={84}
                />
                <span class="service-tag">{s.tag}</span>
              </div>
              <div class="card-body">
                <h3 class="card-title">{s.title}</h3>
                <p class="card-text">{s.text}</p>
                <span class="card-more">{t.servicesSection.moreLabel}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- С Крита -->
  <section class="section">
    <div class="container split">
      <div class="split-media reveal-left">
        <Image
          src={getImg(t.crete.image)}
          alt={t.crete.imageAlt}
          widths={[460, 700, 940, 1220]}
          sizes="(min-width: 900px) 520px, 90vw"
          quality={84}
        />
      </div>
      <div class="split-text reveal-right">
        <p class="eyebrow">{t.crete.eyebrow}</p>
        <h2 class="section-title">{t.crete.title}</h2>
        <p>{t.crete.intro}</p>
        <ul class="tips">
          {
            t.crete.tips.map((tip) => (
              <li>
                <strong>{tip.lead}</strong> {tip.text}
              </li>
            ))
          }
        </ul>
        <a href={EXTERNAL.ferries} class="btn btn-ghost" target="_blank" rel="noopener">
          {t.crete.ferryButton}
        </a>
      </div>
    </div>
  </section>

  <!-- Круизным пассажирам -->
  <section class="section section-alt">
    <div class="container split split-reverse">
      <div class="split-media reveal-left">
        <Image
          src={getImg(t.cruise.image)}
          alt={t.cruise.imageAlt}
          widths={[460, 700, 940, 1220]}
          sizes="(min-width: 900px) 520px, 90vw"
          quality={84}
        />
      </div>
      <div class="split-text reveal-right">
        <p class="eyebrow">{t.cruise.eyebrow}</p>
        <h2 class="section-title">{t.cruise.title}</h2>
        <p>{t.cruise.intro1}</p>
        <p>{t.cruise.intro2}</p>
        <ul class="tips">
          {
            t.cruise.tips.map((tip) => (
              <li>
                <strong>{tip.lead}</strong> {tip.text}
              </li>
            ))
          }
        </ul>
        <p class="note">{t.cruise.note}</p>
        <a href={url('/tours')} class="btn btn-primary">{t.cruise.button}</a>
      </div>
    </div>
  </section>

  <Reviews title={t.reviewsSection.title} lede="" />

  <CtaBand />
</BaseLayout>

<style>
  .section-head {
    max-width: min(60ch, 100%);
    margin-bottom: var(--sp-7);
  }

  /* --- плашка-факты в низу первого экрана --- */
  .hero-bar {
    /* Матовый графит поверх фото; в самом низу — линия под цвет золота */
    background: rgb(11 13 14 / 0.72);
    backdrop-filter: blur(10px);
    border-top: 1px solid rgb(244 240 232 / 0.12);
    color: var(--c-ivory);
  }

  .hero-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-block: clamp(1.25rem, 3vh, 2rem);
  }

  @container page (min-width: 900px) {
    .hero-facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .hero-facts li {
    display: flex;
    flex-direction: column;
    /* Нижняя граница 0.5rem — чтобы на 320px «судов во флоте» не рвалось */
    padding: 0.5rem clamp(0.5rem, 2vw, 2rem);
    border-left: 1px solid rgb(244 240 232 / 0.14);
  }

  /* На двух колонках линию слева имеют только правые ячейки, на четырёх —
     все, кроме первой: чтобы у края не висела одинокая черта */
  .hero-facts li:nth-child(odd) {
    border-left: 0;
  }

  @container page (min-width: 900px) {
    .hero-facts li:nth-child(odd) {
      border-left: 1px solid rgb(244 240 232 / 0.14);
    }
    .hero-facts li:first-child {
      border-left: 0;
      padding-left: 0;
    }
  }

  .hero-facts strong {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2rem, 1.4rem + 1.8vw, 3.2rem);
    line-height: 1;
    color: var(--c-ivory);
  }

  .fact-label {
    margin-top: 0.45rem;
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-sand-2);
  }

  .fact-sub {
    margin-top: 0.15rem;
    font-size: var(--fs-xs);
    color: rgb(244 240 232 / 0.72);
  }

  /* Телефон: плашка 2×2 и так высокая — вторую строку фактов прячем,
     числа чуть мельче, чтобы первый экран с плашкой умещался в высоту */
  @container page (max-width: 599px) {
    .fact-sub {
      display: none;
    }
    .hero-facts {
      padding-block: 1rem;
    }
    .hero-facts strong {
      font-size: 1.8rem;
    }
  }

  /* Низкое окно компьютера — плашка компактнее (в паре с Hero.astro) */
  @media (min-width: 1024px) and (max-height: 900px) {
    .hero-facts {
      padding-block: 1rem;
    }
    .hero-facts strong {
      font-size: clamp(1.8rem, 1.2rem + 1.5vw, 2.6rem);
    }
  }

  /* --- знакомство --- */
  .about-grid {
    display: grid;
    gap: var(--sp-7);
    align-items: center;
  }

  .about-photo {
    position: relative;
  }

  .about-photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* Тонкая золотая рамка со сдвигом — паспарту, как у фото на подстраницах */
  .about-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    translate: 14px 14px;
    border: 1px solid var(--gold);
    pointer-events: none;
    z-index: -1;
  }

  /* Плашка на портрете — золотая, с тонкой светлой каёмкой (как кнопка
     «наверх»): владелец попросил без чёрного (19.08). Почти чёрная цифра
     на золоте — 8.69:1, подпись бронзой. */
  .about-badge {
    position: absolute;
    left: 0;
    bottom: var(--sp-5);
    display: flex;
    flex-direction: column;
    padding: var(--sp-3) var(--sp-5);
    background: var(--gold);
    color: var(--c-black);
    border: 2px solid #fff;
    box-shadow: 0 0 0 1px var(--gold), var(--shadow);
    line-height: 1.2;
  }

  .about-badge strong {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.7rem;
    color: var(--c-black);
  }

  .about-badge span {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #3d2e12; /* тёмная бронза на золоте — 5.86:1 */
  }

  .about-text > * + * {
    margin-top: var(--sp-4);
  }

  /* Рукописная подпись — как в брифе под цитатой */
  .signature {
    font-family: var(--font-hand);
    font-size: 1.7rem;
    line-height: 1.2;
    color: var(--accent);
  }

  /* --- услуги --- */
  /*
    Карточек ровно четыре, а резиновая сетка на средних экранах клала их
    «3 + 1»: «Отели» сиротой на втором ряду (дизайн-осмотр 06.08.2026).
    Всегда ровно 2×2 — как у направлений на /vip-service: без сирот,
    карточки крупные, и «Индивидуальные» не рвётся переносом в узкой
    колонке (проверено скриншотами: 4 в ряд слову уже тесно).
  */
  @container page (min-width: 700px) {
    .services-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .service-card {
    text-decoration: none;
  }

  .service-media {
    position: relative;
    overflow: hidden;
  }

  .service-media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }

  .service-card:hover .service-media :global(img) {
    transform: scale(1.06);
  }

  .service-tag {
    position: absolute;
    top: var(--sp-3);
    left: var(--sp-3);
    padding: 0.28rem 0.7rem;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    backdrop-filter: blur(6px);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent);
  }

  .card-more {
    margin-top: auto;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
  }

  /* --- сплит-блоки --- */
  .split {
    display: grid;
    gap: var(--sp-7);
    align-items: center;
  }

  .split-media {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .split-media :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .split-text > * + * {
    margin-top: var(--sp-4);
  }

  .tips {
    display: grid;
    gap: var(--sp-3);
  }

  .tips li {
    position: relative;
    padding-left: 1.7rem;
    color: var(--text-soft);
    font-size: var(--fs-sm);
  }

  .tips li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .tips strong {
    color: var(--text);
  }

  .note {
    padding: var(--sp-4);
    border-left: 3px solid var(--accent);
    background: var(--bg-alt);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: var(--fs-sm);
    color: var(--text-soft);
  }

  .section-alt .note {
    background: var(--surface);
  }

  @container page (min-width: 900px) {
    .about-grid {
      grid-template-columns: 420px 1fr;
    }
    .split {
      grid-template-columns: 1fr 1fr;
    }
    .split-reverse .split-media {
      order: 2;
    }
  }
</style>
