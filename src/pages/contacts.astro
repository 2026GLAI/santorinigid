---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { CONTACTS, WHATSAPP, WA_BASE, SITE_URL, pageUrl } from '../data/site';

import heroContacts from '../assets/img/contacts-hero.jpg';

const title = 'Контакты | Гид на Санторини Владимир — WhatsApp, Telegram';
const description =
  'Связаться с Владимиром — русскоязычным гидом на Санторини. WhatsApp, Telegram, Viber, email. На связи 24/7, отвечаю в течение часа.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  url: pageUrl('/contacts'),
  mainEntity: { '@id': `${SITE_URL}/#business` },
};

/**
 * Форма отправляется через Formspree (бесплатный тариф).
 * ВАЖНО: перед публикацией владелец регистрирует форму на formspree.io
 * и вставляет свой ID вместо ВАШ_ID_ФОРМЫ. Пока ID не вставлен — форма
 * показывает подсказку и предлагает мессенджеры (главный канал связи).
 */
const FORMSPREE_ID = '';
const formAction = FORMSPREE_ID ? `https://formspree.io/f/${FORMSPREE_ID}` : '';
---

<BaseLayout title={title} description={description} schema={schema}>
  <Hero
    image={heroContacts}
    alt="Вечерний вид на Санторини: бассейн отеля и огни Ии на фоне заката"
    eyebrow="Контакты"
    title="Ваш персональный гид на Санторини"
    text="Путешествия помогают понять красоту пространства и бесценность времени."
  />

  <section class="section">
    <div class="container contacts-grid">
      <!-- Способы связи -->
      <div class="ways reveal">
        <p class="eyebrow">Как связаться</p>
        <h2 class="section-title">Я на связи 24/7</h2>
        <p class="lede">
          Я на связи 24/7, чтобы сделать ваше пребывание на острове безупречным. Пишите в любой
          мессенджер — я отвечу в течение часа.
        </p>

        <ul class="channels">
          <li>
            <a href={WHATSAPP.general} target="_blank" rel="noopener" class="channel wa">
              <span class="channel-ico">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 004.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm5.43 12.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.48-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.53.07-.8.38-.28.3-1.05 1.02-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.11 3.23 5.12 4.53.71.31 1.27.49 1.71.63.72.23 1.37.2 1.89.12.58-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35z" />
                </svg>
              </span>
              <span class="channel-text">
                <strong>WhatsApp</strong>
                <span>Самый быстрый способ — отвечаю первым делом</span>
              </span>
              <span class="channel-arrow">→</span>
            </a>
          </li>
          <li>
            <a href={CONTACTS.telegram} target="_blank" rel="noopener" class="channel tg">
              <span class="channel-ico">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M21.94 4.6l-3.02 14.25c-.23 1-.83 1.25-1.67.78l-4.62-3.4-2.23 2.14c-.25.25-.45.45-.92.45l.33-4.68 8.52-7.7c.37-.33-.08-.51-.57-.18L7.23 12.9 2.67 11.5c-.99-.31-1-.99.21-1.47L20.67 3.2c.82-.3 1.54.2 1.27 1.4z" />
                </svg>
              </span>
              <span class="channel-text">
                <strong>Telegram</strong>
                <span>{CONTACTS.telegramHandle}</span>
              </span>
              <span class="channel-arrow">→</span>
            </a>
          </li>
          <li>
            <a href={CONTACTS.phoneHref} class="channel phone">
              <span class="channel-ico">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1 1 .3 1.9.6 2.8a2 2 0 01-.5 2.1L8.1 9.9a16 16 0 006 6l1.3-1.1a2 2 0 012.1-.5c.9.3 1.8.5 2.8.6a2 2 0 011.7 2z" />
                </svg>
              </span>
              <span class="channel-text">
                <strong>{CONTACTS.phone}</strong>
                <span>{CONTACTS.messengers}</span>
              </span>
              <span class="channel-arrow">→</span>
            </a>
          </li>
          <li>
            <a href={CONTACTS.emailHref} class="channel mail">
              <span class="channel-ico">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="4" width="20" height="16" rx="2.5" />
                  <path d="M2.5 6.5L12 13l9.5-6.5" />
                </svg>
              </span>
              <span class="channel-text">
                <strong>{CONTACTS.email}</strong>
                <span>Электронная почта</span>
              </span>
              <span class="channel-arrow">→</span>
            </a>
          </li>
          <li>
            <a href={CONTACTS.instagram} target="_blank" rel="noopener" class="channel ig">
              <span class="channel-ico">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
                  <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
                  <circle cx="12" cy="12" r="4.2" />
                  <circle cx="17.6" cy="6.4" r="1.2" fill="currentColor" stroke="none" />
                </svg>
              </span>
              <span class="channel-text">
                <strong>Instagram</strong>
                <span>{CONTACTS.instagramHandle}</span>
              </span>
              <span class="channel-arrow">→</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Форма -->
      <div class="form-wrap reveal">
        {/* Заголовок не повторяет подпись первого поля («Как к вам
            обращаться?» стояло и тут, и там — читалось как ошибка). */}
        <h2 class="form-title">Оставьте заявку</h2>
        <p class="form-sub">
          Заполните форму — я свяжусь с вами и лично подготовлю предложение.
        </p>

        {/*
          novalidate убран намеренно. Он отключал встроенную проверку
          браузера, и форму можно было отправить с пустым email — заявка
          уходила без обратного адреса. Теперь браузер сам не даст отправить
          незаполненное обязательное поле и покажет подсказку прямо у него.
        */}
        <form class="form" id="contactForm" action={formAction || undefined} method="POST">
          <label class="field">
            <span>Как к вам обращаться?</span>
            <input type="text" name="name" required autocomplete="name" placeholder="Ваше имя" />
          </label>

          <label class="field">
            <span>Ваш Email</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
            />
          </label>

          <label class="field">
            <span>Ваш номер (WhatsApp/Telegram)</span>
            <input type="tel" name="phone" autocomplete="tel" placeholder="+7 900 000-00-00" />
          </label>

          <label class="field">
            <span>Дата отдыха и количество персон</span>
            <textarea
              name="details"
              rows="3"
              placeholder="Например: 12–18 августа, 2 взрослых и ребёнок"></textarea>
          </label>

          <!-- Ловушка для спам-ботов: люди это поле не видят -->
          <input type="text" name="_gotcha" class="visually-hidden" tabindex="-1" autocomplete="off" />

          <button type="submit" class="btn btn-primary btn-lg form-submit">Отправить</button>

          <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
        </form>

        <p class="privacy">
          Ваши данные конфиденциальны. Я использую их только для того, чтобы лично подготовить
          для вас лучшее предложение по отдыху на Санторини.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ hasEndpoint: Boolean(formAction), WA: WHATSAPP.general, WA_BASE }}>
  const form = document.getElementById('contactForm');
  const status = document.getElementById('formStatus');

  form?.addEventListener('submit', async (e) => {
    // Пока владелец не подключил Formspree — не теряем заявку:
    // собираем текст и открываем WhatsApp с уже готовым сообщением.
    if (!hasEndpoint) {
      e.preventDefault();
      // Проверяем ВСЕ обязательные поля, а не только имя: у полей стоит
      // required, и reportValidity сам покажет подсказку у нужного поля.
      // Раньше проверялось одно имя, и заявка могла уйти без обратного
      // адреса — человек написал, а ответить ему некуда.
      if (!form.reportValidity()) return;

      const d = new FormData(form);
      const name = String(d.get('name') || '').trim();
      const msg = [
        'Здравствуйте, Владимир!',
        `Меня зовут: ${name}`,
        d.get('phone') ? `Телефон: ${d.get('phone')}` : '',
        d.get('email') ? `Email: ${d.get('email')}` : '',
        d.get('details') ? `Даты и гости: ${d.get('details')}` : '',
      ]
        .filter(Boolean)
        .join('\n');
      window.open(WA_BASE + encodeURIComponent(msg), '_blank', 'noopener');
      status.textContent = 'Открыл WhatsApp с вашим сообщением — осталось нажать «отправить».';
      status.className = 'form-status ok';
      return;
    }

    // Обычная отправка через Formspree без перезагрузки страницы
    e.preventDefault();
    status.textContent = 'Отправляю…';
    status.className = 'form-status';
    try {
      const r = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (r.ok) {
        form.reset();
        status.textContent = 'Спасибо! Ваше сообщение отправлено — отвечу в течение часа.';
        status.className = 'form-status ok';
      } else {
        throw new Error('bad response');
      }
    } catch {
      status.innerHTML =
        'Не получилось отправить. Напишите мне, пожалуйста, в <a href="' +
        WA +
        '" target="_blank" rel="noopener">WhatsApp</a> — так быстрее всего.';
      status.className = 'form-status err';
    }
  });
</script>

<style>
  .contacts-grid {
    display: grid;
    gap: var(--sp-7);
    align-items: start;
  }

  .ways > * + * {
    margin-top: var(--sp-4);
  }

  .channels {
    display: grid;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
  }

  .channel {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .channel:hover {
    transform: translateX(4px);
    border-color: var(--accent);
    box-shadow: var(--shadow-sm);
  }

  .channel-ico {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
  }

  .channel.wa .channel-ico {
    background: rgb(37 211 102 / 0.12);
    color: var(--ok);
  }

  .channel-text {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
    min-width: 0;
    flex: 1;
  }

  .channel-text strong {
    font-size: var(--fs-base);
    word-break: break-word;
  }

  .channel-text span {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .channel-arrow {
    color: var(--text-muted);
    transition: transform var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .channel:hover .channel-arrow {
    color: var(--accent);
    transform: translateX(3px);
  }

  /* --- форма --- */
  .form-wrap {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    position: sticky;
    top: 92px;
  }

  .form-title {
    font-size: var(--fs-xl);
  }

  .form-sub {
    margin-top: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .form {
    display: grid;
    gap: var(--sp-4);
    margin-top: var(--sp-5);
  }

  .field {
    display: grid;
    gap: var(--sp-2);
  }

  .field > span {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-soft);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    font-size: var(--fs-sm);
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
    resize: vertical;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--text-muted);
    opacity: 0.65;
  }

  .form-submit {
    width: 100%;
    margin-top: var(--sp-1);
  }

  .form-status {
    font-size: var(--fs-sm);
    text-align: center;
    min-height: 1.2em;
  }

  .form-status.ok {
    color: var(--ok);
  }

  .form-status.err {
    color: var(--err);
  }

  .form-status :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }

  .privacy {
    margin-top: var(--sp-4);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--border);
    font-size: var(--fs-xs);
    color: var(--text-muted);
    line-height: 1.6;
  }

  @media (min-width: 940px) {
    .contacts-grid {
      grid-template-columns: 1fr 440px;
    }
  }

  @media (max-width: 939px) {
    .form-wrap {
      position: static;
    }
  }
</style>
