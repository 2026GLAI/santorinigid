---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../data/url';
import CtaBand from '../components/CtaBand.astro';
import Reviews from '../components/Reviews.astro';
import {
  WHATSAPP,
  CONTACTS,
  SITE_URL,
  OWNER_FULL_NAME,
  PROFILES,
  ISLAND_YEARS_TEXT,
  GUIDE_YEARS_TEXT,
  pageUrl,
} from '../data/site';
import { GALLERY } from '../data/tours';
import { getImg } from '../data/images';
import { fillDeep } from '../data/fill';
import data from '../data/pages/about.json';

/*
 * СОДЕРЖИМОЕ СТРАНИЦЫ ЖИВЁТ В src/data/pages/about.json — его правит
 * владелец через админку /admin (этап 2, 06.08.2026). Здесь только каркас.
 * Метки {НА_ОСТРОВЕ_С}, {ЛЕТ_НА_ОСТРОВЕ}, {ЛЕТ_ГИДОМ} подставляет сборка
 * (src/data/fill.ts) — даты подтверждены владельцем 2026-07-25, стаж
 * считается от года. В колонке годов таймлайна — год, а не длительность:
 * рядом стоят «1995» и «Сегодня», длительность читалась как сбой (аудит 06.08).
 */
const t = fillDeep(data);

const portrait = getImg(t.intro.photo);

const gallery = GALLERY.map((f) => getImg(f));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    url: pageUrl('/about'),
    mainEntity: {
      '@type': 'Person',
      name: OWNER_FULL_NAME,
      alternateName: 'Владимир',
      jobTitle: 'Частный русскоязычный гид на Санторини',
      description: `${ISLAND_YEARS_TEXT} живёт на Санторини, ${GUIDE_YEARS_TEXT} профессионального опыта проведения индивидуальных экскурсий.`,
      knowsLanguage: ['ru', 'el'],
      knowsAbout: [
        'Санторини',
        'Экскурсии по Санторини',
        'Кальдера Санторини',
        'Ия (Ойя)',
        'Виноделие Санторини',
        'Аренда яхт на Санторини',
        'Вертолётные туры на Санторини',
      ],
      worksFor: { '@id': `${SITE_URL}/#business` },
      sameAs: [...PROFILES],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: pageUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Обо мне', item: pageUrl('/about') },
    ],
  },
];

---

<BaseLayout
  title={t.seo.title}
  description={t.seo.description}
  schema={schema}
  edit={[{ label: 'Тексты страницы', entry: 'pages/about' }]}
>
  <section class="section intro-section">
    <div class="container intro">
      <div class="intro-photo reveal">
        <Image
          src={portrait}
          alt={t.intro.photoAlt}
          widths={[420, 620, 840]}
          sizes="(min-width: 900px) 460px, 92vw"
          quality={84}
          loading="eager"
        />
      </div>
      <div class="intro-text reveal">
        <p class="eyebrow">{t.intro.eyebrow}</p>
        <h1>{t.intro.title}</h1>
        <p class="lede">{t.intro.lede}</p>
        <p>{t.intro.text}</p>
        <div class="intro-actions">
          <a href={WHATSAPP.general} class="btn btn-whatsapp" target="_blank" rel="noopener">
            {t.intro.buttonWrite}
          </a>
          <a href={url('/tours')} class="btn btn-ghost">{t.intro.buttonTours}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Путь -->
  <section class="section section-alt">
    <div class="container container-wide">
      <header class="section-head reveal">
        <p class="eyebrow">{t.pathSection.eyebrow}</p>
        <h2 class="section-title">{t.pathSection.title}</h2>
      </header>
      <ol class="timeline">
        {
          t.timeline.map((item) => (
            <li class="tl-item reveal">
              <span class="tl-year">{item.n}</span>
              <h3>{item.label}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Принципы -->
  <section class="section">
    <div class="container">
      <header class="section-head reveal">
        <p class="eyebrow">{t.principlesSection.eyebrow}</p>
        <h2 class="section-title">{t.principlesSection.title}</h2>
      </header>
      <div class="grid-auto">
        {
          t.principles.map((p) => (
            <article class="principle reveal">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Reviews alt />

  <!-- Галерея -->
  <section class="section">
    <div class="container container-wide">
      <header class="section-head reveal">
        <p class="eyebrow">{t.gallerySection.eyebrow}</p>
        <h2 class="section-title">{t.gallerySection.title}</h2>
      </header>
      <div class="gallery reveal">
        {
          gallery.map((g, i) => (
            <figure class="gal-item">
              <Image
                src={g}
                alt={`Гости Владимира на Санторини, фото ${i + 1}`}
                widths={[300, 500, 700]}
                sizes="(min-width: 1000px) 280px, (min-width: 640px) 45vw, 90vw"
                quality={76}
              />
            </figure>
          ))
        }
      </div>
      <p class="ig-link reveal">
        <a href={CONTACTS.instagram} class="btn btn-ghost" target="_blank" rel="noopener">
          {t.gallerySection.instagramButton}
        </a>
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .intro-section {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .intro {
    display: grid;
    gap: var(--sp-7);
    align-items: center;
  }

  .intro-photo {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .intro-photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .intro-text > * + * {
    margin-top: var(--sp-4);
  }

  .intro-text h1 {
    font-size: var(--fs-3xl);
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
  }

  .section-head {
    max-width: min(62ch, 100%);
    margin-bottom: var(--sp-7);
  }

  /* --- таймлайн --- */
  .timeline {
    display: grid;
    gap: var(--sp-5);
  }

  .tl-item {
    position: relative;
    padding: var(--sp-5);
    padding-left: var(--sp-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .tl-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: var(--sp-5);
    bottom: var(--sp-5);
    width: 3px;
    border-radius: 3px;
    background: var(--accent);
  }

  .tl-year {
    display: block;
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--accent);
  }

  .tl-item h3 {
    margin-top: var(--sp-2);
    font-family: var(--font-body);
    font-size: var(--fs-base);
  }

  .tl-item p {
    margin-top: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--text-soft);
  }

  /* --- принципы --- */
  .principle {
    padding: var(--sp-5);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .principle h3 {
    font-family: var(--font-body);
    font-size: var(--fs-base);
    color: var(--accent);
    margin-bottom: var(--sp-2);
  }

  .principle p {
    font-size: var(--fs-sm);
    color: var(--text-soft);
  }

  /* --- галерея --- */
  .gallery {
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: repeat(auto-fill, minmax(min(230px, 100%), 1fr));
  }

  .gal-item {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .gal-item :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }

  .gal-item:hover :global(img) {
    transform: scale(1.07);
  }

  .ig-link {
    margin-top: var(--sp-6);
    text-align: center;
  }

  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 440px 1fr;
    }
    .timeline {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
