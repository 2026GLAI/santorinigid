---
import { getImage, Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Reviews from '../components/Reviews.astro';
import { WHATSAPP, SITE_URL, pageUrl } from '../data/site';
import { TOUR_STOPS, TOUR_DETAILS, FAQ, GALLERY } from '../data/tours';
import { getImg } from '../data/images';
import { fillDeep } from '../data/fill';
import data from '../data/pages/tours.json';

/*
 * СОДЕРЖИМОЕ СТРАНИЦЫ ЖИВЁТ В src/data/pages/tours.json — его правит
 * владелец через админку /admin (этап 2, 06.08.2026). Здесь только каркас.
 * «4 часа» в заголовке формата — подтверждено владельцем 06.08.2026
 * (базовая программа, связано с ценами); «4,5 часа» старого сайта было
 * неточностью. Метки {ГОД}/{ЛЕТ_ГИДОМ} подставляет сборка (fill.ts).
 */
const t = fillDeep(data);

const heroTour = getImg(t.hero.image);

/* OG-картинка 1200×630 для превью ссылки в WhatsApp/Telegram — своя у
   страницы, а не общая заглушка. Sharp кадрирует героя при сборке. */
const og = await getImage({ src: heroTour, width: 1200, height: 630, format: 'jpeg' });

/** Галерея: фото гостей. */
const gallery = GALLERY.map((f) => getImg(f));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristTrip',
    name: 'Индивидуальная обзорная экскурсия по Санторини на автомобиле',
    description:
      'Обзорная экскурсия по Санторини с русскоязычным гидом: Ия, гора Пророка Ильи, церковь Панагия Эпископи и винный музей Кутсуяннопулос с дегустацией.',
    url: pageUrl('/tours'),
    provider: { '@id': `${SITE_URL}/#business` },
    inLanguage: 'ru',
    touristType: ['Индивидуальные путешественники', 'Пассажиры круизных лайнеров', 'Семьи'],
    itinerary: {
      '@type': 'ItemList',
      numberOfItems: TOUR_STOPS.length,
      itemListElement: TOUR_STOPS.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: { '@type': 'TouristAttraction', name: s.title, description: s.text },
      })),
    },
  },
  // FAQPage не дублируем: с 06.08.2026 её отдаёт сам компонент Faq.
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: pageUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'Экскурсии', item: pageUrl('/tours') },
    ],
  },
];
---

<BaseLayout
  title={t.seo.title}
  description={t.seo.description}
  schema={schema}
  ogImage={og.src}
  edit={[
    { label: 'Тексты страницы', entry: 'pages/tours-page' },
    { label: 'Маршрут, условия, вопросы', entry: 'content/tours' },
  ]}
>
  <Hero
    image={heroTour}
    alt={t.hero.alt}
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    text={t.hero.text}
  >
    <a href={WHATSAPP.tour} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener">
      {t.hero.button}
    </a>
  </Hero>

  <section class="section">
    <div class="container container-narrow text-block reveal">
      <p class="lede">{t.intro}</p>
    </div>
  </section>

  <!-- Формат -->
  <section class="section section-alt">
    <div class="container container-wide">
      <header class="section-head reveal">
        <p class="eyebrow">{t.formatSection.eyebrow}</p>
        <h2 class="section-title">{t.formatSection.title}</h2>
      </header>
      <div class="two-col reveal">
        {/* Два абзаца «Забудьте о…» старого сайта слиты в один 06.08 —
            сохранены обе мысли, но без повтора. */}
        <p>{t.formatSection.p1}</p>
        <p>{t.formatSection.p2}</p>
      </div>

      <dl class="details reveal">
        {
          TOUR_DETAILS.map((d) => (
            <div class="detail">
              <dt>{d.label}</dt>
              <dd>{d.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Маршрут -->
  <section class="section">
    <div class="container">
      <header class="section-head reveal">
        <p class="eyebrow">{t.routeSection.eyebrow}</p>
        <h2 class="section-title">{t.routeSection.title}</h2>
        <p class="lede">{t.routeSection.lede}</p>
      </header>

      <ol class="stops">
        {
          TOUR_STOPS.map((s, i) => (
            <li class:list={['stop', 'reveal', { 'stop-noimg': !s.image }]}>
              {s.image ? (
                <div class="stop-media">
                  <Image
                    src={getImg(s.image)}
                    alt={`${s.title} — ${s.subtitle}`}
                    widths={[420, 640, 880]}
                    sizes="(min-width: 900px) 480px, 92vw"
                    quality={80}
                  />
                  <span class="stop-num">{String(i + 1).padStart(2, '0')}</span>
                </div>
              ) : (
                <div class="stop-media stop-placeholder" aria-hidden="true">
                  <span class="stop-num">{String(i + 1).padStart(2, '0')}</span>
                </div>
              )}
              <div class="stop-text">
                <h3>{s.title}</h3>
                <p class="stop-sub">{s.subtitle}</p>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Галерея -->
  <section class="section section-alt">
    <div class="container">
      <header class="section-head reveal">
        <p class="eyebrow">{t.gallerySection.eyebrow}</p>
        <h2 class="section-title">{t.gallerySection.title}</h2>
        <p class="lede">{t.gallerySection.lede}</p>
      </header>

      <div class="gallery reveal-stagger">
        {
          gallery.map((g, i) => (
            <figure class="gal-item">
              <Image
                src={g}
                alt={`Гости Владимира на экскурсии по Санторини, фото ${i + 1}`}
                widths={[300, 500, 700]}
                sizes="(min-width: 1000px) 280px, (min-width: 640px) 45vw, 90vw"
                quality={76}
              />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <Reviews title={t.reviewsSection.title} lede="" />

  <Faq items={FAQ} />

  <CtaBand title={t.cta.title} text={t.cta.text} waLink={WHATSAPP.tour} />
</BaseLayout>

<style>
  .section-head {
    max-width: min(62ch, 100%);
    margin-bottom: var(--sp-7);
  }

  .text-block .lede {
    font-size: var(--fs-xl);
    font-family: var(--font-display);
    line-height: 1.5;
    color: var(--text);
    text-align: center;
  }

  .two-col {
    display: grid;
    gap: var(--sp-5);
    color: var(--text-soft);
  }

  .details {
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    margin-top: var(--sp-7);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--border);
  }

  .detail dt {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--sp-1);
  }

  .detail dd {
    font-size: var(--fs-sm);
    color: var(--text-soft);
  }

  /* --- точки маршрута --- */
  .stops {
    display: grid;
    gap: var(--sp-8);
  }

  .stop {
    display: grid;
    gap: var(--sp-5);
    align-items: center;
  }

  .stop-media {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .stop-media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  /* Пока владелец не прислал фото места — вместо чужой картинки
     показываем спокойный фирменный блок, а не вводим гостя в заблуждение. */
  .stop-placeholder {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 120% at 30% 20%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 60%),
      var(--bg-alt);
    border: 1px dashed var(--border);
    box-shadow: none;
  }

  .stop-placeholder .stop-num {
    position: static;
    width: 64px;
    height: 64px;
    font-size: 1.5rem;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
  }

  .stop-num {
    position: absolute;
    top: var(--sp-4);
    left: var(--sp-4);
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(6px);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--accent);
  }

  .stop-text h3 {
    font-size: var(--fs-2xl);
  }

  .stop-sub {
    margin-top: var(--sp-1);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-lg);
    color: var(--accent);
  }

  .stop-text p:last-child {
    margin-top: var(--sp-4);
    color: var(--text-soft);
  }

  /* --- галерея --- */
  .gallery {
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: repeat(auto-fill, minmax(min(230px, 100%), 1fr));
  }

  .gal-item {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .gal-item :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }

  .gal-item:hover :global(img) {
    transform: scale(1.07);
  }

  @media (min-width: 860px) {
    .two-col {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-6);
    }
    .stop {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-7);
    }
    .stop:nth-child(even) .stop-media {
      order: 2;
    }
  }
</style>
