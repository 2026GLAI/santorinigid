---
import { getImage, Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import { WHATSAPP, EXTERNAL, pageUrl } from '../data/site';
import { getImg } from '../data/images';
import { fillDeep } from '../data/fill';
import data from '../data/pages/santorini.json';

/*
 * СОДЕРЖИМОЕ СТРАНИЦЫ ЖИВЁТ В src/data/pages/santorini.json — его правит
 * владелец через админку /admin (этап 2, 06.08.2026). Здесь только каркас.
 * Метки вида {ГОД} в текстах подставляются сборкой — см. src/data/fill.ts.
 *
 * Достоверность текстов: описания достопримечательностей (sights) и «Как
 * попасть на остров» (arrival) — дословно с santorinivip.com (снято
 * 2026-07-25, docs/harvest/verbatim-content.md). Подтверждённые факты:
 * высота горы Пророка Ильи 567 м, Панагия Эпископи 1118 год, подъём из
 * порта по 10 евро, 588 ступеней, паром с Крита 2–2,5 часа, порт Афиньос.
 *
 * У «Горы Пророка Ильи» фото НЕТ НАМЕРЕННО — владелец обещал прислать своё;
 * чужие снимки не ставить (подпись и картинка должны совпадать).
 */
const t = fillDeep(data);

/*
  Шапка страницы об острове — вид на кальдеру с высоты: видно и вулкан,
  и обрыв, и белые деревни. Это лучше передаёт «остров целиком», чем
  панорама Ии, которая уже стоит на главной.
*/
const heroIsland = getImg(t.hero.image);

/* OG-картинка 1200×630 для превью ссылки в WhatsApp/Telegram. */
const og = await getImage({ src: heroIsland, width: 1200, height: 630, format: 'jpeg' });

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Главные достопримечательности Санторини',
    numberOfItems: t.sights.length,
    itemListElement: t.sights.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'TouristAttraction',
        name: s.name,
        description: s.text,
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Санторини',
          addressCountry: 'GR',
        },
      },
    })),
  },
  // FAQPage не дублируем: с 06.08.2026 её отдаёт сам компонент Faq.
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: pageUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'О Санторини', item: pageUrl('/santorini') },
    ],
  },
];
---

<BaseLayout
  title={t.seo.title}
  description={t.seo.description}
  schema={schema}
  ogImage={og.src}
  edit={[{ label: 'Тексты и места страницы', entry: 'pages/santorini' }]}
>
  <Hero
    image={heroIsland}
    alt={t.hero.alt}
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    text={t.hero.text}
  >
    <a href="#sights" class="btn btn-primary btn-lg">{t.hero.button}</a>
  </Hero>

  <section class="section">
    <div class="container container-narrow reveal">
      <p class="lede text-center">{t.intro}</p>
    </div>
  </section>

  <!-- Достопримечательности -->
  <section class="section section-alt" id="sights">
    <div class="container container-wide">
      <header class="section-head reveal">
        <p class="eyebrow">{t.sightsSection.eyebrow}</p>
        <h2 class="section-title">{t.sightsSection.title}</h2>
        <p class="lede">{t.sightsSection.lede}</p>
      </header>

      <div class="grid-auto">
        {
          t.sights.map((s) => (
            <article class="card sight reveal">
              {s.image ? (
                <div class="sight-media">
                  <Image
                    src={getImg(s.image)}
                    alt={`${s.name}, Санторини`}
                    widths={[380, 580, 800]}
                    sizes="(min-width: 1000px) 360px, (min-width: 700px) 45vw, 92vw"
                    quality={80}
                  />
                  <span class="sight-tag">{s.tag}</span>
                </div>
              ) : (
                /* Фото пока нет — вместо чужого снимка спокойный блок */
                <div class="sight-media sight-placeholder">
                  <span class="sight-tag">{s.tag}</span>
                </div>
              )}
              <div class="card-body">
                <h3 class="card-title">{s.name}</h3>
                <p class="card-text">{s.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Как добраться -->
  <section class="section">
    <div class="container container-wide">
      <header class="section-head reveal">
        <p class="eyebrow">{t.arrivalSection.eyebrow}</p>
        <h2 class="section-title">{t.arrivalSection.title}</h2>
      </header>

      <div class="grid-auto">
        {
          t.arrival.map((a) => (
            <article class="arrival reveal">
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </article>
          ))
        }
      </div>

      <p class="ferry-link reveal">
        <a href={EXTERNAL.ferries} class="btn btn-ghost" target="_blank" rel="noopener">
          {t.arrivalSection.ferryButton}
        </a>
      </p>
    </div>
  </section>

  <Faq items={t.faq} title={t.faqSection.title} eyebrow={t.faqSection.eyebrow} />

  <CtaBand title={t.cta.title} text={t.cta.text} waLink={WHATSAPP.tour} />
</BaseLayout>

<style>
  .section-head {
    max-width: min(62ch, 100%);
    margin-bottom: var(--sp-7);
  }

  .sight-media {
    position: relative;
    overflow: hidden;
  }

  .sight-media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 700ms var(--ease);
  }

  .sight:hover .sight-media :global(img) {
    transform: scale(1.06);
  }

  /* Карточка без фото: фирменный фон вместо чужого снимка */
  .sight-placeholder {
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    background:
      radial-gradient(
        120% 120% at 30% 20%,
        color-mix(in srgb, var(--accent) 16%, transparent),
        transparent 62%
      ),
      var(--bg-alt);
    border-bottom: 1px dashed var(--border);
  }

  .sight-placeholder .sight-tag {
    position: static;
    font-size: var(--fs-sm);
  }

  .sight-tag {
    position: absolute;
    top: var(--sp-3);
    left: var(--sp-3);
    padding: 0.28rem 0.75rem;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    backdrop-filter: blur(6px);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent);
  }

  .arrival {
    padding: var(--sp-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .arrival h3 {
    font-family: var(--font-body);
    font-size: var(--fs-base);
    color: var(--accent);
    margin-bottom: var(--sp-2);
  }

  .arrival p {
    font-size: var(--fs-sm);
    color: var(--text-soft);
    line-height: 1.7;
  }

  .ferry-link {
    margin-top: var(--sp-6);
    text-align: center;
  }
</style>
