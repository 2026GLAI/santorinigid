---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../data/url';
import { WHATSAPP } from '../data/site';
import { fillDeep } from '../data/fill';
import data from '../data/pages/notfound.json';

/* Тексты страницы — в src/data/pages/notfound.json (админка /admin). */
const t = fillDeep(data);
---

<BaseLayout title={t.seo.title} description={t.seo.description} noindex>
  <section class="section notfound">
    <div class="container container-narrow text-center">
      <p class="code">{t.code}</p>
      <h1>{t.title}</h1>
      <p class="lede mx-auto">{t.lede}</p>

      <div class="links">
        <a href={url('/')} class="btn btn-primary">{t.buttons.home}</a>
        <a href={url('/tours')} class="btn btn-ghost">{t.buttons.tours}</a>
        <a href={url('/vip-service')} class="btn btn-ghost">{t.buttons.vip}</a>
        <a href={WHATSAPP.general} class="btn btn-whatsapp" target="_blank" rel="noopener">
          {t.buttons.whatsapp}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: grid;
    place-items: center;
    min-height: 62dvh;
  }

  .code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 16vw, 9rem);
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
    opacity: 0.22;
  }

  .notfound h1 {
    margin-top: var(--sp-2);
    font-size: var(--fs-2xl);
  }

  .notfound .lede {
    margin-top: var(--sp-4);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3);
    margin-top: var(--sp-7);
  }
</style>
