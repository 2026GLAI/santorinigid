---
import BaseLayout from '../layouts/BaseLayout.astro';
import { WHATSAPP } from '../data/site';
---

<BaseLayout
  title="Страница не найдена — Гид на Санторини"
  description="Такой страницы на сайте нет. Вернитесь на главную или напишите Владимиру напрямую."
  noindex
>
  <section class="section notfound">
    <div class="container container-narrow text-center">
      <p class="code">404</p>
      <h1>Такой страницы нет</h1>
      <p class="lede mx-auto">
        Ссылка устарела или в адресе опечатка. Вот куда можно пойти дальше:
      </p>

      <div class="links">
        <a href="/" class="btn btn-primary">На главную</a>
        <a href="/tours" class="btn btn-ghost">Экскурсии</a>
        <a href="/vip-service" class="btn btn-ghost">VIP услуги</a>
        <a href={WHATSAPP.general} class="btn btn-whatsapp" target="_blank" rel="noopener">
          Написать в WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: grid;
    place-items: center;
    min-height: 62dvh;
  }

  .code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 16vw, 9rem);
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
    opacity: 0.22;
  }

  .notfound h1 {
    margin-top: var(--sp-2);
    font-size: var(--fs-2xl);
  }

  .notfound .lede {
    margin-top: var(--sp-4);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3);
    margin-top: var(--sp-7);
  }
</style>
