---
import { getImage, Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { WHATSAPP, SITE_URL, pageUrl } from '../../data/site';
import { HOTELS } from '../../data/hotels';
import { getImg } from '../../data/images';
import { fillDeep } from '../../data/fill';
import data from '../../data/pages/hotels-page.json';

/*
 * СОДЕРЖИМОЕ СТРАНИЦЫ ЖИВЁТ В src/data/pages/hotels-page.json (тексты)
 * и src/data/hotels.json (14 отелей с партнёрскими ссылками) — их правит
 * владелец через админку /admin. Здесь только каркас.
 *
 * Год в ЗАГОЛОВКЕ живой ({ГОД}), а в АДРЕСЕ страницы (…-hotels-2026) — нет:
 * адрес менять нельзя без 301-редиректа, это решение владельца на зиму.
 * Шапка — панорама Katikies (раньше повторяла фото страницы контактов).
 */
const t = fillDeep(data);

const heroHotel = getImg(t.hero.image);

/* OG-картинка 1200×630 для превью ссылки в WhatsApp/Telegram. */
const og = await getImage({ src: heroHotel, width: 1200, height: 630, format: 'jpeg' });

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Лучшие отели Санторини с видом на Кальдеру',
    numberOfItems: HOTELS.length,
    itemListElement: HOTELS.map((h, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Hotel',
        name: h.name,
        description: h.description,
        address: {
          '@type': 'PostalAddress',
          addressLocality: h.area,
          addressRegion: 'Санторини',
          addressCountry: 'GR',
        },
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: pageUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'VIP услуги', item: pageUrl('/vip-service') },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Отели',
        item: pageUrl('/vip-service/santorini-hotels-2026'),
      },
    ],
  },
];
---

<BaseLayout
  title={t.seo.title}
  description={t.seo.description}
  schema={schema}
  ogImage={og.src}
  edit={[
    { label: 'Тексты страницы', entry: 'pages/hotels-page' },
    { label: 'Сами отели', entry: 'content/hotels' },
  ]}
>
  <Hero
    image={heroHotel}
    alt={t.hero.alt}
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    text={t.hero.text}
  />

  <section class="section">
    <div class="container container-narrow reveal">
      <p class="lede text-center">{t.intro}</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      {/* h2 закрывает разрыв иерархии заголовков: раньше после h1 шли
          сразу 14 карточек с h3, без родительского раздела (аудит 06.08). */}
      <header class="section-head reveal">
        <p class="eyebrow">{t.selectionSection.eyebrow}</p>
        <h2 class="section-title">{t.selectionSection.title}</h2>
      </header>
      <div class="hotels">
        {
          HOTELS.map((h, i) => (
            <article class="card hotel reveal">
              <div class="hotel-media">
                <Image
                  src={getImg(h.image)}
                  alt={`Отель ${h.name} на Санторини, ${h.area}`}
                  widths={[420, 640, 900, 1180]}
                  sizes="(min-width: 900px) 440px, 92vw"
                  quality={84}
                />
                <span class="hotel-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="hotel-area">{h.area}</span>
              </div>
              <div class="hotel-body">
                {/* h3, а не h2: отель вложен в раздел подборки, а не равен ему.
                    Было 18 заголовков второго уровня подряд — поисковик читал
                    названия отелей наравне с разделами страницы.
                    Внешний вид не меняется, он задан классом .hotel-name. */}
                <h3 class="hotel-name">{h.name}</h3>
                <p class="hotel-desc">{h.description}</p>
                <a
                  href={h.link}
                  class="btn btn-primary hotel-cta"
                  target="_blank"
                  rel="noopener sponsored"
                >
                  {t.selectionSection.hotelButton}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Философия + честное раскрытие -->
  <section class="section">
    <div class="container container-narrow">
      <div class="freedom reveal">
        <h2 class="section-title">{t.freedom.title}</h2>
        <p>{t.freedom.text}</p>
      </div>

      <aside class="disclosure reveal">
        <h3>{t.disclosure.title}</h3>
        <p>{t.disclosure.text}</p>
      </aside>
    </div>
  </section>

  <CtaBand title={t.cta.title} text={t.cta.text} waLink={WHATSAPP.hotel} />
</BaseLayout>

<style>
  .section-head {
    max-width: min(62ch, 100%);
    margin-bottom: var(--sp-7);
  }

  .hotels {
    display: grid;
    gap: var(--sp-6);
  }

  .hotel {
    display: grid;
    scroll-margin-top: 90px;
  }

  .hotel-media {
    position: relative;
    overflow: hidden;
  }

  .hotel-media :global(img) {
    width: 100%;
    height: 100%;
    min-height: 250px;
    object-fit: cover;
    transition: transform 700ms var(--ease);
  }

  .hotel:hover .hotel-media :global(img) {
    transform: scale(1.05);
  }

  .hotel-num {
    position: absolute;
    top: var(--sp-3);
    left: var(--sp-3);
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    backdrop-filter: blur(6px);
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--accent);
  }

  .hotel-area {
    position: absolute;
    bottom: var(--sp-3);
    left: var(--sp-3);
    padding: 0.28rem 0.75rem;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--c-aegean-900) 78%, transparent);
    backdrop-filter: blur(6px);
    color: #fff;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .hotel-body {
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .hotel-name {
    font-size: var(--fs-xl);
  }

  .hotel-desc {
    color: var(--text-soft);
    font-size: var(--fs-sm);
    line-height: 1.7;
  }

  .hotel-cta {
    margin-top: auto;
    align-self: flex-start;
  }

  /* --- философия --- */
  .freedom p {
    margin-top: var(--sp-4);
    color: var(--text-soft);
  }

  .disclosure {
    margin-top: var(--sp-6);
    padding: var(--sp-5);
    border: 1px solid var(--border);
    border-left: 4px solid var(--c-sunset-500);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--bg-alt);
  }

  .disclosure h3 {
    font-family: var(--font-body);
    font-size: var(--fs-base);
    color: var(--c-sunset-600);
    margin-bottom: var(--sp-3);
  }

  .disclosure p {
    font-size: var(--fs-sm);
    color: var(--text-soft);
    line-height: 1.7;
  }

  @media (min-width: 860px) {
    .hotel {
      grid-template-columns: 42% 1fr;
    }
    .hotel:nth-child(even) .hotel-media {
      order: 2;
    }
  }
</style>
