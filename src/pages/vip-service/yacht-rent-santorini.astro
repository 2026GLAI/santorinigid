---
import { getImage, Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import { WHATSAPP, SITE_URL, eur, pageUrl } from '../../data/site';
import {
  YACHTS,
  YACHT_PROGRAMS,
  YACHT_INCLUDED,
  YACHT_PRICE_FROM,
  YACHT_PRICE_TO,
} from '../../data/yachts';
import { getImg } from '../../data/images';
import { fillDeep } from '../../data/fill';
import data from '../../data/pages/yachts-page.json';

/*
 * СОДЕРЖИМОЕ СТРАНИЦЫ ЖИВЁТ В src/data/pages/yachts-page.json (тексты
 * страницы) и src/data/yachts.json (суда, программы, цены) — их правит
 * владелец через админку /admin. Здесь только каркас. Цены и число судов
 * в текстах — метки {ЦЕНА_ЯХТ_ОТ}/{ЦЕНА_ЯХТ_ДО}/{ЧИСЛО_СУДОВ}: считаются
 * сборкой из таблиц цен, цифрой нигде не вписаны (fill.ts). Пары
 * «вопрос-ответ» FAQ — любимый формат ИИ-поисковиков; FAQPage отдаёт Faq.
 */
const t = fillDeep(data);

const heroYacht = getImg(t.hero.image);

/* OG-картинка 1200×630 для превью ссылки в WhatsApp/Telegram. */
const og = await getImage({ src: heroYacht, width: 1200, height: 630, format: 'jpeg' });

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Аренда яхт и катамаранов на Санторини',
    serviceType: 'Аренда яхты с экипажем',
    provider: { '@id': `${SITE_URL}/#business` },
    areaServed: { '@type': 'Place', name: 'Санторини, Греция' },
    url: pageUrl('/vip-service/yacht-rent-santorini'),
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'EUR',
      lowPrice: YACHT_PRICE_FROM,
      highPrice: YACHT_PRICE_TO,
      offerCount: YACHTS.length,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: pageUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'VIP услуги', item: pageUrl('/vip-service') },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Аренда яхт',
        item: pageUrl('/vip-service/yacht-rent-santorini'),
      },
    ],
  },
];

---

<BaseLayout
  title={t.seo.title}
  description={t.seo.description}
  schema={schema}
  ogImage={og.src}
  edit={[
    { label: 'Тексты страницы', entry: 'pages/yachts-page' },
    { label: 'Суда, программы, цены', entry: 'content/yachts' },
  ]}
>
  <Hero
    image={heroYacht}
    alt={t.hero.alt}
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    text={t.hero.text}
  >
    <a href={WHATSAPP.yacht} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener">
      {t.hero.button}
    </a>
  </Hero>

  <section class="section">
    <div class="container container-narrow reveal">
      <p class="lede text-center">{t.intro}</p>
    </div>
  </section>

  <!-- Программы -->
  <section class="section section-alt">
    <div class="container container-wide">
      <header class="section-head reveal">
        <p class="eyebrow">{t.programsSection.eyebrow}</p>
        <h2 class="section-title">{t.programsSection.title}</h2>
      </header>
      <div class="grid-auto">
        {
          YACHT_PROGRAMS.map((p) => (
            <article class="card program reveal">
              <div class="program-media">
                <Image
                  src={getImg(p.image)}
                  alt={`${p.title} на Санторини — ${p.time}`}
                  widths={[380, 560, 760, 980]}
                  sizes="(min-width: 1100px) 360px, (min-width: 700px) 45vw, 92vw"
                  quality={84}
                />
                <span class="program-time">{p.time}</span>
              </div>
              <div class="card-body">
                <h3 class="card-title">{p.title}</h3>
                <p class="card-text">{p.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Флот -->
  <section class="section">
    <div class="container container-wide">
      <header class="section-head reveal">
        <p class="eyebrow">{t.fleetSection.eyebrow}</p>
        <h2 class="section-title">{t.fleetSection.title}</h2>
        <p class="lede">{t.fleetSection.lede}</p>
      </header>

      <div class="fleet">
        {
          YACHTS.map((y) => (
            <article class="card yacht reveal" id={y.slug}>
              <div class="yacht-media">
                <Image
                  src={getImg(y.image)}
                  alt={`${y.name} — аренда на Санторини`}
                  widths={[420, 640, 900, 1180]}
                  sizes="(min-width: 900px) 460px, 92vw"
                  quality={84}
                />
                {y.badge && <span class="yacht-badge">{y.badge}</span>}
              </div>

              <div class="yacht-body">
                <h3 class="yacht-name">{y.name}</h3>
                {y.guests && <p class="yacht-guests">до {y.guests} гостей</p>}
                <p class="yacht-desc">{y.description}</p>

                <div class="prices-scroll">
                  <table class="prices">
                    <caption class="visually-hidden">Цены на аренду {y.name}</caption>
                    <thead>
                      <tr>
                        <th scope="col">{t.pricesTable.colProgram}</th>
                        <th scope="col">{t.pricesTable.colLow}</th>
                        <th scope="col">{t.pricesTable.colHigh}</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <th scope="row">{t.pricesTable.rowDay}</th>
                        <td>{eur(y.low.day)}</td>
                        <td>{eur(y.high.day)}</td>
                      </tr>
                      <tr>
                        <th scope="row">{t.pricesTable.rowSunset}</th>
                        <td>{eur(y.low.sunset)}</td>
                        <td>{eur(y.high.sunset)}</td>
                      </tr>
                      <tr>
                        <th scope="row">{t.pricesTable.rowFull}</th>
                        <td>{eur(y.low.full)}</td>
                        <td>{eur(y.high.full)}</td>
                      </tr>
                    </tbody>
                  </table>
                </div>

                <div class="yacht-perks" aria-label="Включено в стоимость">
                  {t.perks.map((p) => <span title={p.hint}>{p.label}</span>)}
                </div>

                <a
                  href={WHATSAPP.yacht}
                  class="btn btn-whatsapp"
                  target="_blank"
                  rel="noopener"
                >
                  {t.fleetSection.button}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Что включено -->
  <section class="section section-alt">
    <div class="container container-wide">
      <header class="section-head reveal">
        <p class="eyebrow">{t.includedSection.eyebrow}</p>
        <h2 class="section-title">{t.includedSection.title}</h2>
      </header>
      <div class="grid-auto">
        {
          YACHT_INCLUDED.map((i) => (
            <article class="included reveal">
              <div class="included-media">
                <Image
                  src={getImg(i.image)}
                  alt={`${i.title} — что входит в аренду яхты на Санторини`}
                  widths={[300, 460, 620, 800]}
                  sizes="(min-width: 1100px) 280px, (min-width: 700px) 45vw, 92vw"
                  quality={84}
                />
              </div>
              <div class="included-body">
                <h3>{i.title}</h3>
                <p>{i.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Faq items={t.faq} title={t.faqSection.title} />

  <CtaBand title={t.cta.title} text={t.cta.text} waLink={WHATSAPP.yacht} />
</BaseLayout>

<style>
  .section-head {
    max-width: min(62ch, 100%);
    margin-bottom: var(--sp-7);
  }

  .program-media {
    position: relative;
    overflow: hidden;
  }

  .program-media :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }

  .program:hover .program-media :global(img) {
    transform: scale(1.05);
  }

  .program-time {
    position: absolute;
    left: var(--sp-3);
    bottom: var(--sp-3);
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(6px);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
  }

  /* --- флот --- */
  .fleet {
    display: grid;
    gap: var(--sp-6);
  }

  .yacht {
    display: grid;
    gap: 0;
    scroll-margin-top: 90px;
  }

  /*
    Пропорция фото задана явно. Без неё высоту карточки диктовал снимок:
    у Lagoon 46 фото почти квадратное, карточка вырастала под него, и между
    таблицей цен и кнопкой зияла пустота. С пропорцией карточка компактна,
    а если текст длиннее фото — колонка растягивается, и фото дотягивается
    за ней (object-fit: cover обрезает аккуратно).
  */
  .yacht-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }

  .yacht-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yacht-badge {
    position: absolute;
    top: var(--sp-3);
    left: var(--sp-3);
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-full);
    background: var(--c-sunset-500);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .yacht-body {
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .yacht-name {
    font-size: var(--fs-xl);
  }

  .yacht-guests {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .yacht-desc {
    color: var(--text-soft);
    font-size: var(--fs-sm);
  }

  /* --- таблица цен --- */
  /*
    Обёртка со своей прокруткой: если на очень узком экране таблица
    всё же не поместится, прокрутится она сама, а не вся страница.
  */
  .prices-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-inline: calc(var(--sp-1) * -1);
    padding-inline: var(--sp-1);
  }

  .prices {
    width: 100%;
    min-width: 17rem;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }

  .prices thead th {
    padding: var(--sp-2) var(--sp-2);
    text-align: right;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
  }

  .prices thead th:first-child {
    text-align: left;
  }

  .prices tbody th {
    padding: var(--sp-3) var(--sp-2);
    text-align: left;
    font-weight: 500;
    color: var(--text-soft);
    border-bottom: 1px solid var(--border);
  }

  .prices tbody td {
    padding: var(--sp-3) var(--sp-2);
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  .prices tbody tr:last-child th,
  .prices tbody tr:last-child td {
    border-bottom: none;
  }

  .prices tbody td:last-child {
    color: var(--accent);
  }

  .yacht-perks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    font-size: 0.82rem;
    color: var(--text-soft);
  }

  .yacht-perks span {
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
  }

  .yacht .btn {
    margin-top: auto;
    align-self: flex-start;
  }

  /* --- включено --- */
  .included {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }

  .included:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .included-media {
    overflow: hidden;
  }

  .included-media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 600ms var(--ease);
  }

  .included:hover .included-media :global(img) {
    transform: scale(1.05);
  }

  .included-body {
    padding: var(--sp-4) var(--sp-5) var(--sp-5);
  }

  .included h3 {
    font-family: var(--font-body);
    font-size: var(--fs-base);
    color: var(--accent);
    margin-bottom: var(--sp-2);
  }

  .included p {
    font-size: var(--fs-sm);
    color: var(--text-soft);
  }

  @media (min-width: 820px) {
    .yacht {
      grid-template-columns: 45% 1fr;
    }
  }
</style>
