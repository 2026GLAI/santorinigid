---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../data/url';
import Hero from '../../components/Hero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { WHATSAPP, pageUrl } from '../../data/site';
import { getImg } from '../../data/images';
import { fillDeep } from '../../data/fill';
import data from '../../data/pages/vip.json';

/*
 * СОДЕРЖИМОЕ СТРАНИЦЫ ЖИВЁТ В src/data/pages/vip.json — его правит
 * владелец через админку /admin (этап 2, 06.08.2026). Здесь только каркас.
 *
 * Памятки по содержимому (не возвращать без слова владельца):
 * — «групповых круизов» в карточке яхт УБРАНО 06.08.2026: групповой формат
 *   (билет на человека) он не продаёт, цены на странице яхт — за судно;
 * — шапка: катамаран с высоты (Targa 46 здесь повторяла карточку со
 *   страницы яхт); заголовок «VIP услуги…» вместо «Аренда яхт…» — 28.07;
 * — ссылка карточки «Фотосессии» — партнёрская (sunnyflyingdress.com).
 */
const t = fillDeep(data);

const heroVip = getImg(t.hero.image);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: pageUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'VIP услуги', item: pageUrl('/vip-service') },
  ],
};
---

<BaseLayout
  title={t.seo.title}
  description={t.seo.description}
  schema={schema}
  edit={[{ label: 'Тексты страницы', entry: 'pages/vip' }]}
>
  <Hero
    image={heroVip}
    alt={t.hero.alt}
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    text={t.hero.text}
  >
    <a href={WHATSAPP.general} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener">
      {t.hero.button}
    </a>
  </Hero>

  <section class="section">
    <div class="container container-wide">
      <header class="section-head reveal">
        <p class="eyebrow">{t.servicesSection.eyebrow}</p>
        <h2 class="section-title">{t.servicesSection.title}</h2>
      </header>

      <div class="services">
        {
          t.services.map((s) => (
            <a
              href={s.external ? s.href : url(s.href)}
              class="card svc reveal"
              target={s.external ? '_blank' : undefined}
              rel={s.external ? 'noopener' : undefined}
            >
              <div class="svc-media">
                <Image
                  src={getImg(s.image)}
                  alt={`${s.title} на Санторини`}
                  widths={[420, 640, 900, 1180]}
                  sizes="(min-width: 900px) 46vw, 92vw"
                  quality={84}
                />
              </div>
              <div class="card-body">
                <h3 class="card-title">{s.title}</h3>
                <p class="card-text">{s.text}</p>
                <span class="card-more">
                  {t.servicesSection.moreLabel} {s.external ? '↗' : '→'}
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .section-head {
    max-width: min(60ch, 100%);
    margin-bottom: var(--sp-7);
  }

  .services {
    display: grid;
    gap: var(--sp-5);
  }

  .svc-media {
    overflow: hidden;
  }

  .svc-media :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 700ms var(--ease);
  }

  .svc:hover .svc-media :global(img) {
    transform: scale(1.05);
  }

  .card-more {
    margin-top: auto;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--accent);
  }

  @media (min-width: 760px) {
    .services {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
