---
import { getImage, Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import { WHATSAPP, SITE_URL, pageUrl } from '../../data/site';
import { getImg } from '../../data/images';
import { fillDeep } from '../../data/fill';
import data from '../../data/pages/helicopters.json';

/*
 * СОДЕРЖИМОЕ СТРАНИЦЫ ЖИВЁТ В src/data/pages/helicopters.json — его правит
 * владелец через админку /admin (этап 2, 06.08.2026). Здесь только каркас.
 *
 * Борта (fleet): подтверждены разметкой старого сайта и alt-текстами фото.
 * Точные ТТХ (число мест) не указаны — не выдумываем. Состав авиапарка
 * (R44/H125/Bell 407) ждёт подтверждения владельца — см. очередь работ.
 * FAQ: все факты — из содержимого этой же страницы (routes, advantages,
 * текст cta). Разметку FAQPage отдаёт сам компонент Faq.
 */
const t = fillDeep(data);

const heroHeli = getImg(t.hero.image);

/* OG-картинка 1200×630 для превью ссылки в WhatsApp/Telegram. */
const og = await getImage({ src: heroHeli, width: 1200, height: 630, format: 'jpeg' });

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Вертолётные прогулки и VIP-трансферы на Санторини',
    serviceType: 'Аренда вертолёта, обзорные полёты, VIP-трансферы',
    provider: { '@id': `${SITE_URL}/#business` },
    areaServed: { '@type': 'Place', name: 'Санторини и острова Греции' },
    url: pageUrl('/vip-service/helicopter-tours'),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: pageUrl('/') },
      { '@type': 'ListItem', position: 2, name: 'VIP услуги', item: pageUrl('/vip-service') },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Вертолётные туры',
        item: pageUrl('/vip-service/helicopter-tours'),
      },
    ],
  },
];
---

<BaseLayout
  title={t.seo.title}
  description={t.seo.description}
  schema={schema}
  ogImage={og.src}
  edit={[{ label: 'Тексты и борта', entry: 'pages/helicopters' }]}
>
  <Hero
    image={heroHeli}
    alt={t.hero.alt}
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    text={t.hero.text}
  >
    <a href={WHATSAPP.helicopter} class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener">
      {t.hero.button}
    </a>
  </Hero>

  <section class="section">
    <div class="container container-narrow reveal">
      {/* Абзац от первого лица («наша команда» убрано 06.08.2026):
          весь сайт написан от «я». */}
      <p class="lede text-center">{t.intro}</p>
    </div>
  </section>

  <!-- Авиапарк -->
  <section class="section section-alt">
    <div class="container">
      <header class="section-head reveal">
        <p class="eyebrow">{t.fleetSection.eyebrow}</p>
        <h2 class="section-title">{t.fleetSection.title}</h2>
      </header>
      <div class="grid-auto">
        {
          t.fleet.map((f) => (
            <article class="card heli reveal">
              <div class="heli-media">
                <Image
                  src={getImg(f.image)}
                  alt={f.alt}
                  widths={[380, 560, 780]}
                  sizes="(min-width: 1000px) 360px, 92vw"
                  quality={80}
                />
              </div>
              <div class="card-body">
                <h3 class="card-title">{f.name}</h3>
                <p class="card-text">{f.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Маршруты и преимущества -->
  <section class="section">
    <div class="container">
      <div class="routes-hero reveal">
        <Image
          src={getImg(t.panorama.image)}
          alt={t.panorama.alt}
          widths={[640, 960, 1320]}
          sizes="(min-width: 1200px) 1140px, 94vw"
          quality={80}
        />
        <p class="routes-hero-caption">{t.panorama.caption}</p>
      </div>
    </div>

    <div class="container two-panel">
      <div class="panel reveal">
        <h2 class="panel-title">{t.routesSection.title}</h2>
        <ul class="routes">
          {
            t.routes.map((r) => (
              <li>
                <span class="route-name">{r.from}</span>
                <span class="route-dots" aria-hidden="true" />
                <span class="route-time">{r.time}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="panel reveal">
        <h2 class="panel-title">{t.advantagesSection.title}</h2>
        <ul class="advantages">
          {
            t.advantages.map((a) => (
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M20 6L9 17l-5-5" />
                </svg>
                <div>
                  <strong>{a.title}</strong>
                  <p>{a.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Faq items={t.faq} title={t.faqSection.title} />

  <CtaBand title={t.cta.title} text={t.cta.text} waLink={WHATSAPP.helicopter} />
</BaseLayout>

<style>
  .section-head {
    max-width: min(60ch, 100%);
    margin-bottom: var(--sp-7);
  }

  .heli-media :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .routes-hero {
    position: relative;
    margin-bottom: var(--sp-6);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .routes-hero :global(img) {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
  }

  .routes-hero-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--sp-6) var(--sp-5) var(--sp-4);
    background: linear-gradient(to top, rgb(6 30 48 / 0.85), transparent);
    color: #fff;
    font-size: var(--fs-sm);
  }

  .two-panel {
    display: grid;
    gap: var(--sp-6);
  }

  .panel {
    padding: var(--sp-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .panel-title {
    font-size: var(--fs-xl);
    margin-bottom: var(--sp-5);
  }

  .routes {
    display: grid;
    gap: var(--sp-3);
  }

  .routes li {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
  }

  .route-name {
    color: var(--text);
    font-weight: 500;
  }

  .route-dots {
    flex: 1;
    border-bottom: 1px dotted var(--border);
    min-width: 20px;
  }

  .route-time {
    color: var(--accent);
    font-weight: 600;
    white-space: nowrap;
  }

  .advantages {
    display: grid;
    gap: var(--sp-4);
  }

  .advantages li {
    display: flex;
    gap: var(--sp-3);
  }

  .advantages svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--accent);
  }

  .advantages strong {
    display: block;
    font-size: var(--fs-sm);
  }

  .advantages p {
    font-size: var(--fs-sm);
    color: var(--text-soft);
  }

  @media (min-width: 860px) {
    .two-panel {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
