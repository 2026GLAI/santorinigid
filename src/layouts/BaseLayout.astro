---
/**
 * Базовый макет: <head> со всей SEO/GEO-разметкой, шапка, подвал.
 * Каждая страница передаёт свой title/description/изображение.
 */
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import TopBar from '../components/TopBar.astro';
import { Font } from 'astro:assets';
import { url } from '../data/url';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import ScrollTop from '../components/ScrollTop.astro';
import EditLinks from '../components/EditLinks.astro';
import OwnerBeacon from '../components/OwnerBeacon.astro';
import {
  SITE_URL,
  SITE_NAME,
  OWNER_FULL_NAME,
  PROFILES,
  CONTACTS,
  ON_ISLAND_SINCE,
  GUIDE_SINCE,
  ISLAND_YEARS_TEXT,
  GUIDE_YEARS_TEXT,
  TOUR_PRICE_BASE,
  TOUR_HOURS_BASE,
  TOUR_PRICE_HOUR,
  pageUrl,
} from '../data/site';
import { YACHT_PRICE_FROM, YACHT_PRICE_TO } from '../data/yachts';

interface Props {
  title: string;
  description: string;
  /** Путь к OG-картинке относительно корня сайта, напр. /og/tours.jpg */
  ogImage?: string;
  /** Описание OG-картинки (для пересылок и читалок) */
  ogAlt?: string;
  /** Ключевые фразы страницы (meta keywords — читает Яндекс; Google игнорирует) */
  keywords?: string;
  /** Дополнительный JSON-LD, специфичный для страницы */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Кнопки «Изменить» для владельца: разделы админки этой страницы. */
  edit?: { label: string; entry: string }[];
  /**
   * Первый экран страницы тёмный (фото во весь экран, как на главной):
   * кольцо фокуса у верхней правой кнопки — светлое.
   * На страницах со светлым первым экраном — тёмный (по умолчанию).
   */
  darkTop?: boolean;
}

const {
  title,
  description,
  ogImage = '/og-default.jpg',
  ogAlt = 'Панорама деревни Ия на Санторини: белые дома и синие купола над морем',
  keywords,
  schema,
  noindex = false,
  edit = [],
  darkTop = false,
} = Astro.props;

/*
  Настоящий адрес страницы для Google.

  Astro.url.pathname уже содержит папку сайта («/santorinigid/tours/»),
  поэтому склеиваем его прямо с доменом — иначе папка задвоится.

  Косую черту в конце СОХРАНЯЕМ. Именно с ней GitHub Pages отдаёт
  страницу сразу (код 200); без неё отвечает «переехало» (301).
  Раньше здесь слеш срезался, и сайт указывал Google на адрес,
  которого нет — лишний прыжок на каждой из 10 страниц.
  Настройка trailingSlash: 'always' в astro.config.mjs — та же мысль
  для ссылок и карты сайта. Менять эти два места только вместе.
*/
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogUrl = new URL(ogImage, SITE_URL).href;

/**
 * Персона гида — одна на весь сайт, с постоянным @id: бизнес ссылается на
 * неё как на основателя, страница «Обо мне» — как на главную сущность.
 * Только проверенные факты: язык — русский (греческий не подтверждён —
 * не указываем), профили — из PROFILES.
 */
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE_URL}/#person`,
  name: OWNER_FULL_NAME,
  alternateName: 'Владимир',
  jobTitle: 'Частный русскоязычный гид на Санторини',
  description: `Живёт на Санторини с ${ON_ISLAND_SINCE} года (${ISLAND_YEARS_TEXT}), ${GUIDE_YEARS_TEXT} профессионального опыта проведения индивидуальных экскурсий.`,
  url: pageUrl('/about'),
  image: `${SITE_URL}/og-default.jpg`,
  telephone: CONTACTS.phone,
  email: CONTACTS.email,
  knowsLanguage: 'ru',
  knowsAbout: [
    'Санторини',
    'Экскурсии по Санторини',
    'Кальдера Санторини',
    'Ия (Ойя)',
    'Виноделие Санторини',
    'Аренда яхт на Санторини',
    'Вертолётные туры на Санторини',
  ],
  worksFor: { '@id': `${SITE_URL}/#business` },
  sameAs: [...PROFILES],
};

/**
 * Организация — основная сущность сайта. Показывается ИИ-поисковикам и Google.
 * Тип LocalBusiness (надтип, который понимают Google и Яндекс): частный гид —
 * не «туристический информационный центр». Услуги и цены — из тех же данных,
 * что видимый текст (makesOffer).
 */
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE_URL}/#business`,
  name: 'Владимир Лунгу — частный русскоязычный гид на Санторини',
  alternateName: 'Гид на Санторини Владимир',
  description: `Индивидуальные экскурсии по Санторини с частным русскоязычным гидом. ${ISLAND_YEARS_TEXT} жизни на острове, ${GUIDE_YEARS_TEXT} профессионального опыта. Аренда яхт и катамаранов, вертолётные туры, подбор отелей.`,
  url: pageUrl('/'),
  telephone: CONTACTS.phone,
  email: CONTACTS.email,
  image: `${SITE_URL}/og-default.jpg`,
  logo: `${SITE_URL}/icon-512.png`,
  priceRange: '€€€',
  knowsLanguage: 'ru',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    telephone: CONTACTS.phone,
    email: CONTACTS.email,
    availableLanguage: 'ru',
  },
  knowsAbout: ['Санторини', 'Ия', 'кальдера Санторини', 'экскурсии для гостей круизных лайнеров', 'аренда яхт и катамаранов', 'вертолётные туры'],
  makesOffer: [
    {
      '@type': 'Offer',
      price: TOUR_PRICE_BASE,
      priceCurrency: 'EUR',
      description: `Базовая индивидуальная экскурсия ${TOUR_HOURS_BASE} ч на автомобиле; каждый дополнительный час — ${TOUR_PRICE_HOUR} €`,
      itemOffered: { '@type': 'Service', name: 'Индивидуальная экскурсия по Санторини', serviceType: 'Экскурсия с частным русскоязычным гидом', areaServed: 'Санторини, Греция', url: pageUrl('/tours') },
    },
    {
      '@type': 'AggregateOffer',
      lowPrice: YACHT_PRICE_FROM,
      highPrice: YACHT_PRICE_TO,
      priceCurrency: 'EUR',
      itemOffered: { '@type': 'Service', name: 'Аренда яхт и катамаранов на Санторини', serviceType: 'Морские прогулки и круизы', areaServed: 'Санторини, Греция', url: pageUrl('/vip-service/yacht-rent-santorini') },
    },
    {
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: 'Вертолётные прогулки и VIP-трансферы', serviceType: 'Вертолётные туры', areaServed: 'Санторини, Греция', url: pageUrl('/vip-service/helicopter-tours') },
    },
    {
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: 'Подбор отелей на Санторини', serviceType: 'Подбор и бронирование отелей', areaServed: 'Санторини, Греция', url: pageUrl('/vip-service/santorini-hotels-2026') },
    },
  ],
  // Год начала работы гидом — подтверждён владельцем и профилем NeedGuide.
  foundingDate: String(GUIDE_SINCE),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Санторини (Тира)',
    addressRegion: 'Южные Эгейские острова',
    addressCountry: 'GR',
  },
  /*
    Координаты острова — чтобы Google понимал, ГДЕ работает гид, и показывал
    сайт по запросам «рядом со мной» и на картах.
    Значения из Википедии (инфобокс статьи Santorini): 36.415 / 25.4325.
    Это центр острова, а не точный адрес: гид работает по всему острову,
    а не в конкретной точке.
  */
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 36.415,
    longitude: 25.4325,
  },
  areaServed: {
    '@type': 'Place',
    name: 'Санторини, Греция',
  },
  // Профили на других площадках — так поисковики и ИИ понимают,
  // что сайт, отзывы и профили относятся к одному человеку.
  sameAs: [...PROFILES],
  founder: { '@id': `${SITE_URL}/#person` },
  employee: { '@id': `${SITE_URL}/#person` },
};

const schemas = [localBusiness, person, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];

/*
  ПРЕДПРОСМОТР (скрытый адрес *.pages.dev для владельца): сборка с
  PUBLIC_PREVIEW=1 (scripts/deploy-preview.mjs) ставит noindex на все
  страницы — поисковики не должны индексировать копию сайта на чужом
  адресе, иначе это дубль будущего основного сайта. В обычной сборке
  переменной нет, и всё как прежде.
*/
const isPreview = import.meta.env.PUBLIC_PREVIEW === '1';
const noRobots = noindex || isPreview;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    {/*
      viewport-fit=cover — без него не работают отступы env(safe-area-inset-*),
      которыми плавающие кнопки (чат, WhatsApp, «наверх») обходят полоску-домой
      и скруглённые углы телефона.

      interactive-widget=resizes-content — когда гость нажимает поле ввода
      в чате и выезжает клавиатура, браузер сжимает страницу, а не задвигает
      её под клавиатуру. Поле ввода остаётся видимым.
      Старые браузеры параметр просто игнорируют.
    */}
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />

    {/*
      Тема применяется ДО отрисовки страницы — этот скрипт стоит первым
      в <head> намеренно и намеренно же обычный, не defer/async.

      Иначе гость, выбравший тёмную тему, при каждом переходе видел бы
      вспышку белого фона: страница успевает нарисоваться светлой, и лишь
      потом скрипт из шапки её перекрашивает. Это заметно и неприятно.

      Скрипт крошечный и без зависимостей, задержки не создаёт.
    */}
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonical} />
    {noRobots && <meta name="robots" content="noindex, nofollow" />}
    {!noRobots && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}

    <!-- Open Graph — красивые карточки при пересылке ссылки -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <meta name="author" content="Владимир — гид на Санторини" />
    {/* Цвет рамки браузера на телефоне — под тёмную верхнюю полоску панели */}
    <meta name="theme-color" content="#0b0d0e" />

    <!-- Иконки -->
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <link rel="manifest" href={url("/site.webmanifest")} />

    {/*
      Шрифты лежат на нашем сайте — файлы скачаны у Google при сборке
      (настройка fonts в astro.config.mjs). Никаких обращений к чужим
      серверам при открытии страницы: сайт работает, даже если Google
      недоступен, и адрес гостя никуда не уходит.
    */}
    {/* Предзагружаем только кириллицу (тексты русские): латиница и курсив
        подгружаются по мере надобности через unicode-range — это −136 КБ
        на первом экране каждой страницы. */}
    <Font cssVariable="--font-lora" preload={[{ subset: 'cyrillic' }]} />
    <Font cssVariable="--font-cormorant" preload={[{ subset: 'cyrillic', style: 'normal' }]} />
    <Font cssVariable="--font-script" />

    <!-- Структурированные данные для Google и ИИ-поисковиков -->
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <!--
      Помечаем страницу как «скрипты работают» ДО отрисовки.
      Только после этого CSS прячет блоки для анимации появления.
      Если скрипты отключены или упали — весь текст виден сразу.
    -->
    <script is:inline>
      document.documentElement.classList.add('js-on');
    </script>
  </head>

  <body>
    {/*
      Кнопки «Изменить» для владельца: если в браузере есть СВЕЖАЯ запись
      входа админки (общий localStorage домена), на <html> ставится класс
      .owner — его читает панель EditLinks и фонарик служебного входа.
      Свежесть — как в банке (просьба владельца 07.08.2026): метку времени
      admin-last-active ведёт открытая вкладка админки; спустя 5 минут
      после выхода из неё запись входа протухает, и сайт сам её стирает —
      владелец видит обычный сайт, как все гости. Гостям класс не ставится.
      Число 5 минут живёт В ДВУХ ФАЙЛАХ — здесь и в public/admin/index.html.
      Менять только парой. Скрипт инлайновый и стоит первым: класс должен
      появиться до отрисовки.
    */}
    <script is:inline>
      try {
        const applyOwner = () => {
          let fresh = false;
          if (localStorage.getItem('sveltia-cms.user')) {
            const last = Number(localStorage.getItem('admin-last-active')) || 0;
            const idle = Date.now() - last;
            // idle < -60000 — «метка из будущего» (часы переводили назад):
            // тоже протухла, иначе держала бы вход часами.
            if (last && idle <= 5 * 60 * 1000 && idle >= -60000) {
              fresh = true;
            } else {
              localStorage.removeItem('sveltia-cms.user');
              localStorage.removeItem('sveltia-cms.auth');
              localStorage.removeItem('admin-last-active');
            }
          }
          document.documentElement.classList.toggle('owner', fresh);
        };
        applyOwner();
        // Кнопка «Назад» достаёт страницу из кэша браузера БЕЗ перезапуска
        // скриптов — класс пересчитываем заново, иначе после входа в
        // админку кнопки «Изменить» не появлялись бы (а после протухания —
        // не гасли) до ручной перезагрузки.
        addEventListener('pageshow', (e) => {
          if (e.persisted) applyOwner();
        });
      } catch (e) {
        /* приватный режим без localStorage — просто без кнопок */
      }
    </script>
    <a href="#main" class="skip-link">Перейти к содержимому</a>
    {/* Тонкая полоска прогресса чтения. Чисто CSS, без скриптов. */}
    <div class="scroll-progress" aria-hidden="true"></div>
    <Sidebar />
    {/*
      Обёртка страницы: от неё отсчитывается плашка вверху справа (TopBar,
      position: absolute) — на главной она ложится поверх фотографии.
      Отступ под боковую панель задаёт body (global.css, --sidebar-w).
    */}
    <div class="page" data-top={darkTop ? 'dark' : 'light'}>
      <TopBar />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
    {/* Плавающей кнопки WhatsApp больше нет — убрана владельцем
        28.07.2026 («у нас их и так много»): WhatsApp остался в шапке,
        в блоках-призывах и в подвале. Плавающих кнопок две:
        «наверх» и чат, обе справа. */}
    <ScrollTop />
    <ChatWidget />
    <EditLinks targets={edit} />
    <OwnerBeacon />

    <script>
      /*
        Появление блоков при прокрутке.

        Одна маленькая функция вместо библиотеки анимаций: браузер сам
        сообщает, когда блок попал в кадр, мы лишь вешаем класс. Дальше
        всё делает CSS. Это почти ничего не стоит по скорости.

        Кто просил меньше движения — сразу показываем всё как есть.
      */
      const items = document.querySelectorAll(
        '.reveal, .reveal-zoom, .reveal-left, .reveal-right, .reveal-stagger',
      );

      if (items.length) {
        // Каскад: каждому потомку свой номер, из него CSS считает задержку
        document.querySelectorAll('.reveal-stagger').forEach((group) => {
          [...group.children].forEach((child, i) => {
            child.style.setProperty('--i', String(Math.min(i, 8)));
          });
        });

        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );
        items.forEach((el) => io.observe(el));

        /*
          Страховка: если по какой-то причине наблюдатель не сработал
          (старый браузер, ошибка), через 3 секунды показываем всё.
          Гость никогда не должен увидеть пустую страницу.
        */
        setTimeout(() => {
          items.forEach((el) => el.classList.add('is-visible'));
        }, 3000);
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        top: -100px;
        left: var(--sp-4);
        z-index: 999;
        padding: var(--sp-3) var(--sp-5);
        background: var(--btn-bg);
        color: var(--on-accent);
        transition: top var(--dur) var(--ease);
      }
      .skip-link:focus {
        top: var(--sp-4);
      }

      .page {
        position: relative;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        /* Контейнер для @container page (…): раскладки страниц считаются от
           ширины СОДЕРЖИМОГО, а не окна — при боковой панели окно 1024px
           даёт лишь 792px, и двухколоночные сетки от @media тесны */
        container-type: inline-size;
        container-name: page;
      }

      .page > main {
        flex: 1;
      }

      /* Тёмный первый экран (фото): кольцо фокуса плашки — светлое */
      .page[data-top='dark'] {
        --topbar-fg: var(--c-ivory);
      }
    </style>
  </body>
</html>
