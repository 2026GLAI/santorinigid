---
import { Image } from 'astro:assets';
import { NAV, WHATSAPP } from '../data/site';
import { url } from '../data/url';
import shared from '../data/pages/shared.json';
import logo from '../assets/img/logo-dome.png';

/*
  Адрес текущей страницы для подсветки активного пункта меню.

  Убираем префикс папки: пока сайт живёт на GitHub во вложенной папке,
  pathname выглядит как «/santorinigid/tours», а в данных навигации
  записано «/tours». Без этого ни один пункт не подсветился бы.
*/
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    <a href={url('/')} class="brand" aria-label="На главную">
      <Image
        src={logo}
        alt="Логотип: синий купол церкви Санторини"
        width={44}
        height={44}
        class="brand-logo"
        loading="eager"
      />
      <span class="brand-text">
        <strong>{shared.brand.top}</strong>
        <span>{shared.brand.sub}</span>
      </span>
    </a>

    <nav class="nav-desktop" aria-label="Основная навигация">
      <ul>
        {
          NAV.map((item) =>
            'children' in item && item.children ? (
              <li class="has-sub">
                <a href={url(item.href)} class:list={['nav-link', { active: isActive(item.href) }]}>
                  {item.label}
                  <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
                    <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                  </svg>
                </a>
                <ul class="submenu">
                  {item.children.map((c) => (
                    <li>
                      <a href={url(c.href)} class:list={{ active: path === c.href }}>
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={url(item.href)} class:list={['nav-link', { active: isActive(item.href) }]}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a href={WHATSAPP.general} class="btn btn-whatsapp btn-sm" target="_blank" rel="noopener">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.48-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.53.07-.8.38-.28.3-1.05 1.02-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.11 3.23 5.12 4.53.71.31 1.27.49 1.71.63.72.23 1.37.2 1.89.12.58-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35z"
          />
          <path
            d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 004.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm0 18.13h-.01a8.2 8.2 0 01-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 01-1.26-4.36c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 012.41 5.83c0 4.54-3.7 8.24-8.24 8.24z"
          />
        </svg>
        <span class="wa-label">WhatsApp</span>
      </a>

      {/*
        Переключатель светлой и тёмной темы.

        До него тёмная тема на сайте была, но включить её вручную было
        нельзя — она приходила только из настроек телефона. Половина правил
        CSS работала вслепую.

        Три положения по кругу: «как на устройстве» → светлая → тёмная.
        Первое положение — по умолчанию: сайт слушается системной настройки,
        как раньше. Выбор человека хранится в его же браузере и на сервер
        не уходит.
      */}
      <button class="theme-btn" id="themeBtn" aria-label="Тема оформления">
        <svg class="ico-auto" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 3v18" />
          <path d="M12 3a9 9 0 010 18" fill="currentColor" stroke="none" />
        </svg>
        <svg class="ico-sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="ico-moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 019.5 4a8.5 8.5 0 1010.5 10.5z" />
        </svg>
      </button>

      <button
        class="burger"
        id="burger"
        aria-label="Открыть меню"
        aria-expanded="false"
        aria-controls="mobileNav"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="nav-mobile" id="mobileNav" aria-label="Мобильная навигация" hidden>
    <ul class="container">
      {
        NAV.map((item) => (
          <li>
            <a href={url(item.href)} class:list={{ active: isActive(item.href) }}>
              {item.label}
            </a>
            {'children' in item && item.children && (
              <ul class="mobile-sub">
                {item.children.map((c) => (
                  <li>
                    <a href={url(c.href)} class:list={{ active: path === c.href }}>
                      {c.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const burger = document.getElementById('burger');
  const mobileNav = document.getElementById('mobileNav');
  const header = document.getElementById('siteHeader');

  /* ---- Переключатель темы -------------------------------------------
     Три положения по кругу: auto → light → dark → auto.

     «auto» — атрибут data-theme снимается вовсе, и работает медиазапрос
     prefers-color-scheme, то есть настройка телефона. Это положение
     по умолчанию, поведение как было до переключателя.

     Выбор хранится в localStorage — это память самого браузера гостя.
     На сервер ничего не уходит, у каждого своя настройка.
     Само переключение делает BaseLayout ДО отрисовки страницы, чтобы
     не было вспышки светлого фона у того, кто выбрал тёмную тему.
  */
  const themeBtn = document.getElementById('themeBtn');
  const ORDER = ['auto', 'light', 'dark'];
  const LABEL = {
    auto: 'Тема: как на устройстве. Нажмите — светлая',
    light: 'Тема: светлая. Нажмите — тёмная',
    dark: 'Тема: тёмная. Нажмите — как на устройстве',
  };

  function applyTheme(mode) {
    if (mode === 'auto') document.documentElement.removeAttribute('data-theme');
    else document.documentElement.setAttribute('data-theme', mode);
    if (themeBtn) {
      themeBtn.dataset.mode = mode;
      themeBtn.setAttribute('aria-label', LABEL[mode]);
      themeBtn.setAttribute('title', LABEL[mode]);
    }
  }

  let mode = 'auto';
  try {
    const saved = localStorage.getItem('theme');
    if (ORDER.includes(saved)) mode = saved;
  } catch {
    /* Приватный режим блокирует хранилище — просто работаем без памяти. */
  }
  applyTheme(mode);

  themeBtn?.addEventListener('click', () => {
    mode = ORDER[(ORDER.indexOf(mode) + 1) % ORDER.length];
    applyTheme(mode);
    try {
      if (mode === 'auto') localStorage.removeItem('theme');
      else localStorage.setItem('theme', mode);
    } catch {
      /* Не сохранилось — тема всё равно переключилась на этой странице. */
    }
  });

  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    burger.setAttribute('aria-label', open ? 'Открыть меню' : 'Закрыть меню');
    if (mobileNav) mobileNav.hidden = open;
    document.body.style.overflow = open ? '' : 'hidden';
  });

  // Закрываем меню при клике по ссылке
  mobileNav?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      burger?.setAttribute('aria-expanded', 'false');
      if (mobileNav) mobileNav.hidden = true;
      document.body.style.overflow = '';
    }),
  );

  // Шапка «прилипает» и уплотняется при прокрутке
  const onScroll = () => {
    header?.classList.toggle('scrolled', window.scrollY > 20);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }

  .site-header.scrolled {
    border-bottom-color: var(--border);
    background: color-mix(in srgb, var(--bg) 94%, transparent);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    min-height: 72px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-shrink: 0;
  }

  .brand-logo {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-text strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }

  .brand-text span {
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  /* --- десктопное меню --- */
  .nav-desktop {
    display: none;
  }

  .nav-desktop > ul {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 0.55rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-soft);
    transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease);
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .nav-link.active {
    color: var(--accent);
    font-weight: 600;
  }

  .has-sub {
    position: relative;
  }

  /*
    Подменю «VIP услуги».

    Две защиты от преждевременного закрытия (жалоба владельца 28.07.2026 —
    «не успеваю перейти на подменю»):
    1. Невидимый мостик (::before) накрывает зазор 6px между пунктом
       и окошком — наведение не теряется, пока курсор летит вниз.
    2. Задержка закрытия 350 мс: увёл курсор в сторону — меню прощает
       и ждёт. Открытие при этом мгновенное (задержка обнуляется).
  */
  .submenu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 232px;
    padding: var(--sp-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease),
      visibility var(--dur);
    transition-delay: 350ms;
  }

  .submenu::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -8px;
    height: 8px;
  }

  .has-sub:hover .submenu,
  .has-sub:focus-within .submenu {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0ms;
  }

  .submenu a {
    display: block;
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    color: var(--text-soft);
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .submenu a:hover,
  .submenu a.active {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .btn-sm {
    padding: 0.55em 1.1em;
    font-size: 0.86rem;
  }

  /* --- бургер --- */
  /* ---- Кнопка выбора темы ----
     Размер 44×44 — минимальная цель нажатия пальцем по рекомендациям
     доступности, как и у бургера рядом.

     Внутри лежат сразу три значка, видим всегда ровно один — тот, что
     соответствует текущему положению. Так кнопка показывает состояние,
     а не просто «что-то переключает». */
  .theme-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    color: var(--text-soft);
    transition:
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .theme-btn:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .theme-btn svg {
    display: none;
  }

  /* Пока скрипт не выставил режим, показываем значок «как на устройстве» —
     он и есть положение по умолчанию. */
  .theme-btn .ico-auto,
  .theme-btn[data-mode='auto'] .ico-auto {
    display: block;
  }

  .theme-btn[data-mode='light'] .ico-auto,
  .theme-btn[data-mode='dark'] .ico-auto {
    display: none;
  }

  .theme-btn[data-mode='light'] .ico-sun,
  .theme-btn[data-mode='dark'] .ico-moon {
    display: block;
  }

  /* Размер 48×48 и линии потолще — просьба владельца 28.07.2026:
     кнопка меню на телефоне должна быть заметной и крупной.
     Шапка липкая (position: sticky), поэтому кнопка видна всегда,
     на любой прокрутке — прятаться ей некуда. */
  .burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 48px;
    height: 48px;
    padding: 0 10px;
    border-radius: var(--radius-sm);
  }

  .burger span {
    display: block;
    height: 3px;
    background: var(--text);
    border-radius: 3px;
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }

  .burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(9px) rotate(45deg);
  }

  .burger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }

  .burger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-9px) rotate(-45deg);
  }

  /* --- мобильное меню --- */
  .nav-mobile {
    position: fixed;
    inset: 72px 0 0;
    background: var(--bg);
    overflow-y: auto;
    /* Нижний отступ с добавкой «безопасной зоны»: меню раскрыто
       до самого низа экрана, а в viewport стоит viewport-fit=cover.
       Без добавки последние пункты меню («Контакты») попадали бы
       под жестовую панель Android. */
    padding-block: var(--sp-5) calc(var(--sp-8) + env(safe-area-inset-bottom, 0px));
    animation: slideIn var(--dur) var(--ease);
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .nav-mobile a {
    display: block;
    padding: 0.85rem 0;
    font-size: 1.18rem;
    font-family: var(--font-display);
    border-bottom: 1px solid var(--border);
    transition: color var(--dur) var(--ease);
  }

  .nav-mobile a.active {
    color: var(--accent);
  }

  .mobile-sub {
    padding-left: var(--sp-4);
  }

  .mobile-sub a {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--text-soft);
  }

  @media (min-width: 1040px) {
    .nav-desktop {
      display: block;
    }
    .burger {
      display: none;
    }
    .nav-mobile {
      display: none !important;
    }
  }

  /*
    Телефоны (до 520px).
    Здесь дорог каждый пиксель: шапка не должна выезжать за край.
    Убираем подпись под названием и текст на кнопке WhatsApp —
    иконка понятна и без слова.

    ⚠️ Порог 520, а НЕ 420. Полной шапке (логотип с подписью + кнопка
    WhatsApp со словом + тема + бургер) нужно ~490px ширины. При прежнем
    пороге 420 телефоны шириной 421–489px (например, 480px при плотности
    3×) получали полную шапку, и бургер обрезался краем экрана — найдено
    по живому скриншоту владельца 28.07.2026. Порог обязан быть НЕ НИЖЕ
    ширины, при которой полная шапка реально помещается.
  */
  @media (max-width: 520px) {
    .header-inner {
      gap: var(--sp-2);
      min-height: 62px;
    }

    .brand-text span {
      display: none;
    }

    .brand-logo {
      width: 38px;
      height: 38px;
    }

    .brand-text strong {
      font-size: 0.95rem;
    }

    /* Кнопка становится круглой — остаётся только значок */
    .btn-whatsapp.btn-sm {
      padding: 0;
      width: 42px;
      height: 42px;
      min-width: 42px;
      border-radius: var(--radius-full);
    }

    .wa-label {
      /* Прячем текст от глаз, но оставляем для чтения с экрана */
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .header-actions {
      gap: var(--sp-2);
    }

    /* Кнопку меню на телефоне НЕ ужимаем — владелец просил крупную. */

    .nav-mobile {
      inset-block-start: 62px;
    }
  }

  /* Совсем узкие экраны (от 320px) — прячем текст кнопки полностью */
  @media (max-width: 360px) {
    .brand-text {
      display: none;
    }
  }
</style>
