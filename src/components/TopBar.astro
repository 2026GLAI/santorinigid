---
/**
 * Верхняя правая плашка широкого экрана — версия 2: золотая кнопка
 * «Забронировать тур». Лежит ПОВЕРХ первого экрана страницы (на главной —
 * поверх фотографии), на телефоне не показывается: там WhatsApp и меню
 * живут в верхней полоске (Sidebar.astro).
 *
 * Телефона и часов работы здесь нет намеренно: телефон владелец убрал
 * 19.08.2026 («и так везде есть контакты»), а часов работы нет в данных
 * сайта — выдумывать «08:00–22:00» нельзя.
 */
import { url } from '../data/url';
import shared from '../data/pages/shared.json';
---

<div class="topbar">
  <a href={url('/contacts')} class="btn btn-primary topbar-cta">
    {shared.topbar.button}
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 17L17 7M9 7h8v8" />
    </svg>
  </a>
</div>

<style>
  .topbar {
    position: absolute;
    top: clamp(1.25rem, 3vh, 2.25rem);
    right: clamp(1.25rem, 3vw, 3rem);
    z-index: 90;
    display: none;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    view-transition-name: topbar;
  }

  @media (min-width: 1024px) {
    .topbar {
      display: flex;
    }
  }

  .topbar-cta {
    white-space: nowrap;
  }

  /* Кольцо фокуса — цветом текста плашки: слоновая кость на фото/подложке,
     почти чёрный на слоновой кости страницы */
  .topbar :focus-visible {
    outline-color: var(--topbar-fg, var(--text));
  }
</style>
