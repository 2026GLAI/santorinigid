---
/**
 * Верхняя правая плашка широкого экрана — версия 2: телефон и золотая
 * кнопка «Забронировать тур». Лежит ПОВЕРХ первого экрана страницы
 * (на главной — поверх фотографии), на телефоне не показывается:
 * там WhatsApp и меню живут в верхней полоске (Sidebar.astro).
 *
 * Часов работы здесь нет намеренно: их нет в данных сайта, а «отвечаю
 * в течение часа в рабочее время» — единственная проверенная формулировка
 * (shared.json → footer.replyNote). Выдумывать «08:00–22:00» нельзя.
 */
import { CONTACTS } from '../data/site';
import { url } from '../data/url';
import shared from '../data/pages/shared.json';
---

<div class="topbar">
  <a href={CONTACTS.phoneHref} class="topbar-contact">
    <span class="topbar-label">{shared.topbar.contactLabel}</span>
    <span class="topbar-phone">{CONTACTS.phone}</span>
  </a>
  <a href={url('/contacts')} class="btn btn-primary topbar-cta">
    {shared.topbar.button}
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 17L17 7M9 7h8v8" />
    </svg>
  </a>
</div>

<style>
  .topbar {
    position: absolute;
    top: clamp(1.25rem, 3vh, 2.25rem);
    right: clamp(1.25rem, 3vw, 3rem);
    z-index: 90;
    display: none;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    view-transition-name: topbar;
  }

  @media (min-width: 1024px) {
    .topbar {
      display: flex;
    }
  }

  .topbar-contact {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.3;
    /* Цвет и подложку задаёт страница (BaseLayout, .page[data-top]):
       на фото — слоновая кость на матовой графитовой подложке (под
       плашкой самое светлое небо кадра: без подложки 2.7–4.2:1, с ней
       ≥7:1 по расчёту ревизии 19.08); на слоновой кости — тёмный текст
       без подложки. */
    color: var(--topbar-fg, var(--text));
    padding: 0.4rem 0.8rem;
    margin: -0.4rem -0.8rem;
    background: var(--topbar-plate, transparent);
    backdrop-filter: var(--topbar-blur, none);
    transition: color var(--dur) var(--ease);
  }

  /* Наведение — сменой цвета, не прозрачностью: контраст не падает */
  .topbar-contact:hover {
    color: var(--gold);
  }

  .topbar-label {
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .topbar-phone {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .topbar-cta {
    white-space: nowrap;
  }

  /* Кольцо фокуса — цветом текста плашки: слоновая кость на фото/подложке,
     почти чёрный на слоновой кости страницы */
  .topbar :focus-visible {
    outline-color: var(--topbar-fg, var(--text));
  }
</style>
