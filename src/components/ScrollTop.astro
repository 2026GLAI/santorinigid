---
/**
 * Кнопка «наверх».
 *
 * Появляется, когда гость прокрутил страницу заметно вниз, и увозит
 * его к началу одним нажатием. На длинных страницах — экскурсии, отели,
 * отзывы — иначе приходится долго листать обратно.
 *
 * Расположение: правый нижний угол, НАД кнопкой чата с заметным
 * просветом (просьба владельца 28.07.2026 — «подними немного выше»),
 * и ровно по её вертикальной оси — центр в центр (просьба 19.08.2026).
 * Цвет — палитра v2 (решение владельца 19.08.2026, вечер): золотой круг,
 * белая каёмка, за ней тонкий золотой ободок, белая стрелка («чёрная
 * кнопка — похоронное бюро»). Наведение — только там, где есть мышь:
 * на телефоне стиль наведения «залипал» после нажатия.
 */
---

<button class="to-top" id="toTop" aria-label="Наверх страницы" hidden>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7" />
  </svg>
</button>

<style>
  .to-top {
    position: fixed;
    z-index: 94;
    /* Кнопка чата шире (clamp(68px, 5vw, 84px)); сдвигаем на половину
       разницы — центры совпадают на любом экране */
    --size: 48px;
    right: calc(
      max(clamp(1rem, 3vw, 1.75rem), env(safe-area-inset-right, 0px)) +
        (clamp(68px, 5vw, 84px) - var(--size)) / 2
    );
    /* Над кнопкой чата: её высота (68–84px) плюс просвет.
       Считается тем же clamp — если кнопка чата изменится,
       поправить надо будет обе в одном месте.

       Нижний отступ берётся с оглядкой на «безопасную зону» ровно так же,
       как у кнопки чата: иначе на телефоне с полоской-домой чат поднимется,
       а эта кнопка останется на месте — и они налезут друг на друга. */
    bottom: calc(
      max(clamp(1rem, 3vw, 1.75rem), env(safe-area-inset-bottom, 0px)) +
        clamp(68px, 5vw, 84px) + 1.5rem
    );
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    border-radius: var(--radius-full);
    /* Золотой круг, белая каёмка 2px, снаружи тонкий золотой ободок
       (через box-shadow), белая стрелка с лёгкой тенью для чёткости.
       Одинаков в обеих темах. */
    background: var(--gold);
    color: #fff;
    border: 2px solid #fff;
    box-shadow:
      0 0 0 2px var(--gold),
      var(--shadow);
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .to-top svg {
    filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.25));
  }

  /* Наведение — только с мышью: чуть темнее золото и подъём.
     На сенсорных экранах :hover «залипает» после нажатия — там его нет. */
  @media (hover: hover) and (pointer: fine) {
    .to-top:hover {
      background: color-mix(in srgb, var(--gold) 85%, var(--c-bronze));
      transform: translateY(-2px);
    }
  }

  /* Нажатие — короткое сжатие, видно и на телефоне */
  .to-top:active {
    transform: scale(0.94);
  }

  /* Плавное появление: скрипт снимает hidden, а класс включает видимость.
     Без этого кнопка выскакивала бы рывком. */
  .to-top {
    opacity: 0;
  }

  .to-top.is-visible {
    opacity: 1;
  }

  /* На телефоне при открытом чате кнопка не нужна: чат во весь экран */
  @media (max-width: 640px) {
    :global(html.chat-open) .to-top {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .to-top {
      transition: opacity var(--dur) var(--ease);
    }

    .to-top:hover {
      transform: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('toTop');

  if (btn) {
    /*
      Порог появления — 0,8 экрана: кнопка приходит, как только гость
      ушёл с первого экрана. Раньше стояло полтора экрана — владелец
      попросил показывать раньше (28.07.2026).
    */
    const threshold = () => window.innerHeight * 0.8;

    const update = () => {
      const show = window.scrollY > threshold();
      btn.hidden = !show;
      // Класс отдельным шагом: hidden убирает элемент со страницы мгновенно,
      // а класс даёт плавное проявление.
      requestAnimationFrame(() => btn.classList.toggle('is-visible', show));
    };

    // passive: браузер знает, что прокрутку мы не отменяем, и не тормозит её
    window.addEventListener('scroll', update, { passive: true });
    update();

    btn.addEventListener('click', () => {
      /*
        Уважаем системную настройку «убрать движение»: кому плавная
        прокрутка неприятна (укачивание) — переносим сразу.
      */
      const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' });
    });
  }
</script>
