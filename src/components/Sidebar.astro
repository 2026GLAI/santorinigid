---
/**
 * Боковая панель — версия 2. Заменяет верхнюю шапку (Header.astro v1).
 *
 * На широком экране (≥1024px): узкая тёмная колонка слева, закреплена:
 * монограмма и имя, нумерованное меню, внизу — мессенджеры и тема.
 * На телефоне: тёмная верхняя полоска (монограмма, WhatsApp, «бургер»),
 * меню раскрывается во весь экран.
 *
 * Тексты (имя, подпись) — из shared.json, их правит владелец в админке.
 * Ссылки — из site.ts (NAV, CONTACTS, WHATSAPP): один источник правды.
 */
import { Image } from 'astro:assets';
import { NAV, WHATSAPP, CONTACTS } from '../data/site';
import { url } from '../data/url';
import shared from '../data/pages/shared.json';
/* Логотип владельца (19.08.2026): купол, колокольня, море и солнце.
   Две версии — обе лежат в src/assets/img, переключается ОДНОЙ строкой
   здесь и в Footer.astro (и иконки: scripts/make-icons.mjs):
     logo-v2-light.png — светлый круг с золотым кольцом (сейчас, по просьбе
                         владельца: «Санторини — остров, не похоронное бюро»);
     logo-v2.png       — тёмная версия, золотой полумесяц, без фона.
   Оригиналы — docs/фото-оригиналы/лого-*.png. */
import logo from '../assets/img/logo-v2-light.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-top">
    <a href={url('/')} class="brand">
      <Image src={logo} alt="" width={96} densities={[1, 2, 3]} class="logo" loading="eager" />
      <span class="brand-text">
        <strong>{shared.brand.top}</strong>
        <span>{shared.brand.sub}</span>
      </span>
    </a>

    <div class="bar-actions">
      <a href={WHATSAPP.general} class="bar-wa" target="_blank" rel="noopener" aria-label="Написать в WhatsApp">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.48-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.53.07-.8.38-.28.3-1.05 1.02-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.11 3.23 5.12 4.53.71.31 1.27.49 1.71.63.72.23 1.37.2 1.89.12.58-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 004.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm0 18.13h-.01a8.2 8.2 0 01-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 01-1.26-4.36c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 012.41 5.83c0 4.54-3.7 8.24-8.24 8.24z"
          />
        </svg>
      </a>
      <button
        class="burger"
        id="burger"
        aria-label="Открыть меню"
        aria-expanded="false"
        aria-controls="sideNav"
      >
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="side-nav" id="sideNav" aria-label="Основная навигация">
    <ol>
      {
        NAV.map((item, i) => (
          <li class:list={{ 'has-sub': 'children' in item && item.children }}>
            <a
              href={url(item.href)}
              class:list={['nav-link', { active: isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {/* Номер — украшение: читалке экрана не нужно «01Главная» */}
              <span class="nav-num" aria-hidden="true">{num(i)}</span>
              <span class="nav-label">{item.label}</span>
            </a>
            {'children' in item && item.children && (
              <ul class="sub">
                {item.children.map((c) => (
                  <li>
                    <a
                      href={url(c.href)}
                      class:list={{ active: path === c.href }}
                      aria-current={path === c.href ? 'page' : undefined}
                    >
                      {c.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>

    <div class="side-bottom">
      <ul class="socials">
        <li>
          <a href={WHATSAPP.general} target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.48-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.53.07-.8.38-.28.3-1.05 1.02-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.11 3.23 5.12 4.53.71.31 1.27.49 1.71.63.72.23 1.37.2 1.89.12.58-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 004.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm0 18.13h-.01a8.2 8.2 0 01-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 01-1.26-4.36c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 012.41 5.83c0 4.54-3.7 8.24-8.24 8.24z"
              />
            </svg>
            WhatsApp
          </a>
        </li>
        <li>
          <a href={CONTACTS.telegram} target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M21.94 4.6l-3.02 14.25c-.23 1-.83 1.25-1.67.78l-4.62-3.4-2.23 2.14c-.25.25-.45.45-.92.45l.33-4.68 8.52-7.7c.37-.33-.08-.51-.57-.18L7.23 12.9 2.67 11.5c-.99-.31-1-.99.21-1.47L20.67 3.2c.82-.3 1.54.2 1.27 1.4z"
              />
            </svg>
            Telegram
          </a>
        </li>
        <li>
          <a href={CONTACTS.instagram} target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="17.6" cy="6.4" r="1.2" fill="currentColor" stroke="none" />
            </svg>
            Instagram
          </a>
        </li>
      </ul>

      <div class="side-foot">
        <a href={CONTACTS.phoneHref} class="side-phone">{CONTACTS.phone}</a>
        <button class="theme-btn" id="themeBtn" aria-label="Тема оформления">
          <svg class="ico-auto" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 3v18" />
            <path d="M12 3a9 9 0 010 18" fill="currentColor" stroke="none" />
          </svg>
          <svg class="ico-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
          <svg class="ico-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 14.5A8.5 8.5 0 019.5 4a8.5 8.5 0 1010.5 10.5z" />
          </svg>
        </button>
      </div>
    </div>
  </nav>
</aside>

<script>
  const burger = document.getElementById('burger');
  const sideNav = document.getElementById('sideNav');
  const sidebar = document.getElementById('sidebar');

  /* ---- Переключатель темы: auto → light → dark → auto ------------------
     «auto» — атрибут data-theme снимается, работает настройка устройства.
     Выбор хранится в localStorage браузера гостя; на сервер не уходит.
     Само применение делает BaseLayout ДО отрисовки — без вспышки фона. */
  const themeBtn = document.getElementById('themeBtn');
  const ORDER = ['auto', 'light', 'dark'];
  const LABEL: Record<string, string> = {
    auto: 'Тема: как на устройстве. Нажмите — светлая',
    light: 'Тема: светлая. Нажмите — тёмная',
    dark: 'Тема: тёмная. Нажмите — как на устройстве',
  };

  function applyTheme(mode: string) {
    if (mode === 'auto') document.documentElement.removeAttribute('data-theme');
    else document.documentElement.setAttribute('data-theme', mode);
    if (themeBtn) {
      themeBtn.dataset.mode = mode;
      themeBtn.setAttribute('aria-label', LABEL[mode]);
      themeBtn.setAttribute('title', LABEL[mode]);
    }
  }

  let mode = 'auto';
  try {
    const saved = localStorage.getItem('theme');
    if (saved && ORDER.includes(saved)) mode = saved;
  } catch {
    /* Приватный режим блокирует хранилище — работаем без памяти. */
  }
  applyTheme(mode);

  themeBtn?.addEventListener('click', () => {
    mode = ORDER[(ORDER.indexOf(mode) + 1) % ORDER.length];
    applyTheme(mode);
    try {
      if (mode === 'auto') localStorage.removeItem('theme');
      else localStorage.setItem('theme', mode);
    } catch {
      /* Не сохранилось — тема всё равно переключилась на этой странице. */
    }
  });

  /* ---- Меню на телефоне ------------------------------------------------ */
  function setMenu(open: boolean) {
    burger?.setAttribute('aria-expanded', String(open));
    burger?.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
    sidebar?.classList.toggle('menu-open', open);
    document.documentElement.classList.toggle('menu-open', open);
    // Меню во весь экран накрывает страницу: всё под ним — inert, чтобы
    // Tab и читалка экрана не уходили в скрытое содержимое (чат, форма,
    // кнопки владельца). Снимается тем же вызовом при закрытии.
    document
      .querySelectorAll('.page, .chat-root, .to-top, .owner-beacon, .edit-panel')
      .forEach((el) => el.toggleAttribute('inert', open));
  }

  burger?.addEventListener('click', () => {
    setMenu(burger.getAttribute('aria-expanded') !== 'true');
  });

  // Ссылка нажата — меню закрываем (переход по якорю страницу не меняет)
  sideNav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

  // Esc закрывает меню и возвращает фокус на «бургер»: иначе спрятанное
  // меню (visibility:hidden) сбрасывает фокус на <body>, и гость с клавиатуры
  // оказывается в начале страницы
  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !sidebar?.classList.contains('menu-open')) return;
    const wasInside = !!sideNav?.contains(document.activeElement);
    setMenu(false);
    if (wasInside) burger?.focus();
  });

  // Повернули телефон / расширили окно — открытое меню телефона не нужно
  matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });
</script>

<style>
  /* ============================================================
     ШИРОКИЙ ЭКРАН: закреплённая колонка слева
     ============================================================ */
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    width: var(--sidebar-w);
    height: 100dvh;
    padding: clamp(1.25rem, 3vh, 2.25rem) clamp(1.1rem, 1.6vw, 1.75rem);
    background: var(--c-black);
    color: var(--c-ivory);
    border-right: 1px solid var(--border-dark);
    /* Панель одна на всех страницах — при смене страницы не перерисовывается */
    view-transition-name: sidebar;
    /* Всегда тёмная: кольцо фокуса золотое (8.69:1), не бронза */
    --focus-ring: var(--c-gold);
  }

  .sidebar-top {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
  }

  /* Логотип и имя — по оси панели (просьба владельца 19.08: логотип
     стоял у левого края); меню ниже остаётся у левого края */
  .brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: center;
    gap: var(--sp-3);
    text-align: center;
  }

  .brand :global(.logo) {
    width: 5.25rem;
    height: auto;
    transition: opacity var(--dur) var(--ease);
  }

  .brand:hover :global(.logo) {
    opacity: 0.85;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.25;
  }

  .brand-text strong {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.12rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-ivory);
  }

  .brand-text span {
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
  }

  /* На широком экране кнопок в верхней части нет */
  .bar-actions {
    display: none;
  }

  /* ---- меню ---- */
  .side-nav {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    margin-top: clamp(1.5rem, 6vh, 4rem);
    /* На низком окне (ноутбук с панелью задач) меню прокручивается внутри;
       тонкая полоса в тон панели — подсказка, что ниже есть ещё */
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border-dark) transparent;
  }


  .side-nav ol {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .nav-link {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.42rem 0;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #b9b2a6; /* 9.26:1 на почти чёрном */
    transition: color var(--dur) var(--ease);
  }

  .nav-num {
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: #9a9388; /* 6.40:1 */
    transition: color var(--dur) var(--ease);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--c-ivory);
  }

  .nav-link.active {
    color: var(--gold);
  }

  .nav-link.active .nav-num {
    color: var(--gold);
  }

  /* Активный пункт: золотая чёрточка, «входящая» слева из-за края панели */
  .nav-link.active::before {
    content: '';
    position: absolute;
    left: calc(-1 * clamp(1.1rem, 1.6vw, 1.75rem));
    top: 50%;
    width: 0.9rem;
    height: 1px;
    background: var(--gold);
  }

  .sub {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.15rem 0 0.35rem 2.35rem;
  }

  .sub a {
    display: block;
    padding: 0.22rem 0;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9a9388;
    transition: color var(--dur) var(--ease);
  }

  .sub a:hover,
  .sub a.active {
    color: var(--gold);
  }

  /* ---- низ панели ---- */
  .side-bottom {
    margin-top: auto;
    padding-top: clamp(1rem, 4vh, 2.5rem);
  }

  .socials {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--border-dark);
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #b9b2a6;
    transition: color var(--dur) var(--ease);
  }

  .socials a:hover {
    color: var(--gold);
  }

  .socials svg {
    color: var(--gold);
    flex: none;
  }

  .side-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    padding-top: 1rem;
  }

  .side-phone {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: #b9b2a6;
    white-space: nowrap;
    transition: color var(--dur) var(--ease);
  }

  .side-phone:hover {
    color: var(--c-ivory);
  }

  .theme-btn {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    color: #b9b2a6;
    border: 1px solid var(--border-dark);
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .theme-btn:hover {
    color: var(--gold);
    border-color: var(--gold);
  }

  /* Три иконки темы: видна одна — по data-mode. По умолчанию (до скрипта)
     показываем «как на устройстве». */
  .theme-btn svg {
    grid-area: 1 / 1;
    display: none;
  }

  .theme-btn:not([data-mode]) .ico-auto,
  .theme-btn[data-mode='auto'] .ico-auto,
  .theme-btn[data-mode='light'] .ico-sun,
  .theme-btn[data-mode='dark'] .ico-moon {
    display: block;
  }

  /* ============================================================
     ТЕЛЕФОН И ПЛАНШЕТ: тёмная полоска сверху, меню во весь экран
     ============================================================ */
  @media (max-width: 1023px) {
    .sidebar {
      width: 100%;
      height: auto;
      padding: 0;
      border-right: 0;
      border-bottom: 1px solid var(--border-dark);
    }

    .sidebar-top {
      justify-content: space-between;
      height: var(--topbar-h);
      padding-inline: var(--gutter);
      /* Отступ под «чёлку» телефона в горизонтальном положении */
      padding-left: max(var(--gutter), env(safe-area-inset-left, 0px));
      padding-right: max(var(--gutter), env(safe-area-inset-right, 0px));
    }

    .brand {
      flex-direction: row;
      align-items: center;
      align-self: auto;
      gap: 0.8rem;
      text-align: left;
    }

    .brand-text {
      align-items: flex-start;
    }

    .brand :global(.logo) {
      width: 2.75rem;
    }

    .brand-text strong {
      font-size: 0.95rem;
    }

    .brand-text span {
      font-size: 0.6rem;
    }

    .bar-actions {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    .bar-wa {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      color: var(--gold);
    }

    .burger {
      position: relative;
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      align-content: center;
      gap: 6px;
    }

    .burger span {
      display: block;
      width: 24px;
      height: 1px;
      background: var(--c-ivory);
      transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
    }

    .burger[aria-expanded='true'] span:first-child {
      transform: translateY(3.5px) rotate(45deg);
    }

    .burger[aria-expanded='true'] span:last-child {
      transform: translateY(-3.5px) rotate(-45deg);
    }

    /* Меню — отдельный тёмный экран под полоской */
    .side-nav {
      position: fixed;
      top: var(--topbar-h);
      left: 0;
      right: 0;
