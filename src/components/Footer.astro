---
/**
 * Подвал — версия 2: тёмный графит, тонкие линии, антиква.
 * Тексты — shared.json (footer), ссылки и контакты — site.ts.
 */
import { Image } from 'astro:assets';
import { CONTACTS, FOOTER_NAV, COPYRIGHT, WHATSAPP } from '../data/site';
import logo from '../assets/img/logo-v2-light.png'; // см. Sidebar.astro: две версии
import { url } from '../data/url';
import { fillDeep } from '../data/fill';
import shared from '../data/pages/shared.json';

const s = fillDeep(shared.footer);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={url('/')} class="brand">
        <Image src={logo} alt="" width={64} densities={[1, 2, 3]} class="logo" loading="lazy" />
        <span class="brand-text">
          <strong>{shared.brand.top}</strong>
          <span>{shared.brand.sub}</span>
        </span>
      </a>
      <p class="footer-tagline">{s.tagline}</p>
      <div class="socials">
        <a href={WHATSAPP.general} target="_blank" rel="noopener" aria-label="WhatsApp" class="social">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.48-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.53.07-.8.38-.28.3-1.05 1.02-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.11 3.23 5.12 4.53.71.31 1.27.49 1.71.63.72.23 1.37.2 1.89.12.58-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 004.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm0 18.13h-.01a8.2 8.2 0 01-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 01-1.26-4.36c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 012.41 5.83c0 4.54-3.7 8.24-8.24 8.24z"
            />
          </svg>
        </a>
        <a href={CONTACTS.telegram} target="_blank" rel="noopener" aria-label="Telegram" class="social">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M21.94 4.6l-3.02 14.25c-.23 1-.83 1.25-1.67.78l-4.62-3.4-2.23 2.14c-.25.25-.45.45-.92.45l.33-4.68 8.52-7.7c.37-.33-.08-.51-.57-.18L7.23 12.9 2.67 11.5c-.99-.31-1-.99.21-1.47L20.67 3.2c.82-.3 1.54.2 1.27 1.4z"
            />
          </svg>
        </a>
        <a href={CONTACTS.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="social">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
            <circle cx="12" cy="12" r="4.2" />
            <circle cx="17.6" cy="6.4" r="1.2" fill="currentColor" stroke="none" />
          </svg>
        </a>
      </div>
    </div>

    <nav class="footer-nav" aria-label="Навигация в подвале">
      <h2>{s.sectionsTitle}</h2>
      <ul>
        {FOOTER_NAV.map((i) => <li><a href={url(i.href)}>{i.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-contacts">
      <h2>{s.contactsTitle}</h2>
      <a href={CONTACTS.phoneHref} class="contact-line big">{CONTACTS.phone}</a>
      <p class="messengers">{CONTACTS.messengers}</p>
      <a href={CONTACTS.emailHref} class="contact-line">{CONTACTS.email}</a>
      <p class="reply-note">{s.replyNote}</p>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>
      {COPYRIGHT}{' '}
      <a href={url('/privacy')} class="footer-service">{s.privacyLink}</a>
    </p>
    <p class="made">{s.made}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-graphite);
    color: #cfc8bc; /* на графите 10.74:1 */
    border-top: 1px solid var(--border-dark);
    font-size: var(--fs-sm);
    /* Всегда тёмный блок: кольцо фокуса золотое (7.96:1 на графите) */
    --focus-ring: var(--c-gold);
  }

  .footer-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    padding-block: clamp(3rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem);
  }

  @container page (min-width: 800px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1.2fr;
    }
  }

  /* --- имя --- */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
  }

  .brand :global(.logo) {
    width: 3.5rem;
    height: auto;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .brand-text strong {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.05rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-ivory);
  }

  .brand-text span {
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .footer-tagline {
    margin-top: var(--sp-5);
    max-width: min(40ch, 100%);
    line-height: 1.6;
  }

  .socials {
    display: flex;
    gap: var(--sp-2);
    margin-top: var(--sp-5);
  }

  .social {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    color: var(--gold);
    border: 1px solid var(--border-dark);
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .social:hover {
    border-color: var(--gold);
    background: var(--gold);
    color: var(--c-black);
  }

  /* --- колонки --- */
  .site-footer h2 {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    padding-bottom: var(--sp-3);
    margin-bottom: var(--sp-4);
    border-bottom: 1px solid var(--border-dark);
  }

  .footer-nav ul {
    display: grid;
    gap: 0.5rem;
  }

  .footer-nav a {
    color: #cfc8bc;
    transition: color var(--dur) var(--ease);
  }

  .footer-nav a:hover {
    color: var(--gold);
  }

  .contact-line {
    display: block;
    color: var(--c-ivory);
    transition: color var(--dur) var(--ease);
  }

  .contact-line:hover {
    color: var(--gold);
  }

  .contact-line.big {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .messengers {
    margin: 0.2rem 0 var(--sp-3);
    color: #a39a8c; /* 6.42:1 на графите */
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
  }

  .reply-note {
    margin-top: var(--sp-3);
    color: #a39a8c;
    font-size: var(--fs-xs);
    line-height: 1.55;
    max-width: min(36ch, 100%);
  }

  /* --- нижняя строка --- */
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-5);
    padding-block: var(--sp-5);
    border-top: 1px solid var(--border-dark);
    font-size: var(--fs-xs);
    color: #a39a8c;
  }

  .footer-service {
    color: var(--c-ivory);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgb(201 169 106 / 0.6);
    transition: color var(--dur) var(--ease);
  }

  .footer-service:hover {
    color: var(--gold);
  }
</style>
