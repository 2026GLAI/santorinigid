---
import { Image } from 'astro:assets';
import { CONTACTS, FOOTER_NAV, COPYRIGHT, WHATSAPP, ISLAND_YEARS_TEXT } from '../data/site';
import { url } from '../data/url';
import logo from '../assets/img/logo-dome.png';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={url('/')} class="brand">
        <Image
          src={logo}
          alt="Логотип: синий купол церкви Санторини"
          width={52}
          height={52}
          loading="lazy"
        />
        <span class="brand-text">
          <strong>Санторини</strong>
          <span>гид Владимир</span>
        </span>
      </a>
      {/*
        Выражение стоит В СЕРЕДИНЕ строки намеренно: перенос строки перед
        {…} Astro схлопывает в ничто, и на сайте выходило «острова.31 год»
        без пробела. Не разбивать эту строку.
      */}
      <p class="footer-tagline">
        Индивидуальные экскурсии, яхты, вертолёты и лучшие отели острова. {ISLAND_YEARS_TEXT} на
        Санторини — для вашего безупречного дня.
      </p>
      <div class="socials">
        <a href={WHATSAPP.general} target="_blank" rel="noopener" aria-label="WhatsApp" class="social">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 004.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm5.43 12.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.48-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.53.07-.8.38-.28.3-1.05 1.02-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.11 3.23 5.12 4.53.71.31 1.27.49 1.71.63.72.23 1.37.2 1.89.12.58-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35z"
            />
          </svg>
        </a>
        <a href={CONTACTS.telegram} target="_blank" rel="noopener" aria-label="Telegram" class="social">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M21.94 4.6l-3.02 14.25c-.23 1-.83 1.25-1.67.78l-4.62-3.4-2.23 2.14c-.25.25-.45.45-.92.45l.33-4.68 8.52-7.7c.37-.33-.08-.51-.57-.18L7.23 12.9 2.67 11.5c-.99-.31-1-.99.21-1.47L20.67 3.2c.82-.3 1.54.2 1.27 1.4z"
            />
          </svg>
        </a>
        <a href={CONTACTS.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="social">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
            <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" />
            <circle cx="12" cy="12" r="4.2" />
            <circle cx="17.6" cy="6.4" r="1.2" fill="currentColor" stroke="none" />
          </svg>
        </a>
      </div>
    </div>

    <nav class="footer-nav" aria-label="Навигация в подвале">
      <h2>Разделы</h2>
      <ul>
        {FOOTER_NAV.map((i) => <li><a href={url(i.href)}>{i.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-contacts">
      <h2>Контакты</h2>
      <a href={CONTACTS.phoneHref} class="contact-line big">{CONTACTS.phone}</a>
      <p class="messengers">{CONTACTS.messengers}</p>
      <a href={CONTACTS.emailHref} class="contact-line">{CONTACTS.email}</a>
      <p class="reply-note">Отвечаю в течение часа, на связи 24/7</p>
    </div>
  </div>

  <div class="container footer-bottom">
    {/* Пробел задан явно: перенос строки перед тегом Astro схлопывает,
        и в тексте страницы выходило «защищены.Политика» (глазу не видно
        из-за отступа margin, но при копировании текст слипался). */}
    <p>
      {COPYRIGHT}{' '}
      <a href={url('/privacy')} class="footer-service">Политика конфиденциальности</a>{' '}
      <a href={url('/admin')} class="footer-service">Вход для владельца</a>
    </p>
    <p class="made">
      Сайт работает на статических файлах — без подписок и платформ.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-top: clamp(3rem, 7vw, 5rem);
    background: var(--c-aegean-900);
    color: #dceaf3;
  }

  :global(:root[data-theme='dark']) .site-footer {
    background: #071722;
  }

  .footer-grid {
    display: grid;
    gap: var(--sp-7);
    grid-template-columns: 1fr;
    padding-bottom: var(--sp-7);
  }

  .footer-brand .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-4);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-text strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: #fff;
  }

  .brand-text span {
    font-size: 0.72rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #8fb4cc;
  }

  .footer-tagline {
    max-width: min(42ch, 100%);
    color: #a9c6da;
    font-size: var(--fs-sm);
  }

  .socials {
    display: flex;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
  }

  .social {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-full);
    background: rgb(255 255 255 / 0.08);
    color: #dceaf3;
    transition: background-color var(--dur) var(--ease), transform var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .social:hover {
    background: var(--c-aegean-400);
    color: #05202f;
    transform: translateY(-2px);
  }

  .site-footer h2 {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #7ea8c4;
    margin-bottom: var(--sp-4);
  }

  .footer-nav ul {
    display: grid;
    gap: var(--sp-2);
  }

  .footer-nav a {
    color: #c6dbe9;
    font-size: var(--fs-sm);
    transition: color var(--dur) var(--ease), padding-left var(--dur) var(--ease);
  }

  .footer-nav a:hover {
    color: #fff;
    padding-left: 5px;
  }

  .contact-line {
    display: block;
    color: #dceaf3;
    transition: color var(--dur) var(--ease);
  }

  .contact-line:hover {
    color: var(--c-aegean-200);
  }

  .contact-line.big {
    font-size: var(--fs-lg);
    font-weight: 600;
    margin-bottom: var(--sp-1);
  }

  .messengers {
    font-size: var(--fs-xs);
    color: #7ea8c4;
    margin-bottom: var(--sp-4);
  }

  .reply-note {
    margin-top: var(--sp-4);
    font-size: var(--fs-xs);
    color: #7ea8c4;
    max-width: min(30ch, 100%);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    justify-content: space-between;
    /* Нижний отступ учитывает «безопасную зону»: в viewport стоит
       viewport-fit=cover, поэтому страница доходит до самого края
       экрана, и без этой добавки последняя строка подвала (ссылка
       на политику конфиденциальности) уходила бы под жестовую
       панель Android и полоску-домой iPhone. */
    padding-block: var(--sp-5) calc(var(--sp-5) + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: var(--fs-xs);
    color: #7ea8c4;
  }

  /* Контраст 11.21 на тёмном фоне подвала — проверено расчётом */
  .footer-privacy {
    margin-left: var(--sp-3);
    color: #dceaf3;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-privacy:hover {
    color: #fff;
  }

  @media (min-width: 760px) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr 1.1fr;
    }
  }
</style>
