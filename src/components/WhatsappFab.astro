---
import { WHATSAPP } from '../data/site';
---

<a
  href={WHATSAPP.general}
  class="wa-fab"
  target="_blank"
  rel="noopener"
  aria-label="Написать в WhatsApp"
>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.86 9.86 0 004.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm5.43 12.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.48-1.75-1.65-2.05-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.53.07-.8.38-.28.3-1.05 1.02-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.11 3.23 5.12 4.53.71.31 1.27.49 1.71.63.72.23 1.37.2 1.89.12.58-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35z"
    />
  </svg>
  <span class="wa-tip">Написать в WhatsApp</span>
</a>

<style>
  /*
    Кнопка стоит СЛЕВА внизу — намеренно.

    Раньше была справа и спорила с кнопкой чата: на телефоне они налезали
    друг на друга, и чат приходилось прятать. Теперь у каждой свой угол,
    прятать никого не нужно, обе видны всегда.
  */
  .wa-fab {
    position: fixed;
    /* max(наш отступ, системный) — обходим полоску-домой и скруглённые
       углы телефона. На обычном экране системный равен нулю.
       Та же мысль в ChatWidget.astro и ScrollTop.astro. */
    left: max(clamp(1rem, 3vw, 1.75rem), env(safe-area-inset-left, 0px));
    bottom: max(clamp(1rem, 3vw, 1.75rem), env(safe-area-inset-bottom, 0px));
    z-index: 90;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: var(--radius-full);
    background: #25d366;
    color: #06301a;
    box-shadow: 0 6px 20px rgb(37 211 102 / 0.4);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease),
      opacity var(--dur) var(--ease), visibility var(--dur);
  }

  .wa-fab:hover {
    transform: scale(1.06);
    box-shadow: 0 10px 30px rgb(37 211 102 / 0.55);
  }

  /* Подсказка выезжает ВПРАВО: кнопка теперь у левого края,
     и влево тексту просто некуда деться — он ушёл бы за экран. */
  .wa-tip {
    position: absolute;
    left: calc(100% + 12px);
    white-space: nowrap;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-full);
    background: var(--c-ink);
    color: #fff;
    font-size: 0.82rem;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-6px);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .wa-fab:hover .wa-tip,
  .wa-fab:focus-visible .wa-tip {
    opacity: 1;
    transform: none;
  }

  /* Пульсирующее кольцо — мягко привлекает внимание */
  .wa-fab::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 2px solid #25d366;
    animation: pulse 2.6s var(--ease) infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    70% {
      transform: scale(1.5);
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  /*
    Щадящий режим — движение убираем, но кнопку не «гасим».
    Раньше стояло animation: none, и у тех, у кого в системе выключена
    анимация (как у владельца в Windows), кольцо исчезало совсем.
    Теперь оно спокойно мерцает на месте: взгляд не дёргает,
    но видно, что кнопка живая.
  */
  @media (prefers-reduced-motion: reduce) {
    .wa-fab::after {
      animation: waGlow 3s ease-in-out infinite;
    }
  }

  @keyframes waGlow {
    0%,
    100% {
      opacity: 0.25;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1);
    }
  }

  @media (max-width: 560px) {
    /* Подсказка на телефоне не нужна: наводить нечем, а место занимает */
    .wa-tip {
      display: none;
    }
    .wa-fab {
      width: 54px;
      height: 54px;
      /* Отступ «уступаем место кнопке чата» убран: кнопки теперь
         в разных углах и друг другу не мешают. */
    }
  }
</style>
