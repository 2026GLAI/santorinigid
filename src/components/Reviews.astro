---
/**
 * Блок отзывов.
 *
 * Принципы (важно не сломать при доработках):
 *  1. ВСЕ отзывы попадают в готовый HTML при сборке. Никакой подгрузки
 *     скриптом — то, что грузится через JS, поисковики и ИИ часто не видят.
 *     Именно из-за этого мы не смогли прочитать отзывы Владимира на NeedGuide.
 *  2. «Показать ещё» сделано на CSS (чекбокс), а не на JS: скрытые отзывы
 *     физически присутствуют в HTML и индексируются.
 *  3. Оценок в звёздах нет — их нет и в источнике. См. src/data/reviews.ts.
 */
import ReviewCard from './ReviewCard.astro';
import { REVIEWS, REVIEW_SOURCES, REVIEWS_VISIBLE } from '../data/reviews';
import { url } from '../data/url';
import shared from '../data/pages/shared.json';

/* Тексты блока — в shared.json (правит владелец через /admin). */
const s = shared.reviewsBlock;

interface Props {
  title?: string;
  eyebrow?: string;
  lede?: string;
  alt?: boolean;
  /** Сколько показать сразу. Остальные — под кнопкой «Показать ещё». */
  visible?: number;
  /**
   * Сколько отзывов вообще класть на страницу. Полный список — только на
   * /reviews/; на главной, «Обо мне» и экскурсии — первые `limit` и ссылка
   * «Все отзывы» (иначе один и тот же текст дублируется на четырёх страницах,
   * и страница отзывов теряет уникальность для поисковиков).
   */
  limit?: number;
  /** Показывать ли форму «оставить отзыв». */
  showForm?: boolean;
}

const {
  title = s.title,
  eyebrow = s.eyebrow,
  lede = s.lede,
  alt = false,
  visible = REVIEWS_VISIBLE,
  limit,
  showForm = true,
} = Astro.props;

const pool = limit ? REVIEWS.slice(0, limit) : REVIEWS;
const shown = pool.slice(0, visible);
const hidden = pool.slice(visible);
const more = limit ? REVIEWS.length > limit : false;

/**
 * Показатели под заголовком.
 *
 * ВАЖНО: здесь могут стоять ТОЛЬКО те числа, которые можно пересчитать по
 * данным. Лозунги вроде «100% реальные люди» рядом с настоящими цифрами
 * выглядят как цифра и занимают чужое место — такого здесь быть не должно.
 */
/*
  Плашки «2014–2026 годы отзывов» здесь БЫЛО и убрано 06.08.2026 по слову
  владельца: большой диапазон лет при скромном числе отзывов подчёркивал,
  что их мало (отзывы годами копились у площадок-партнёров, не у него).
  Даты честно стоят у каждого отзыва — сводную плашку не возвращать.
*/
/*
  Счётчики «22 отзыва / 6 с ответом» и числа у площадок убраны 19.08.2026
  по слову владельца («лишняя информация»). Площадки перечисляем только те,
  с которых отзывы действительно есть.
*/
const bySource = REVIEW_SOURCES.filter((src) => REVIEWS.some((r) => r.source === src.name));
---

<section class:list={['section', { 'section-alt': alt }]} id="reviews">
  <div class="container">
    <header class="rv-head reveal">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="section-title">{title}</h2>
      {lede && <p class="lede">{lede}</p>}

      {/*
        Пробелы вокруг перечисления площадок заданы явно ({' '}): перенос
        строки перед {…} Astro схлопывает, и на сайте выходило
        «площадкахTourister.ru» и «(7)— у каждого» без пробелов.
      */}
      <p class="rv-source">
        {s.sourcePrefix}{' '}
        {
          bySource.map((src, i) => (
            <>
              {i > 0 && ' и '}
              <a href={src.url} target="_blank" rel="noopener nofollow">
                {src.name}
              </a>
            </>
          ))
        }
        {' '}{s.sourceSuffix}
      </p>
    </header>

    <ol class="rv-list">
      {shown.map((r) => <ReviewCard review={r} reveal />)}
    </ol>

    {
      more && (
        <div class="rv-more-wrap">
          <a href={url('/reviews')} class="btn btn-ghost rv-more-btn">
            {s.allLink}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>
      )
    }

    {
      hidden.length > 0 && (
        <div class="rv-more-wrap">
          {/*
            Скрытые отзывы физически лежат в HTML — их видят поисковики и ИИ.
            Разворачивание на чекбоксе, без единой строчки скрипта.
          */}
          <input type="checkbox" id="rv-toggle" class="rv-toggle" />

          <ol class="rv-list rv-hidden-list">
            {hidden.map((r) => <ReviewCard review={r} />)}
          </ol>

          {/* Ярлык одет в общие классы кнопок (.btn .btn-ghost) — до
              06.08.2026 он описывал те же стили заново у себя. Заодно
              теперь его ловит глобальная страховка размера нажатия
              для сенсорных экранов (@media pointer: coarse). */}
          <label for="rv-toggle" class="btn btn-ghost rv-more-btn">
            <span class="rv-more-open">{s.expand}</span>
            <span class="rv-more-close">{s.collapse}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </label>
        </div>
      )
    }

    {
      showForm && (
        <div class="rv-cta reveal">
          <h3>{s.cta.title}</h3>
          <p>{s.cta.text}</p>
          <div class="rv-cta-actions">
            {/* Отзыв — только через форму на сайте (решение владельца 19.08.2026:
                кнопка «на Tourister» убрана). Форма живёт на /reviews —
                на остальных страницах якорь сам по себе вёл бы в никуда. */}
            <a href={url('/reviews#review-form')} class="btn btn-primary">
              {s.cta.buttonDirect}
            </a>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .rv-head {
    max-width: min(64ch, 100%);
    margin-bottom: var(--sp-7);
  }

  .rv-source {
    margin-top: var(--sp-4);
    max-width: min(68ch, 100%);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.7;
  }

  .rv-source a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /*
    Кладка (masonry) на колонках.

    Почему так, а не сетка одинаковых карточек: отзывы очень разной длины —
    от 121 до 2250 символов. В сетке короткий отзыв превратился бы в пустую
    коробку, а длинный пришлось бы обрезать. В кладке разная высота работает
    на нас: страница выглядит как живая гостевая книга, а не как шаблон.
  */
  .rv-list {
    /*
      Кладка на колонках. width: 100% обязателен: без него на узких
      экранах колонка вычислялась по содержимому и уезжала за край —
      один отзыв получал ширину 7000+ пикселей.
    */
    width: 100%;
    max-width: 100%;
    columns: 1;
    column-gap: clamp(1rem, 2vw, 1.75rem);
  }

  .rv-list > :global(.rv-item) {
    /* Карточку нельзя разрывать между колонками */
    break-inside: avoid;
    page-break-inside: avoid;
    margin-bottom: clamp(1rem, 2vw, 1.75rem);
    /* Ширина строго по колонке, иначе длинный текст растягивает вёрстку */
    width: 100%;
    max-width: 100%;
  }

  @container page (min-width: 700px) {
    .rv-list {
      columns: 2;
    }
  }

  @container page (min-width: 1200px) {
    .rv-list {
      columns: 3;
    }
  }

  /* На сверхшироких мониторах — четыре колонки, иначе карточки
     растягиваются в неудобные для чтения полосы */
  @container page (min-width: 1900px) {
    .rv-list {
      columns: 4;
    }
  }

  /*
    «Показать ещё» — один механизм, без скриптов.
    Свёрнутый список ограничен по высоте и притушён снизу градиентом;
    текст при этом остаётся в потоке и доступен поисковикам.
  */
  .rv-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .rv-more-wrap {
    position: relative;
  }

  /*
    Свёрнутая часть списка.

    Здесь НЕ используем max-height и колонки одновременно: при нулевой
    высоте браузер не может рассчитать колонки и раскладывает карточки
    в строку шириной в десятки тысяч пикселей. Проверено — ломается.

    Решение простое и надёжное: в свёрнутом виде блок просто не
    отображается (display: none). Текст при этом остаётся в HTML —
    поисковики и ИИ его видят, а это главное. Анимации раскрытия нет,
    зато вёрстка не может сломаться ни на одном экране.
  */
  .rv-hidden-list {
    display: none;
  }

  .rv-toggle:checked ~ .rv-hidden-list {
    display: block;
    margin-top: clamp(1rem, 2vw, 1.75rem);
    animation: rvReveal 380ms var(--ease) both;
  }

  @keyframes rvReveal {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rv-toggle:checked ~ .rv-hidden-list {
      animation: none;
    }
  }

  /* Внешний вид — из общих .btn .btn-ghost; здесь только то, чего
     у обычной кнопки нет: отступ сверху и курсор (это <label>). */
  .rv-more-btn {
    margin-top: var(--sp-6);
    cursor: pointer;
  }

  .rv-more-btn svg {
    transition: transform var(--dur) var(--ease);
  }

  .rv-more-close {
    display: none;
  }

  .rv-toggle:checked ~ .rv-more-btn .rv-more-open {
    display: none;
  }

  .rv-toggle:checked ~ .rv-more-btn .rv-more-close {
    display: inline;
  }

  .rv-toggle:checked ~ .rv-more-btn svg {
    transform: rotate(180deg);
  }

  .rv-toggle:focus-visible ~ .rv-more-btn {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  /* --- призыв оставить отзыв --- */
  .rv-cta {
    margin-top: var(--sp-8);
    /* Нижняя граница 1rem: на 320px заголовок «…САНТОРИНИ?» капителью
       иначе не помещался на 1px и ломался посреди слова */
    padding: clamp(1rem, 5vw, 3rem);
    text-align: center;
    background:
      radial-gradient(
        120% 140% at 50% 0%,
        color-mix(in srgb, var(--accent) 12%, transparent),
        transparent 60%
      ),
      var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .rv-cta h3 {
    font-size: var(--fs-2xl);
  }

  .rv-cta p {
    max-width: min(56ch, 100%);
    margin: var(--sp-3) auto 0;
    color: var(--text-soft);
    font-size: var(--fs-sm);
  }

  .rv-cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
  }
</style>
