---
/**
 * Блок отзывов.
 *
 * Принципы (важно не сломать при доработках):
 *  1. ВСЕ отзывы попадают в готовый HTML при сборке. Никакой подгрузки
 *     скриптом — то, что грузится через JS, поисковики и ИИ часто не видят.
 *     Именно из-за этого мы не смогли прочитать отзывы Владимира на NeedGuide.
 *  2. «Показать ещё» сделано на CSS (чекбокс), а не на JS: скрытые отзывы
 *     физически присутствуют в HTML и индексируются.
 *  3. Оценок в звёздах нет — их нет и в источнике. См. src/data/reviews.ts.
 */
import { REVIEWS, REVIEWS_SOURCE, REVIEWS_VISIBLE } from '../data/reviews';

interface Props {
  title?: string;
  eyebrow?: string;
  lede?: string;
  alt?: boolean;
  /** Сколько показать сразу. Остальные — под кнопкой «Показать ещё». */
  visible?: number;
  /** Показывать ли форму «оставить отзыв». */
  showForm?: boolean;
}

const {
  title = 'Отзывы моих гостей',
  eyebrow = 'Отзывы',
  lede = 'Для меня каждая экскурсия — это не просто маршрут, а новая история. Я благодарен моим гостям за доверие и те улыбки, которые делают мою работу лучшей в мире!',
  alt = false,
  visible = REVIEWS_VISIBLE,
  showForm = true,
} = Astro.props;

const shown = REVIEWS.slice(0, visible);
const hidden = REVIEWS.slice(visible);

/** Первые буквы имени для аватарки-заглушки (фото авторов у нас нет). */
const initials = (name: string) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase() ?? '')
    .join('');

/** Годы, за которые есть отзывы — честный показатель «нас читают давно». */
const years = [...new Set(REVIEWS.map((r) => r.datePublished.slice(0, 4)))].sort();
const yearsSpan = years.length > 1 ? `${years[0]}–${years[years.length - 1]}` : years[0];
---

<section class:list={['section', { 'section-alt': alt }]} id="reviews">
  <div class="container">
    <header class="rv-head reveal">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="section-title">{title}</h2>
      {lede && <p class="lede">{lede}</p>}

      <div class="rv-stats">
        <div class="rv-stat">
          <strong>{REVIEWS.length}</strong>
          <span>отзывов</span>
        </div>
        <div class="rv-stat">
          <strong>{yearsSpan}</strong>
          <span>годы поездок</span>
        </div>
        <div class="rv-stat">
          <strong>100%</strong>
          <span>реальные люди</span>
        </div>
      </div>

      <p class="rv-source">
        Все отзывы оставлены на площадке
        <a href={REVIEWS_SOURCE.profileUrl} target="_blank" rel="noopener nofollow">
          {REVIEWS_SOURCE.name}
        </a>
        — у каждого есть ссылка на оригинал, вы можете проверить любой.
      </p>
    </header>

    <ol class="rv-list">
      {
        shown.map((r) => (
          <li class="rv-item reveal" id={`review-${r.id}`}>
            <article class="rv-card">
              <header class="rv-card-head">
                <span class="rv-avatar" aria-hidden="true">
                  {initials(r.author)}
                </span>
                <span class="rv-who">
                  <strong>{r.author}</strong>
                  {r.tripDate && (
                    <span class="rv-trip">
                      Поездка: {r.tripDate}
                      {r.tripWith && ` · ${r.tripWith}`}
                    </span>
                  )}
                </span>
              </header>

              <blockquote class="rv-text">
                <p>{r.text}</p>
              </blockquote>

              <footer class="rv-card-foot">
                <time datetime={r.datePublished}>Опубликован {r.published}</time>
                <a href={r.sourceUrl} target="_blank" rel="noopener nofollow" class="rv-src">
                  Оригинал на {REVIEWS_SOURCE.name} ↗
                </a>
              </footer>
            </article>
          </li>
        ))
      }
    </ol>

    {
      hidden.length > 0 && (
        <div class="rv-more-wrap">
          {/* Чекбокс + CSS — отзывы уже в HTML, скрипт не нужен */}
          <input type="checkbox" id="rv-toggle" class="rv-toggle" />

          <ol class="rv-list rv-hidden-list">
            {hidden.map((r) => (
              <li class="rv-item" id={`review-${r.id}`}>
                <article class="rv-card">
                  <header class="rv-card-head">
                    <span class="rv-avatar" aria-hidden="true">
                      {initials(r.author)}
                    </span>
                    <span class="rv-who">
                      <strong>{r.author}</strong>
                      {r.tripDate && (
                        <span class="rv-trip">
                          Поездка: {r.tripDate}
                          {r.tripWith && ` · ${r.tripWith}`}
                        </span>
                      )}
                    </span>
                  </header>

                  <blockquote class="rv-text">
                    <p>{r.text}</p>
                  </blockquote>

                  <footer class="rv-card-foot">
                    <time datetime={r.datePublished}>Опубликован {r.published}</time>
                    <a href={r.sourceUrl} target="_blank" rel="noopener nofollow" class="rv-src">
                      Оригинал на {REVIEWS_SOURCE.name} ↗
                    </a>
                  </footer>
                </article>
              </li>
            ))}
          </ol>

          <label for="rv-toggle" class="btn btn-ghost rv-more-btn">
            <span class="rv-more-open">Показать все отзывы ({REVIEWS.length})</span>
            <span class="rv-more-close">Свернуть отзывы</span>
          </label>
        </div>
      )
    }

    {
      showForm && (
        <div class="rv-cta reveal">
          <h3>Были со мной на Санторини?</h3>
          <p>
            Буду очень признателен за пару строк — они помогают другим
            путешественникам решиться. Отзыв можно оставить на площадке, где я
            работаю много лет, или написать мне напрямую.
          </p>
          <div class="rv-cta-actions">
            <a
              href="https://www.tourister.ru/add_response_for_expert/Vladimir_Santorini"
              class="btn btn-primary"
              target="_blank"
              rel="noopener"
            >
              Оставить отзыв на Tourister
            </a>
            <a href="#review-form" class="btn btn-ghost">
              Написать отзыв мне
            </a>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .rv-head {
    max-width: 64ch;
    margin-bottom: var(--sp-7);
  }

  .rv-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-6);
    margin-top: var(--sp-5);
    padding-block: var(--sp-4);
    border-block: 1px solid var(--border);
  }

  .rv-stat {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .rv-stat strong {
    font-family: var(--font-display);
    font-size: 1.7rem;
    color: var(--accent);
  }

  .rv-stat span {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    margin-top: 3px;
  }

  .rv-source {
    margin-top: var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .rv-source a {
    color: var(--accent);
    text-decoration: underline;
  }

  /* --- список --- */
  .rv-list {
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    align-items: start;
  }

  .rv-card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    height: 100%;
    padding: var(--sp-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .rv-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .rv-card-head {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .rv-avatar {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--c-aegean-400), var(--c-aegean-800));
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }

  .rv-who {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    min-width: 0;
  }

  .rv-who strong {
    font-size: var(--fs-base);
  }

  .rv-trip {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .rv-text {
    flex: 1;
    position: relative;
    padding-left: var(--sp-4);
    border-left: 3px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .rv-text p {
    font-size: var(--fs-sm);
    line-height: 1.75;
    color: var(--text-soft);
  }

  .rv-card-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    justify-content: space-between;
    align-items: baseline;
    padding-top: var(--sp-3);
    border-top: 1px solid var(--border);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .rv-src {
    color: var(--accent);
    font-weight: 600;
    white-space: nowrap;
  }

  .rv-src:hover {
    text-decoration: underline;
  }

  /* --- «показать ещё» на чистом CSS --- */
  .rv-toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .rv-hidden-list {
    /* Отзывы ЕСТЬ в HTML — просто визуально свёрнуты.
       grid-template-rows: 0fr даёт плавное раскрытие без скриптов. */
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 420ms var(--ease), margin-top 420ms var(--ease);
    margin-top: 0;
  }

  .rv-hidden-list > * {
    overflow: hidden;
    min-height: 0;
  }

  .rv-toggle:checked ~ .rv-hidden-list {
    grid-template-rows: 1fr;
    margin-top: var(--sp-4);
  }

  /* Внутри раскрывающегося контейнера возвращаем сетку карточек */
  .rv-toggle:checked ~ .rv-hidden-list {
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    grid-template-rows: none;
  }

  .rv-hidden-list .rv-item {
    display: none;
  }

  .rv-toggle:checked ~ .rv-hidden-list .rv-item {
    display: block;
    animation: rvIn 380ms var(--ease) both;
  }

  @keyframes rvIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rv-toggle:checked ~ .rv-hidden-list .rv-item {
      animation: none;
    }
  }

  .rv-more-wrap {
    margin-top: var(--sp-4);
  }

  .rv-more-btn {
    display: inline-flex;
    margin-top: var(--sp-5);
    cursor: pointer;
  }

  .rv-more-close {
    display: none;
  }

  .rv-toggle:checked ~ .rv-more-btn .rv-more-open {
    display: none;
  }

  .rv-toggle:checked ~ .rv-more-btn .rv-more-close {
    display: inline;
  }

  .rv-toggle:focus-visible ~ .rv-more-btn {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  /* --- призыв оставить отзыв --- */
  .rv-cta {
    margin-top: var(--sp-8);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    text-align: center;
    background:
      radial-gradient(120% 140% at 50% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 60%),
      var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .rv-cta h3 {
    font-size: var(--fs-xl);
  }

  .rv-cta p {
    max-width: 56ch;
    margin: var(--sp-3) auto 0;
    color: var(--text-soft);
    font-size: var(--fs-sm);
  }

  .rv-cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
  }
</style>
