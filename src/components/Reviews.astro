---
import { Image } from 'astro:assets';
import { REVIEWS } from '../data/tours';
import { getImg } from '../data/images';

interface Props {
  title?: string;
  eyebrow?: string;
  lede?: string;
  alt?: boolean;
}

const {
  title = 'Отзывы и счастливые моменты моих гостей',
  eyebrow = 'Отзывы',
  lede = 'Для меня каждая экскурсия — это не просто маршрут, а новая история. Я благодарен моим гостям за доверие и те улыбки, которые делают мою работу лучшей в мире!',
  alt = false,
} = Astro.props;
---

<section class:list={['section', { 'section-alt': alt }]} id="reviews">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="section-title">{title}</h2>
      {lede && <p class="lede">{lede}</p>}
    </header>

    <div class="reviews">
      {
        REVIEWS.map((r) => (
          <figure class="card review reveal">
            <div class="review-body">
              <svg class="quote" width="30" height="24" viewBox="0 0 30 24" fill="currentColor" aria-hidden="true">
                <path d="M0 24V13.6C0 9.9.9 6.8 2.6 4.3 4.4 1.8 7 .3 10.4 0l.9 3.6c-2 .5-3.5 1.4-4.4 2.7-.9 1.3-1.3 2.9-1.2 4.8H12V24H0zm18 0V13.6c0-3.7.9-6.8 2.6-9.3C22.4 1.8 25 .3 28.4 0l.9 3.6c-2 .5-3.5 1.4-4.4 2.7-.9 1.3-1.3 2.9-1.2 4.8H30V24H18z" />
              </svg>

              <blockquote>{r.text}</blockquote>

              {r.truncated && (
                <p class="truncated-note">
                  Отзыв опубликован на площадке NeedGuide в сокращении.
                </p>
              )}

              <figcaption>
                <Image
                  src={getImg(r.photo)}
                  alt={`${r.author} — гость Владимира на Санторини`}
                  widths={[56, 112]}
                  sizes="56px"
                  quality={82}
                  class="review-photo"
                />
                <span class="review-meta">
                  <strong>{r.author}</strong>
                  <span>{r.date}</span>
                </span>
              </figcaption>
            </div>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section-head {
    max-width: 62ch;
    margin-bottom: var(--sp-7);
  }

  .reviews {
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: repeat(auto-fit, minmax(min(310px, 100%), 1fr));
  }

  .review-body {
    padding: var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    height: 100%;
  }

  .quote {
    color: var(--accent);
    opacity: 0.28;
  }

  .review blockquote {
    font-size: var(--fs-sm);
    color: var(--text-soft);
    line-height: 1.75;
  }

  .truncated-note {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-style: italic;
  }

  .review figcaption {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-top: auto;
    padding-top: var(--sp-4);
    border-top: 1px solid var(--border);
  }

  .review-photo {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-full);
    object-fit: cover;
    flex-shrink: 0;
  }

  .review-meta {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .review-meta strong {
    font-size: var(--fs-sm);
  }

  .review-meta > span {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
</style>
