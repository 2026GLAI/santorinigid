---
/**
 * Блок отзывов.
 *
 * Принципы (важно не сломать при доработках):
 *  1. ВСЕ отзывы попадают в готовый HTML при сборке. Никакой подгрузки
 *     скриптом — то, что грузится через JS, поисковики и ИИ часто не видят.
 *     Именно из-за этого мы не смогли прочитать отзывы Владимира на NeedGuide.
 *  2. «Показать ещё» сделано на CSS (чекбокс), а не на JS: скрытые отзывы
 *     физически присутствуют в HTML и индексируются.
 *  3. Оценок в звёздах нет — их нет и в источнике. См. src/data/reviews.ts.
 */
import ReviewCard from './ReviewCard.astro';
import { REVIEWS, REVIEW_SOURCES, REVIEWS_VISIBLE, LEAVE_REVIEW_URL, REVIEW_YEARS } from '../data/reviews';
import { plural } from '../data/site';
import { url } from '../data/url';

interface Props {
  title?: string;
  eyebrow?: string;
  lede?: string;
  alt?: boolean;
  /** Сколько показать сразу. Остальные — под кнопкой «Показать ещё». */
  visible?: number;
  /** Показывать ли форму «оставить отзыв». */
  showForm?: boolean;
}

const {
  title = 'Отзывы моих гостей',
  eyebrow = 'Отзывы',
  lede = 'Для меня каждая экскурсия — это не просто маршрут, а новая история. Я благодарен моим гостям за доверие и те улыбки, которые делают мою работу лучшей в мире!',
  alt = false,
  visible = REVIEWS_VISIBLE,
  showForm = true,
} = Astro.props;

const shown = REVIEWS.slice(0, visible);
const hidden = REVIEWS.slice(visible);

/**
 * Показатели под заголовком.
 *
 * ВАЖНО: здесь могут стоять ТОЛЬКО те числа, которые можно пересчитать по
 * данным. Лозунги вроде «100% реальные люди» рядом с настоящими цифрами
 * выглядят как цифра и занимают чужое место — такого здесь быть не должно.
 */
const stats = [
  { n: String(REVIEWS.length), label: 'отзывов гостей' },
  { n: `${REVIEW_YEARS.from}–${REVIEW_YEARS.to}`, label: 'годы отзывов' },
  {
    n: String(REVIEWS.filter((r) => r.reply).length),
    label: 'с моим ответом',
  },
];

/** Сколько отзывов с какой площадки — показываем открыто. */
const bySource = REVIEW_SOURCES.map((s) => ({
  ...s,
  count: REVIEWS.filter((r) => r.source === s.name).length,
})).filter((s) => s.count > 0);
---

<section class:list={['section', { 'section-alt': alt }]} id="reviews">
  <div class="container">
    <header class="rv-head reveal">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="section-title">{title}</h2>
      {lede && <p class="lede">{lede}</p>}

      <dl class="rv-stats">
        {
          stats.map((s) => (
            <div class="rv-stat">
              <dt>{s.n}</dt>
              <dd>{s.label}</dd>
            </div>
          ))
        }
      </dl>

      {/*
        Пробелы вокруг перечисления площадок заданы явно ({' '}): перенос
        строки перед {…} Astro схлопывает, и на сайте выходило
        «площадкахTourister.ru» и «(7)— у каждого» без пробелов.
      */}
      <p class="rv-source">
        Отзывы оставлены на площадках{' '}
        {
          bySource.map((s, i) => (
            <>
              {i > 0 && ' и '}
              <a href={s.url} target="_blank" rel="noopener nofollow">
                {s.name}
              </a>
              {' '}({s.count})
            </>
          ))
        }
        {' '}— у каждого есть прямая ссылка на оригинал, вы можете проверить любой.
        Оценок в звёздах эти площадки не используют, поэтому их здесь нет.
      </p>
    </header>

    <ol class="rv-list">
      {shown.map((r) => <ReviewCard review={r} reveal />)}
    </ol>

    {
      hidden.length > 0 && (
        <div class="rv-more-wrap">
          {/*
            Скрытые отзывы физически лежат в HTML — их видят поисковики и ИИ.
            Разворачивание на чекбоксе, без единой строчки скрипта.
          */}
          <input type="checkbox" id="rv-toggle" class="rv-toggle" />

          <ol class="rv-list rv-hidden-list">
            {hidden.map((r) => <ReviewCard review={r} />)}
          </ol>

          <label for="rv-toggle" class="rv-more-btn">
            <span class="rv-more-open">
              Ещё {hidden.length} {plural(hidden.length, 'отзыв', 'отзыва', 'отзывов')}
            </span>
            <span class="rv-more-close">Свернуть</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </label>
        </div>
      )
    }

    {
      showForm && (
        <div class="rv-cta reveal">
          <h3>Были со мной на Санторини?</h3>
          <p>
            Буду очень признателен за пару строк — они помогают другим
            путешественникам решиться. Отзыв можно оставить на площадке, где я
            работаю много лет, или написать мне напрямую.
          </p>
          <div class="rv-cta-actions">
            <a
              href={LEAVE_REVIEW_URL}
              class="btn btn-primary"
              target="_blank"
              rel="noopener"
            >
              Оставить отзыв на Tourister
            </a>
            {/* Форма живёт только на /reviews — на остальных страницах
                якорь #review-form сам по себе вёл бы в никуда. */}
            <a href={url('/reviews#review-form')} class="btn btn-ghost">
              Написать отзыв мне
            </a>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .rv-head {
    max-width: min(64ch, 100%);
    margin-bottom: var(--sp-7);
  }

  /* Показатели: разделены тонкими линиями, цифра — акцентным шрифтом. */
  .rv-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-5) var(--sp-7);
    margin-top: var(--sp-5);
    padding-block: var(--sp-5);
    border-block: 1px solid var(--border);
  }

  .rv-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1.1;
  }

  .rv-stat dt {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.1vw, 2rem);
    font-weight: 600;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .rv-stat dd {
    font-size: var(--fs-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .rv-source {
    margin-top: var(--sp-4);
    max-width: min(68ch, 100%);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.7;
  }

  .rv-source a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /*
    Кладка (masonry) на колонках.

    Почему так, а не сетка одинаковых карточек: отзывы очень разной длины —
    от 121 до 2250 символов. В сетке короткий отзыв превратился бы в пустую
    коробку, а длинный пришлось бы обрезать. В кладке разная высота работает
    на нас: страница выглядит как живая гостевая книга, а не как шаблон.
  */
  .rv-list {
    /*
      Кладка на колонках. width: 100% обязателен: без него на узких
      экранах колонка вычислялась по содержимому и уезжала за край —
      один отзыв получал ширину 7000+ пикселей.
    */
    width: 100%;
    max-width: 100%;
    columns: 1;
    column-gap: clamp(1rem, 2vw, 1.75rem);
  }

  .rv-list > :global(.rv-item) {
    /* Карточку нельзя разрывать между колонками */
    break-inside: avoid;
    page-break-inside: avoid;
    margin-bottom: clamp(1rem, 2vw, 1.75rem);
    /* Ширина строго по колонке, иначе длинный текст растягивает вёрстку */
    width: 100%;
    max-width: 100%;
  }

  @media (min-width: 700px) {
    .rv-list {
      columns: 2;
    }
  }

  @media (min-width: 1200px) {
    .rv-list {
      columns: 3;
    }
  }

  /* На сверхшироких мониторах — четыре колонки, иначе карточки
     растягиваются в неудобные для чтения полосы */
  @media (min-width: 1900px) {
    .rv-list {
      columns: 4;
    }
  }

  /*
    «Показать ещё» — один механизм, без скриптов.
    Свёрнутый список ограничен по высоте и притушён снизу градиентом;
    текст при этом остаётся в потоке и доступен поисковикам.
  */
  .rv-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .rv-more-wrap {
    position: relative;
  }

  /*
    Свёрнутая часть списка.

    Здесь НЕ используем max-height и колонки одновременно: при нулевой
    высоте браузер не может рассчитать колонки и раскладывает карточки
    в строку шириной в десятки тысяч пикселей. Проверено — ломается.

    Решение простое и надёжное: в свёрнутом виде блок просто не
    отображается (display: none). Текст при этом остаётся в HTML —
    поисковики и ИИ его видят, а это главное. Анимации раскрытия нет,
    зато вёрстка не может сломаться ни на одном экране.
  */
  .rv-hidden-list {
    display: none;
  }

  .rv-toggle:checked ~ .rv-hidden-list {
    display: block;
    margin-top: clamp(1rem, 2vw, 1.75rem);
    animation: rvReveal 380ms var(--ease) both;
  }

  @keyframes rvReveal {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rv-toggle:checked ~ .rv-hidden-list {
      animation: none;
    }
  }

  .rv-more-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-6);
    padding: 0.8em 1.7em;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--surface);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--text);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .rv-more-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  .rv-more-btn svg {
    transition: transform var(--dur) var(--ease);
  }

  .rv-more-close {
    display: none;
  }

  .rv-toggle:checked ~ .rv-more-btn .rv-more-open {
    display: none;
  }

  .rv-toggle:checked ~ .rv-more-btn .rv-more-close {
    display: inline;
  }

  .rv-toggle:checked ~ .rv-more-btn svg {
    transform: rotate(180deg);
  }

  .rv-toggle:focus-visible ~ .rv-more-btn {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  /* --- призыв оставить отзыв --- */
  .rv-cta {
    margin-top: var(--sp-8);
    padding: clamp(1.75rem, 5vw, 3rem);
    text-align: center;
    background:
      radial-gradient(
        120% 140% at 50% 0%,
        color-mix(in srgb, var(--accent) 12%, transparent),
        transparent 60%
      ),
      var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .rv-cta h3 {
    font-size: var(--fs-2xl);
  }

  .rv-cta p {
    max-width: min(56ch, 100%);
    margin: var(--sp-3) auto 0;
    color: var(--text-soft);
    font-size: var(--fs-sm);
  }

  .rv-cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
  }
</style>
