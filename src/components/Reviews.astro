---
/**
 * Блок отзывов.
 *
 * Принципы (важно не сломать при доработках):
 *  1. ВСЕ отзывы попадают в готовый HTML при сборке. Никакой подгрузки
 *     скриптом — то, что грузится через JS, поисковики и ИИ часто не видят.
 *     Именно из-за этого мы не смогли прочитать отзывы Владимира на NeedGuide.
 *  2. «Показать ещё» сделано на CSS (чекбокс), а не на JS: скрытые отзывы
 *     физически присутствуют в HTML и индексируются.
 *  3. Оценок в звёздах нет — их нет и в источнике. См. src/data/reviews.ts.
 */
import ReviewCard from './ReviewCard.astro';
import { REVIEWS, REVIEW_SOURCES, REVIEWS_VISIBLE, LEAVE_REVIEW_URL, REVIEW_YEARS } from '../data/reviews';

interface Props {
  title?: string;
  eyebrow?: string;
  lede?: string;
  alt?: boolean;
  /** Сколько показать сразу. Остальные — под кнопкой «Показать ещё». */
  visible?: number;
  /** Показывать ли форму «оставить отзыв». */
  showForm?: boolean;
}

const {
  title = 'Отзывы моих гостей',
  eyebrow = 'Отзывы',
  lede = 'Для меня каждая экскурсия — это не просто маршрут, а новая история. Я благодарен моим гостям за доверие и те улыбки, которые делают мою работу лучшей в мире!',
  alt = false,
  visible = REVIEWS_VISIBLE,
  showForm = true,
} = Astro.props;

const shown = REVIEWS.slice(0, visible);
const hidden = REVIEWS.slice(visible);

/** Годы, за которые есть отзывы — честный показатель «нас читают давно». */
const yearsSpan = `${REVIEW_YEARS.from}–${REVIEW_YEARS.to}`;

/** Сколько отзывов с какой площадки — показываем открыто. */
const bySource = REVIEW_SOURCES.map((s) => ({
  ...s,
  count: REVIEWS.filter((r) => r.source === s.name).length,
})).filter((s) => s.count > 0);
---

<section class:list={['section', { 'section-alt': alt }]} id="reviews">
  <div class="container">
    <header class="rv-head reveal">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="section-title">{title}</h2>
      {lede && <p class="lede">{lede}</p>}

      <div class="rv-stats">
        <div class="rv-stat">
          <strong>{REVIEWS.length}</strong>
          <span>отзывов</span>
        </div>
        <div class="rv-stat">
          <strong>{yearsSpan}</strong>
          <span>годы поездок</span>
        </div>
        <div class="rv-stat">
          <strong>100%</strong>
          <span>реальные люди</span>
        </div>
      </div>

      <p class="rv-source">
        Отзывы оставлены на площадках
        {
          bySource.map((s, i) => (
            <>
              {i > 0 && ' и '}
              <a href={s.url} target="_blank" rel="noopener nofollow">
                {s.name}
              </a>
              {' '}({s.count})
            </>
          ))
        }
        — у каждого отзыва есть прямая ссылка на оригинал, вы можете проверить любой.
        Оценок в звёздах на этих площадках нет, поэтому мы их не показываем.
      </p>
    </header>

    <ol class="rv-list">
      {shown.map((r) => <ReviewCard review={r} reveal />)}
    </ol>

    {
      hidden.length > 0 && (
        <div class="rv-more-wrap">
          {/* Чекбокс + CSS — отзывы уже в HTML, скрипт не нужен */}
          <input type="checkbox" id="rv-toggle" class="rv-toggle" />

          <ol class="rv-list rv-hidden-list">
            {hidden.map((r) => <ReviewCard review={r} />)}
          </ol>

          <label for="rv-toggle" class="btn btn-ghost rv-more-btn">
            <span class="rv-more-open">Показать все отзывы ({REVIEWS.length})</span>
            <span class="rv-more-close">Свернуть отзывы</span>
          </label>
        </div>
      )
    }

    {
      showForm && (
        <div class="rv-cta reveal">
          <h3>Были со мной на Санторини?</h3>
          <p>
            Буду очень признателен за пару строк — они помогают другим
            путешественникам решиться. Отзыв можно оставить на площадке, где я
            работаю много лет, или написать мне напрямую.
          </p>
          <div class="rv-cta-actions">
            <a
              href="https://www.tourister.ru/add_response_for_expert/Vladimir_Santorini"
              class="btn btn-primary"
              target="_blank"
              rel="noopener"
            >
              Оставить отзыв на Tourister
            </a>
            <a href="#review-form" class="btn btn-ghost">
              Написать отзыв мне
            </a>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .rv-head {
    max-width: 64ch;
    margin-bottom: var(--sp-7);
  }

  .rv-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-6);
    margin-top: var(--sp-5);
    padding-block: var(--sp-4);
    border-block: 1px solid var(--border);
  }

  .rv-stat {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .rv-stat strong {
    font-family: var(--font-display);
    font-size: 1.7rem;
    color: var(--accent);
  }

  .rv-stat span {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    margin-top: 3px;
  }

  .rv-source {
    margin-top: var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .rv-source a {
    color: var(--accent);
    text-decoration: underline;
  }

  /* --- список --- */
  .rv-list {
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    align-items: start;
  }













  /* --- «показать ещё» на чистом CSS --- */
  .rv-toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .rv-hidden-list {
    /* Отзывы ЕСТЬ в HTML — просто визуально свёрнуты.
       grid-template-rows: 0fr даёт плавное раскрытие без скриптов. */
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 420ms var(--ease), margin-top 420ms var(--ease);
    margin-top: 0;
  }

  .rv-hidden-list > * {
    overflow: hidden;
    min-height: 0;
  }

  .rv-toggle:checked ~ .rv-hidden-list {
    grid-template-rows: 1fr;
    margin-top: var(--sp-4);
  }

  /* Внутри раскрывающегося контейнера возвращаем сетку карточек */
  .rv-toggle:checked ~ .rv-hidden-list {
    display: grid;
    gap: var(--sp-4);
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    grid-template-rows: none;
  }

  .rv-hidden-list .rv-item {
    display: none;
  }

  .rv-toggle:checked ~ .rv-hidden-list .rv-item {
    display: block;
    animation: rvIn 380ms var(--ease) both;
  }

  @keyframes rvIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rv-toggle:checked ~ .rv-hidden-list .rv-item {
      animation: none;
    }
  }

  .rv-more-wrap {
    margin-top: var(--sp-4);
  }

  .rv-more-btn {
    display: inline-flex;
    margin-top: var(--sp-5);
    cursor: pointer;
  }

  .rv-more-close {
    display: none;
  }

  .rv-toggle:checked ~ .rv-more-btn .rv-more-open {
    display: none;
  }

  .rv-toggle:checked ~ .rv-more-btn .rv-more-close {
    display: inline;
  }

  .rv-toggle:focus-visible ~ .rv-more-btn {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  /* --- призыв оставить отзыв --- */
  .rv-cta {
    margin-top: var(--sp-8);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    text-align: center;
    background:
      radial-gradient(120% 140% at 50% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 60%),
      var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .rv-cta h3 {
    font-size: var(--fs-xl);
  }

  .rv-cta p {
    max-width: 56ch;
    margin: var(--sp-3) auto 0;
    color: var(--text-soft);
    font-size: var(--fs-sm);
  }

  .rv-cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3);
    margin-top: var(--sp-5);
  }
</style>
