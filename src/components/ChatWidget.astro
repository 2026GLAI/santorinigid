---
/**
 * Виджет ИИ-помощника.
 *
 * Работает в двух режимах:
 *  1. БЕЗ ключа API (сейчас) — отвечает по встроенной базе знаний,
 *     собранной ИСКЛЮЧИТЕЛЬНО из фактов с сайта. Ничего не выдумывает:
 *     если вопрос вне базы — честно предлагает написать Владимиру в WhatsApp.
 *  2. С ключом API — когда владелец решит подключить настоящий ИИ, ставим
 *     Cloudflare Worker (бесплатный) и меняем CHAT_API_URL на его адрес.
 *     Ключ хранится в Worker, в код сайта не попадает.
 *
 * Такой порядок выбран намеренно: сайт остаётся статическим и бесплатным,
 * а чат уже работает с первого дня.
 */
import { WHATSAPP, CONTACTS } from '../data/site';
---

<div class="chat-root">
  <button class="chat-toggle" id="chatToggle" aria-label="Открыть чат-помощника" aria-expanded="false">
    <svg class="ico-open" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z" />
    </svg>
    <svg class="ico-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
      <path d="M18 6L6 18M6 6l12 12" />
    </svg>
    <span class="chat-badge" id="chatBadge">ИИ</span>
  </button>

  <section class="chat-panel" id="chatPanel" hidden aria-label="Чат-помощник">
    <header class="chat-head">
      <div class="chat-avatar" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M12 2v3M4.9 4.9l2.1 2.1M2 12h3M19 12h3M17 7l2.1-2.1" />
          <rect x="5" y="8" width="14" height="12" rx="3" />
          <circle cx="9.5" cy="13.5" r="1.2" fill="currentColor" stroke="none" />
          <circle cx="14.5" cy="13.5" r="1.2" fill="currentColor" stroke="none" />
        </svg>
      </div>
      <div class="chat-head-text">
        <strong>Помощник по Санторини</strong>
        <span id="chatStatus">Отвечу на частые вопросы</span>
      </div>
      <button class="chat-min" id="chatMin" aria-label="Свернуть чат">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 12h12" /></svg>
      </button>
    </header>

    <div class="chat-log" id="chatLog" role="log" aria-live="polite"></div>

    <div class="chat-chips" id="chatChips"></div>

    <form class="chat-form" id="chatForm">
      <input
        type="text"
        id="chatInput"
        placeholder="Спросите про остров, экскурсии, яхты…"
        autocomplete="off"
        aria-label="Ваш вопрос"
      />
      <button type="submit" aria-label="Отправить">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
        </svg>
      </button>
    </form>

    <p class="chat-foot">
      Нужен точный ответ или расчёт цены?
      <a href={WHATSAPP.general} target="_blank" rel="noopener">Написать Владимиру →</a>
    </p>
  </section>
</div>

<script define:vars={{ WA: WHATSAPP.general, PHONE: CONTACTS.phone, TG: CONTACTS.telegram }}>
  // ---------------------------------------------------------------------
  // База знаний. КАЖДЫЙ факт взят с сайта santorinivip.com (снято 2026-07-25).
  // Ничего вымышленного: если ответа нет — отправляем к Владимиру.
  // ---------------------------------------------------------------------
  const KB = [
    {
      id: 'duration',
      keys: ['скольк', 'длит', 'продолж', 'час', 'времен', 'сколько времени'],
      q: 'Сколько длится экскурсия?',
      a: 'Обычно экскурсия длится от 4 до 7 часов. Маршрут и продолжительность подбираются индивидуально под ваши интересы и время пребывания на острове.',
    },
    {
      id: 'cruise',
      keys: ['круиз', 'лайнер', 'корабл', 'тендер', 'стоянк', 'порт'],
      q: 'Подходит ли для круизных туристов?',
      a: 'Да. Владимир специализируется на экскурсиях для гостей круизных лайнеров — с учётом времени стоянки и гарантированным возвращением к отправлению. Встреча — прямо у выхода со станции фуникулёра в Фире.',
    },
    {
      id: 'group',
      keys: ['групп', 'человек', 'компан', 'вдвоем', 'семь', 'детьм'],
      q: 'Сколько человек в группе?',
      a: 'Экскурсии проводятся индивидуально — только для вашей компании, без посторонних туристов. Транспорт — автомобиль с кондиционером.',
    },
    {
      id: 'language',
      keys: ['язык', 'русск', 'говор'],
      q: 'На каком языке экскурсия?',
      a: 'Все экскурсии проводятся на русском языке. Владимир живёт на Санторини 30 лет, профессиональный опыт — 14 лет.',
    },
    {
      id: 'price',
      keys: ['цен', 'стоим', 'сколько стоит', 'бюджет', 'дорог', 'деньг', 'евро'],
      q: 'Сколько стоит экскурсия?',
      a: 'Стоимость зависит от маршрута и продолжительности. Точную цену Владимир называет лично — напишите ему в WhatsApp или Telegram, он предложит оптимальный вариант.',
    },
    {
      id: 'route',
      keys: ['маршрут', 'куда', 'что посмотр', 'достоприм', 'программ', 'увид', 'ия', 'ойя'],
      q: 'Что входит в маршрут?',
      a: 'Классический маршрут: Ия (белые дома и синие купола), гора Пророка Ильи (567 м, монастырь XVIII века), церковь Панагия Эпископи (1118 год) и подземный винный музей Кутсуяннопулос с дегустацией четырёх сортов, включая Vinsanto. Программа корректируется под вас даже в день экскурсии.',
    },
    {
      id: 'wine',
      keys: ['вин', 'дегуст', 'vinsanto', 'винсанто', 'музе'],
      q: 'Есть ли дегустация вина?',
      a: 'Да. В подземном музее семьи Кутсуяннопулос вы узнаете секреты виноделия на вулканической почве, а в финале — дегустация четырёх элитных сортов, включая легендарное десертное Vinsanto.',
    },
    {
      id: 'yacht',
      keys: ['яхт', 'катамаран', 'море', 'круиз на закат', 'лодк', 'парус', 'снорк'],
      q: 'Какие есть яхты?',
      a: 'Во флоте 8 судов: катамараны Nautitech 46 Fly, Lagoon 46, Lagoon 42, Fountaine Pajot Isla 40, Excess 11 и скоростные Targa 46, Tesoro T40, Black Swan. Форматы: дневной круиз (10:00–15:00), закатный (15:30–после заката) и Full Day (10+ часов). Цены — от €1 200 за 5 часов в низкий сезон. В стоимость входят трансфер, открытый бар, греческая еда на борту и снорклинг-набор.',
    },
    {
      id: 'helicopter',
      keys: ['вертол', 'полет', 'полёт', 'воздух', 'небо', 'трансфер на'],
      q: 'Вертолётные туры',
      a: 'Обзор Кальдеры — 20, 30 или 60 минут. Трансферы: Санторини–Крит 45 мин, Санторини–Миконос 45 мин, Санторини–Афины 75 мин. Вылет с частных площадок без очередей аэропорта, пилоты лицензированные. Цену уточняйте у Владимира.',
    },
    {
      id: 'hotels',
      keys: ['отел', 'жиль', 'останов', 'номер', 'бронир', 'где жить'],
      q: 'Какие отели посоветуете?',
      a: 'На сайте есть авторская подборка из 14 отелей с видом на Кальдеру — Ия, Имеровигли, Фиростефани. Среди них Perivolas, Katikies, Andronis, Canaves Oia, Aspaki. Бронирование доступно любыми картами мира, включая карты РФ и UnionPay. Смотрите раздел «Отели».',
    },
    {
      id: 'ferry',
      keys: ['паром', 'крит', 'добрат', 'приеха', 'seajets', 'афиньос'],
      q: 'Как добраться с Крита?',
      a: 'Скоростные катамараны (например, SeaJets) идут около 2–2,5 часов из Ираклиона или Ретимно. Билеты лучше брать заранее — в сезон утренние рейсы разбирают быстро. Паром приходит в главный порт Афиньос.',
    },
    {
      id: 'funicular',
      keys: ['фуникул', 'ослик', 'ступен', 'подъем', 'подъём', '588'],
      q: 'Как подняться из старого порта?',
      a: 'Из Старого порта «Меса Ялос» в Фиру три пути: фуникулёр (10 евро, самый быстрый и с лучшими видами), ослики (10 евро) и 588 ступеней пешком. Владимир честно предупреждает: пешком в жару между осликами — сомнительное удовольствие.',
    },
    {
      id: 'about',
      keys: ['владимир', 'кто вы', 'о себе', 'опыт', 'гид', 'обо мне'],
      q: 'Расскажите о гиде',
      a: 'Владимир живёт на Санторини 30 лет, профессионально работает гидом 14 лет. Его подход: честные рекомендации, маршруты, проверенные временем, и спокойная дружеская атмосфера без спешки и толп.',
    },
    {
      id: 'photo',
      keys: ['фотосесс', 'фотограф', 'платье', 'сним', 'свадьб'],
      q: 'Есть ли фотосессии?',
      a: 'Да. Профессиональная съёмка на фоне белоснежной Ии, закатов Кальдеры, а также знаменитая фотосессия в «летящем платье» (flying dress). Подробности — в разделе «VIP услуги».',
    },
    {
      id: 'when',
      keys: ['когда', 'сезон', 'погод', 'месяц', 'лучшее время', 'май', 'июн', 'сентябр'],
      q: 'Когда лучше приезжать?',
      // Конкретные месяцы сезона на сайте не указаны — не выдумываем их,
      // отправляем к Владимиру, он живёт на острове и ответит точно.
      a: 'Точные рекомендации по датам лучше получить у Владимира — он живёт на острове 30 лет и подскажет, когда будет комфортнее именно для вашей поездки. По ценам на аренду яхт есть деление на низкий и высокий сезон: разницу он тоже объяснит.',
    },
    {
      id: 'contact',
      keys: ['связ', 'контакт', 'написа', 'позвон', 'телефон', 'whatsapp', 'telegram', 'почт'],
      q: 'Как связаться?',
      a: `Телефон и мессенджеры: ${PHONE} (Viber, WhatsApp, Telegram). Почта: santorinivip@gmail.com. Владимир на связи 24/7 и отвечает в течение часа.`,
    },
  ];

  const CHIPS = ['Сколько длится экскурсия?', 'Что входит в маршрут?', 'Аренда яхты', 'Как добраться с Крита?'];

  const GREETING =
    'Здравствуйте! Я помощник на сайте Владимира. Расскажу об экскурсиях, яхтах, вертолётах, отелях и самом острове. О чём хотите узнать?';

  const FALLBACK = `На этот вопрос у меня нет проверенного ответа — не хочу придумывать. Лучше спросите Владимира напрямую: <a href="${WA}" target="_blank" rel="noopener">WhatsApp</a> или <a href="${TG}" target="_blank" rel="noopener">Telegram</a>. Он отвечает в течение часа.`;

  // Если владелец подключит Worker с ИИ — вписать сюда его адрес.
  const CHAT_API_URL = '';

  const $ = (id) => document.getElementById(id);
  const toggle = $('chatToggle');
  const panel = $('chatPanel');
  const log = $('chatLog');
  const form = $('chatForm');
  const input = $('chatInput');
  const chips = $('chatChips');
  const badge = $('chatBadge');
  let started = false;

  function addMsg(text, who) {
    const el = document.createElement('div');
    el.className = `msg msg-${who}`;
    el.innerHTML = `<div class="bubble">${text}</div>`;
    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
    return el;
  }

  function typing() {
    const el = document.createElement('div');
    el.className = 'msg msg-bot typing';
    el.innerHTML = '<div class="bubble"><span></span><span></span><span></span></div>';
    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
    return el;
  }

  function renderChips() {
    chips.innerHTML = '';
    CHIPS.forEach((c) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'chip';
      b.textContent = c;
      b.addEventListener('click', () => {
        input.value = c;
        form.requestSubmit();
      });
      chips.appendChild(b);
    });
  }

  /** Поиск по базе знаний: считаем совпадения ключевых слов. */
  function findAnswer(qRaw) {
    const q = qRaw.toLowerCase().replace(/ё/g, 'е');
    let best = null;
    let bestScore = 0;
    for (const item of KB) {
      let score = 0;
      for (const k of item.keys) {
        if (q.includes(k.replace(/ё/g, 'е'))) score += k.length;
      }
      if (score > bestScore) {
        bestScore = score;
        best = item;
      }
    }
    return bestScore >= 3 ? best.a : null;
  }

  async function respond(question) {
    const t = typing();
    let answer = null;

    if (CHAT_API_URL) {
      // Режим настоящего ИИ (когда владелец подключит Worker).
      try {
        const r = await fetch(CHAT_API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question }),
        });
        if (r.ok) {
          const data = await r.json();
          answer = data.answer || null;
        }
      } catch (e) {
        answer = null; // молча падаем на локальную базу
      }
    }

    if (!answer) answer = findAnswer(question);
    await new Promise((res) => setTimeout(res, 420));
    t.remove();
    addMsg(answer || FALLBACK, 'bot');
  }

  function openChat() {
    panel.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    toggle.classList.add('is-open');
    badge.style.display = 'none';
    if (!started) {
      started = true;
      addMsg(GREETING, 'bot');
      renderChips();
    }
    setTimeout(() => input.focus(), 120);
  }

  function closeChat() {
    panel.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.classList.remove('is-open');
  }

  toggle.addEventListener('click', () => (panel.hidden ? openChat() : closeChat()));
  $('chatMin').addEventListener('click', closeChat);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) closeChat();
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = input.value.trim();
    if (!q) return;
    addMsg(q.replace(/[<>]/g, ''), 'me');
    input.value = '';
    chips.innerHTML = '';
    respond(q);
  });
</script>

<style>
  .chat-root {
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: clamp(1rem, 3vw, 1.75rem);
    z-index: 95;
  }

  .chat-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--c-aegean-600), var(--c-aegean-800));
    color: #fff;
    box-shadow: var(--shadow-lg);
    transition: transform var(--dur) var(--ease);
  }

  .chat-toggle:hover {
    transform: scale(1.06);
  }

  .chat-toggle .ico-close {
    display: none;
  }

  .chat-toggle.is-open .ico-open {
    display: none;
  }

  .chat-toggle.is-open .ico-close {
    display: block;
  }

  .chat-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    padding: 2px 7px;
    border-radius: var(--radius-full);
    background: var(--c-sunset-500);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .chat-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 12px);
    width: min(380px, calc(100vw - 2rem));
    height: min(560px, calc(100dvh - 8rem));
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    animation: chatIn 280ms var(--ease);
  }

  @keyframes chatIn {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.97);
    }
  }

  .chat-head {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-4);
    background: linear-gradient(135deg, var(--c-aegean-600), var(--c-aegean-800));
    color: #fff;
  }

  .chat-avatar {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    background: rgb(255 255 255 / 0.18);
    flex-shrink: 0;
  }

  .chat-head-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    flex: 1;
    min-width: 0;
  }

  .chat-head-text strong {
    font-size: 0.95rem;
  }

  .chat-head-text span {
    font-size: 0.75rem;
    opacity: 0.85;
  }

  .chat-min {
    color: #fff;
    opacity: 0.8;
    padding: 4px;
  }

  .chat-min:hover {
    opacity: 1;
  }

  .chat-log {
    flex: 1;
    overflow-y: auto;
    padding: var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    background: var(--bg);
  }

  .msg {
    display: flex;
  }

  .msg-me {
    justify-content: flex-end;
  }

  .bubble {
    max-width: 86%;
    padding: 0.7rem 0.95rem;
    border-radius: 16px;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .msg-bot .bubble {
    background: var(--surface);
    border: 1px solid var(--border);
    border-bottom-left-radius: 5px;
    color: var(--text);
  }

  .msg-me .bubble {
    background: var(--c-aegean-600);
    color: #fff;
    border-bottom-right-radius: 5px;
  }

  .bubble :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }

  .msg-me .bubble :global(a) {
    color: #fff;
  }

  .typing .bubble {
    display: flex;
    gap: 4px;
    padding: 0.85rem 1rem;
  }

  .typing span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-muted);
    animation: blink 1.3s infinite;
  }

  .typing span:nth-child(2) {
    animation-delay: 0.18s;
  }

  .typing span:nth-child(3) {
    animation-delay: 0.36s;
  }

  @keyframes blink {
    0%,
    60%,
    100% {
      opacity: 0.25;
    }
    30% {
      opacity: 1;
    }
  }

  .chat-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0 var(--sp-4);
    background: var(--bg);
  }

  .chip {
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--surface);
    font-size: 0.78rem;
    color: var(--text-soft);
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .chat-form {
    display: flex;
    gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-4);
    background: var(--bg);
  }

  .chat-form input {
    flex: 1;
    min-width: 0;
    padding: 0.7rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--surface);
    font-size: 0.9rem;
  }

  .chat-form input:focus {
