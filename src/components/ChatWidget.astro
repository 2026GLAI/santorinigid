---
/**
 * Виджет ИИ-помощника.
 *
 * Работает в двух режимах:
 *  1. БЕЗ ключа API (сейчас) — отвечает по встроенной базе знаний,
 *     собранной ИСКЛЮЧИТЕЛЬНО из фактов с сайта. Ничего не выдумывает:
 *     если вопрос вне базы — честно предлагает написать Владимиру в WhatsApp.
 *  2. С ключом API — когда владелец решит подключить настоящий ИИ, ставим
 *     Cloudflare Worker (бесплатный) и меняем CHAT_API_URL на его адрес.
 *     Ключ хранится в Worker, в код сайта не попадает.
 *
 * Такой порядок выбран намеренно: сайт остаётся статическим и бесплатным,
 * а чат уже работает с первого дня.
 */
import { Image } from 'astro:assets';
import botLogo from '../assets/img/chat-bot.webp';
/* Аватар шапки чата — отдельная картинка (робот за ноутбуком на фоне
   Ии), прислана владельцем 29.07.2026. На кнопке остаётся прежний
   круглый логотип. */
import headAvatar from '../assets/img/chat-avatar.png';
/*
  Рисованные эмодзи (Twemoji, файлы в public/emoji/): в сообщениях чата
  эмодзи показываются одинаковыми красивыми картинками у всех гостей,
  а не по-разному системными символами («дешёвые», оценка владельца
  29.07.2026). Символ вне списка остаётся обычным системным.
*/
import { CHAT_EMOJI, twemojiFile } from '../data/chat-emoji';

const EMOJI_MAP = Object.fromEntries(
  CHAT_EMOJI.map((e) => [e, `/emoji/${twemojiFile(e)}.svg`]),
);
import {
  WHATSAPP,
  CONTACTS,
  ON_ISLAND_SINCE,
  ISLAND_YEARS_TEXT,
  GUIDE_YEARS_TEXT,
} from '../data/site';
---

<div class="chat-root">
  {/*
    Кнопка — это сам логотип помощника. Круглый ободок вырезан прямо
    в картинке, поэтому кнопке не нужны ни фон, ни рамка.

    Крестика здесь нет намеренно: закрывают чат крестиком в его шапке,
    а на телефоне кнопка при открытом чате и вовсе прячется. Две кнопки
    закрытия рядом только путали бы.
  */}
  {/*
    densities={[1, 2, 3]} — ОБЯЗАТЕЛЬНО, иначе логотип мылит.

    Экран телефона умещает в одну «точку» вёрстки 2–3 настоящих пикселя.
    Раньше здесь выдавалась картинка ровно 84×84, её растягивало на ~250
    физических пикселей — отсюда и пропадала резкость. Исходный файл
    256×256, качество было, оно просто выбрасывалось при сборке.

    Теперь Astro делает три размера, а телефон берёт себе подходящий.
  */}
  <button class="chat-toggle" id="chatToggle" aria-label="Открыть чат-помощника" aria-expanded="false">
    {/* Ореол «пышной» пульсации — заливка, расходящаяся от кнопки.
        Отдельный элемент, потому что оба псевдоэлемента кнопки уже
        заняты кольцами. Просьба владельца 28.07.2026. */}
    <span class="chat-halo" aria-hidden="true"></span>
    <Image src={botLogo} alt="" width={84} height={84} densities={[1, 2, 3]} loading="eager" />
  </button>

  <section class="chat-panel" id="chatPanel" hidden aria-label="Чат-помощник">
    <header class="chat-head">
      <div class="chat-avatar" aria-hidden="true">
        {/* densities — без них картинка выдаётся ровно в размер вёрстки
            и мылит на телефоне (плотность пикселей 2–3×). */}
        <Image src={headAvatar} alt="" width={88} height={88} densities={[1, 2, 3]} loading="lazy" />
      </div>
      <div class="chat-head-text">
        <strong>ИИ помощник Владимира</strong>
        {/* Зелёная мигающая точка + «Онлайн» — замена подписи
            «Отвечу на частые вопросы», просьба владельца 29.07.2026. */}
        <span class="chat-status" id="chatStatus">
          <span class="chat-status-dot" aria-hidden="true"></span>
          Онлайн
        </span>
      </div>
      {/* Очистить переписку. Показывается только когда есть что стирать —
          пустая кнопка в шапке лишь путала бы. Переписка хранится
          в браузере гостя, и он вправе стереть её одним нажатием. */}
      <button class="chat-clear" id="chatClear" aria-label="Очистить переписку" title="Очистить переписку" hidden>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" />
        </svg>
      </button>

      <button class="chat-min" id="chatMin" aria-label="Закрыть чат">
        {/* Крестик — понятный знак «закрыть». Раньше была чёрточка
            «свернуть», её принимали за оформление и не нажимали. */}
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12" />
        </svg>
      </button>
    </header>

    <div class="chat-log" id="chatLog" role="log" aria-live="polite"></div>

    <form class="chat-form" id="chatForm">
      {/* maxlength — как в боте-образце: Worker всё равно режет до 1000,
          но честнее не дать напечатать лишнее, чем молча обрезать. */}
      <input
        type="text"
        id="chatInput"
        placeholder="Спросите про остров, экскурсии, яхты…"
        autocomplete="off"
        maxlength="1000"
        aria-label="Ваш вопрос"
      />
      <button type="submit" aria-label="Отправить">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
        </svg>
      </button>
    </form>

    {/* Ссылка в той же строке, что и текст: перенос строки перед тегом
        Astro схлопывает, и выходило «цены?Написать» без пробела. */}
    <p class="chat-foot">
      Нужен точный ответ или расчёт цены? <a href={WHATSAPP.general} target="_blank" rel="noopener">Написать Владимиру →</a>
    </p>
  </section>
</div>

{/*
  ВНИМАНИЕ. Всё, что скрипт ниже использует, обязано быть перечислено
  в define:vars. Импорт вверху этого файла работает ТОЛЬКО при сборке —
  в браузер он не попадает.

  27.07.2026 здесь не хватало ON_ISLAND_SINCE, ISLAND_YEARS_TEXT и
  GUIDE_YEARS_TEXT: браузер спотыкался на первом же обращении к ним,
  ронял ВЕСЬ скрипт целиком, и кнопка чата переставала работать —
  обработчик нажатия объявлен ниже по файлу и просто не успевал
  навеситься. Кнопку из-за этого дважды переписывали впустую.

  Добавляешь величину в скрипт — добавь её и сюда.
*/}
<script
  define:vars={{
    WA: WHATSAPP.general,
    PHONE: CONTACTS.phone,
    TG: CONTACTS.telegram,
    VIBER: CONTACTS.viberHref,
    ON_ISLAND_SINCE,
    ISLAND_YEARS_TEXT,
    GUIDE_YEARS_TEXT,
    EMOJI_MAP,
  }}
>
  // ---------------------------------------------------------------------
  // База знаний. КАЖДЫЙ факт взят с сайта santorinivip.com (снято 2026-07-25).
  // Ничего вымышленного: если ответа нет — отправляем к Владимиру.
  // ---------------------------------------------------------------------
  const KB = [
    {
      /*
        Приветствия. Нужны ЗАПАСНОМУ режиму: когда ИИ недоступен
        (лимит), «Привет» получал холодное «нет проверенного ответа» —
        поймано владельцем 29.07.2026. С ИИ этот пункт не соревнуется:
        живой ответ всегда в приоритете.
      */
      id: 'hello',
      keys: ['привет', 'здравств', 'добрый день', 'добрый вечер', 'доброе утро', 'hello', ' hi '],
      q: 'Привет!',
      a: 'Здравствуйте! Рад вам. Спрашивайте про остров, экскурсии, яхты или отели — а если нужен Владимир лично, подскажу, как связаться.',
    },
    {
      id: 'duration',
      keys: ['скольк', 'длит', 'продолж', 'час', 'времен', 'сколько времени'],
      q: 'Сколько длится экскурсия?',
      a: 'Обычно экскурсия длится от 4 до 7 часов. Маршрут и продолжительность подбираются индивидуально под ваши интересы и время пребывания на острове.',
    },
    {
      id: 'cruise',
      keys: ['круиз', 'лайнер', 'корабл', 'тендер', 'стоянк', 'порт'],
      q: 'Подходит ли для круизных туристов?',
      a: 'Да. Владимир специализируется на экскурсиях для гостей круизных лайнеров — с учётом времени стоянки и гарантированным возвращением к отправлению. Встреча — прямо у выхода со станции фуникулёра в Фире.',
    },
    {
      id: 'group',
      keys: ['групп', 'человек', 'компан', 'вдвоем', 'семь', 'детьм'],
      q: 'Сколько человек в группе?',
      a: 'Экскурсии проводятся индивидуально — только для вашей компании, без посторонних туристов. Транспорт — автомобиль с кондиционером.',
    },
    {
      id: 'language',
      keys: ['язык', 'русск', 'говор'],
      q: 'На каком языке экскурсия?',
      a: `Все экскурсии проводятся на русском языке. Владимир живёт на Санторини с ${ON_ISLAND_SINCE} года (${ISLAND_YEARS_TEXT}), профессиональный опыт гида — ${GUIDE_YEARS_TEXT}.`,
    },
    {
      id: 'price',
      keys: ['цен', 'стоим', 'сколько стоит', 'бюджет', 'дорог', 'деньг', 'евро'],
      q: 'Сколько стоит экскурсия?',
      a: 'Стоимость зависит от маршрута и продолжительности. Точную цену Владимир называет лично — напишите ему в WhatsApp или Telegram, он предложит оптимальный вариант.',
    },
    {
      id: 'route',
      /*
        «экскурси» обязателен: этим словом спрашивает и гость, и первая
        кнопка-подсказка чата. Без него самый частый вопрос сайта
        оставался без ответа.

        Ключа «ия» здесь БЫТЬ НЕ ДОЛЖНО, хотя посёлок называется Ия.
        Две буквы встречаются внутри десятков обычных слов, и вопросы
        «есть ли гарантия?», «какая аллергия на еду?» получали в ответ
        описание маршрута. Для посёлка достаточно «ойя» и «оия» —
        так его и пишут в вопросах.
      */
      keys: ['экскурси', 'маршрут', 'куда', 'что посмотр', 'достоприм', 'программ', 'увид', 'оия', 'ойя'],
      q: 'Что входит в маршрут?',
      a: 'Классический маршрут: Ия (белые дома и синие купола), гора Пророка Ильи (567 м, монастырь XVIII века), церковь Панагия Эпископи (1118 год) и подземный винный музей Кутсуяннопулос с дегустацией четырёх сортов, включая Vinsanto. Программа корректируется под вас даже в день экскурсии.',
    },
    {
      id: 'wine',
      keys: ['вин', 'дегуст', 'vinsanto', 'винсанто', 'музе'],
      q: 'Есть ли дегустация вина?',
      a: 'Да. В подземном музее семьи Кутсуяннопулос вы узнаете секреты виноделия на вулканической почве, а в финале — дегустация четырёх элитных сортов, включая легендарное десертное Vinsanto.',
    },
    {
      id: 'yacht',
      keys: ['яхт', 'катамаран', 'море', 'круиз на закат', 'лодк', 'парус', 'снорк'],
      q: 'Какие есть яхты?',
      a: 'Во флоте 8 судов: катамараны Nautitech 46 Fly, Lagoon 46, Lagoon 42, Fountaine Pajot Isla 40, Excess 11 и скоростные Targa 46, Tesoro T40, Black Swan. Форматы: дневной круиз (10:00–15:00), закатный (15:30–после заката) и Full Day (10+ часов). Цены — от €1 200 за 5 часов в низкий сезон. В стоимость входят трансфер, открытый бар, греческая еда на борту и снорклинг-набор.',
    },
    {
      id: 'helicopter',
      keys: ['вертол', 'полет', 'полёт', 'воздух', 'небо', 'трансфер на'],
      q: 'Вертолётные туры',
      a: 'Обзор Кальдеры — 20, 30 или 60 минут. Трансферы: Санторини–Крит 45 мин, Санторини–Миконос 45 мин, Санторини–Афины 75 мин. Вылет с частных площадок без очередей аэропорта, пилоты лицензированные. Цену уточняйте у Владимира.',
    },
    {
      id: 'hotels',
      keys: ['отел', 'жиль', 'останов', 'номер', 'бронир', 'где жить'],
      q: 'Какие отели посоветуете?',
      a: 'На сайте есть авторская подборка из 14 отелей с видом на Кальдеру — Ия, Имеровигли, Фиростефани. Среди них Perivolas, Katikies, Andronis, Canaves Oia, Aspaki. Бронирование доступно любыми картами мира, включая карты РФ и UnionPay. Смотрите раздел «Отели».',
    },
    {
      id: 'ferry',
      keys: ['паром', 'крит', 'добрат', 'приеха', 'seajets', 'афиньос'],
      q: 'Как добраться с Крита?',
      a: 'Скоростные катамараны (например, SeaJets) идут около 2–2,5 часов из Ираклиона или Ретимно. Билеты лучше брать заранее — в сезон утренние рейсы разбирают быстро. Паром приходит в главный порт Афиньос.',
    },
    {
      id: 'funicular',
      keys: ['фуникул', 'ослик', 'ступен', 'подъем', 'подъём', '588'],
      q: 'Как подняться из старого порта?',
      a: 'Из Старого порта «Меса Ялос» в Фиру три пути: фуникулёр (10 евро, самый быстрый и с лучшими видами), ослики (10 евро) и 588 ступеней пешком. Владимир честно предупреждает: пешком в жару между осликами — сомнительное удовольствие.',
    },
    {
      id: 'about',
      keys: ['владимир', 'кто вы', 'о себе', 'опыт', 'гид', 'обо мне'],
      q: 'Расскажите о гиде',
      a: `Владимир живёт на Санторини с ${ON_ISLAND_SINCE} года — это ${ISLAND_YEARS_TEXT}. Гидом работает ${GUIDE_YEARS_TEXT}. Его подход: честные рекомендации, маршруты, проверенные временем, и спокойная дружеская атмосфера без спешки и толп.`,
    },
    {
      id: 'photo',
      keys: ['фотосесс', 'фотограф', 'платье', 'сним', 'свадьб'],
      q: 'Есть ли фотосессии?',
      a: 'Да. Профессиональная съёмка на фоне белоснежной Ии, закатов Кальдеры, а также знаменитая фотосессия в «летящем платье» (flying dress). Подробности — в разделе «VIP услуги».',
    },
    {
      id: 'when',
      keys: ['когда', 'сезон', 'погод', 'месяц', 'лучшее время', 'май', 'июн', 'сентябр'],
      q: 'Когда лучше приезжать?',
      // Конкретные месяцы сезона на сайте не указаны — не выдумываем их,
      // отправляем к Владимиру, он живёт на острове и ответит точно.
      a: `Точные рекомендации по датам лучше получить у Владимира — он живёт на острове с ${ON_ISLAND_SINCE} года и подскажет, когда будет комфортнее именно для вашей поездки. По ценам на аренду яхт есть деление на низкий и высокий сезон: разницу он тоже объяснит.`,
    },
    {
      id: 'contact',
      keys: ['связ', 'контакт', 'написа', 'позвон', 'телефон', 'whatsapp', 'telegram', 'почт'],
      q: 'Как связаться?',
      a: `Телефон и мессенджеры: ${PHONE} (Viber, WhatsApp, Telegram). Почта: santorinivip@gmail.com. Владимир на связи 24/7 и отвечает в течение часа.`,
    },
  ];

  /*
    Приветствия — набор из 5, владелец выбрал 03.08.2026 («не должно
    быть постоянно одно и то же»). Выбор случайный, чистый JS в браузере
    гостя — токены ИИ здесь не тратятся, это не запрос к модели.
  */
  const GREETINGS = [
    'Привет! Я за главного по быстрым ответам. Чем могу помочь прямо сейчас?',
    'Привет! Я правая рука Владимира. Чем помогу прямо сейчас?',
    'Привет! Заглянули к Владимиру? Давайте быстро сориентирую!',
    'Привет! Рад видеть! Какой вопрос помогу решить прямо сейчас?',
    'Привет! Встречаю гостей Владимира. Чем могу помочь со старта?',
  ];
  const greeting = () => GREETINGS[Math.floor(Math.random() * GREETINGS.length)];

  const FALLBACK = `На этот вопрос у меня нет проверенного ответа — не хочу придумывать. Лучше спросите Владимира напрямую: <a href="${WA}" target="_blank" rel="noopener">WhatsApp</a> или <a href="${TG}" target="_blank" rel="noopener">Telegram</a>. Он отвечает в течение часа.`;

  /*
    Страховка от 01.08.2026: ИИ иногда присылает только маркер
    контактов без единого слова текста — гость видел голую карточку
    без объяснения. Эта фраза подставляется перед карточкой в таком
    случае, чтобы ответ не выглядел как обрыв.
  */
  const BRIDGE_TO_CARD = 'Здесь лучше уточнить у самого Владимира — напишите ему:';

  /*
    Адрес «мозга» чата — Cloudflare Worker santorini-chat.
    Развёрнут 28.07.2026 (аккаунт 2026glai@gmail.com), с 03.08.2026
    на OpenAI/gpt-5.6-luna, ключ лежит в Worker секретом. Если Worker
    недоступен или лимит исчерпан — чат сам падает на встроенную базу,
    гость ошибок не видит.
  */
  const CHAT_API_URL = 'https://santorini-chat.2026glai.workers.dev';

  const $ = (id) => document.getElementById(id);
  const toggle = $('chatToggle');
  const panel = $('chatPanel');
  const log = $('chatLog');
  const form = $('chatForm');
  const input = $('chatInput');
  const clearBtn = $('chatClear');
  let started = false;

  /* ---- Память переписки ----------------------------------------------
     Переписка хранится в localStorage — это память самого браузера гостя,
     на его устройстве. На сервер она не уходит и уйти не может: у сайта
     нет сервера, это набор статических файлов.

     Отсюда главное свойство: чужую переписку увидеть невозможно. У каждого
     она своя, в его собственном браузере. Владелец её тоже не видит —
     если гость хочет что-то передать, он пишет в WhatsApp.

     Храним последние 50 сообщений: чтобы длинная переписка не разрасталась
     без предела, но обычный разговор помещался целиком.
     Ключ с номером версии (v1) — если формат когда-нибудь изменится,
     старые записи не сломают чат, а просто перестанут читаться.        */
  const HISTORY_KEY = 'chat-history-v1';
  const HISTORY_MAX = 50;
  let history = [];

  function loadHistory() {
    try {
      const raw = localStorage.getItem(HISTORY_KEY);
      const parsed = raw ? JSON.parse(raw) : [];
      return Array.isArray(parsed) ? parsed.slice(-HISTORY_MAX) : [];
    } catch {
      // Приватный режим или испорченная запись — начинаем с чистого листа.
      return [];
    }
  }

  function saveHistory() {
    try {
      localStorage.setItem(HISTORY_KEY, JSON.stringify(history.slice(-HISTORY_MAX)));
    } catch {
      // Хранилище недоступно — чат работает как раньше, просто без памяти.
    }
  }

  /*
    Обезвреживание чужого текста.

    Ответы нашей собственной базы содержат ссылки (на WhatsApp, Telegram)
    и должны выводиться как разметка. А вот ответ, пришедший от ИИ, —
    это текст из внешнего источника, и вставлять его как разметку нельзя:
    туда можно подсунуть чужой код, который выполнится в браузере гостя.

    Поэтому текст ИИ проходит через эту функцию: все угловые скобки
    и кавычки превращаются в безобидные символы. Ссылки в ответе ИИ
    останутся просто текстом — это осознанный размен: лучше некликабельная
    ссылка, чем дыра в безопасности.

    Переводы строк сохраняем: ИИ часто отвечает абзацами.
  */
  function escapeHtml(s) {
    return String(s)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;')
      .replace(/\n/g, '<br>');
  }

  /*
    Ответ ИИ: сначала обезвредить, потом сделать ссылки кликабельными.

    Порядок важен и обратному не подлежит. Сначала весь текст становится
    безопасным — чужой код выполниться уже не может. И только потом, из
    того, что заведомо безопасно, мы САМИ собираем ссылки — и только на
    известные нам адреса: WhatsApp, Telegram и наш собственный сайт.

    Ссылку на чужой адрес бот кликабельной не сделает: она останется
    обычным текстом. Это осознанно — так на сайт нельзя подсунуть переход
    на постороннюю страницу.
  */
  function formatAiAnswer(raw) {
    const safe = escapeHtml(raw);
    const link = (url) =>
      `<a href="${url}" target="_blank" rel="noopener">${url.replace(/^https:\/\//, '')}</a>`;

    return safe.replace(
      // Кликабельными становятся только заведомо наши адреса + одно
      // конкретное видео владельца про высадку с лайнера (тендеры)
      /https:\/\/(wa\.me\/[\w]+|t\.me\/[\w_]+|santorinigid\.com[\w\-/]*|www\.youtube\.com\/watch\?v=m331MPP7PpI)/g,
      (m) => link(m),
    );
  }

  /*
    Карточка «Написать Владимиру» — как в боте-образце владельца.
    Вставляется вместо маркера [CONTACTS] из ответа ИИ. Разметка наша
    собственная, доверенная: в неё подставляются только адреса из site.ts.
  */
  const CONTACT_CARD =
    '<div class="chat-contacts">' +
    '<span class="chat-contacts-label">Написать Владимиру</span>' +
    `<a class="chat-contact-wa" href="${WA}" target="_blank" rel="noopener">WhatsApp</a>` +
    `<a class="chat-contact-viber" href="${VIBER}">Viber</a>` +
    `<a class="chat-contact-tg" href="${TG}" target="_blank" rel="noopener">Telegram</a>` +
    '</div>';

  /*
    Подстраховка: ИИ иногда игнорирует маркер и пишет контакты голым
    текстом. Такие строки вырезаем — карточка красивее и надёжнее
    (номер с опечаткой бота никому не поможет).
  */
  function isContactLine(line) {
    if (line.replace(/\D/g, '').includes('6946800255')) return true;
    const l = line.toLowerCase();
    return (
      l.includes('santorinivip@gmail') ||
      l.includes('@santorini_vladimir') ||
      line.trimStart().startsWith('📱')
    );
  }

  /*
    Полная обработка ответа ИИ: маркер и контактные строки заменяются
    карточкой (одной, сколько бы их ни было), остальной текст
    обезвреживается и получает кликабельные ссылки.

    Страховка от 01.08.2026: если ИИ прислал ТОЛЬКО маркер/контактную
    строку без единого слова текста, гость не должен увидеть голую
    карточку без объяснения — подставляем честную фразу-мостик.
  */
  function renderAiAnswer(raw) {
    let needCard = false;
    const kept = String(raw)
      .split('\n')
      .filter((line) => {
        if (line.includes('[CONTACTS]') || isContactLine(line)) {
          needCard = true;
          return false;
        }
        return true;
      });
    const textPart = kept.join('\n').trim();
    let html = formatAiAnswer(textPart || (needCard ? BRIDGE_TO_CARD : ''));
    if (needCard) html += CONTACT_CARD;
    return html;
  }

  /*
    Рисованные эмодзи: символы из нашего набора заменяются картинками.
    Замена идёт по готовой разметке, где эмодзи не могут оказаться
    внутри адресов ссылок — только в тексте. Длинные символы первыми,
    чтобы составные эмодзи не разрезались короткими.
  */
  const EMOJI_KEYS = Object.keys(EMOJI_MAP).sort((a, b) => b.length - a.length);

  function emojiImgTag(ch) {
    return `<img class="emo" src="${EMOJI_MAP[ch]}" alt="${ch}" loading="lazy">`;
  }

  function swapEmoji(html) {
    let out = html;
    for (const ch of EMOJI_KEYS) {
      if (out.includes(ch)) out = out.split(ch).join(emojiImgTag(ch));
    }
    return out;
  }

  /** Рисует сообщение. remember=false — для восстановленных, чтобы не дублировать.
      В историю кладётся исходный текст, а картинки-эмодзи подставляются
      только при показе — так замена работает и для восстановленных. */
  function addMsg(text, who, remember = true) {
    const el = document.createElement('div');
    el.className = `msg msg-${who}`;
    el.innerHTML = `<div class="bubble">${swapEmoji(text)}</div>`;
    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
    if (remember) {
      history.push({ t: text, w: who });
      saveHistory();
      if (clearBtn) clearBtn.hidden = false;
    }
    return el;
  }

  function clearHistory() {
    history = [];
    try {
      localStorage.removeItem(HISTORY_KEY);
    } catch {
      /* Нечего удалять — хранилище и так недоступно. */
    }
    log.innerHTML = '';
    clearBtn.hidden = true;
    addMsg(greeting(), 'bot');
    input.focus();
  }

  function typing() {
    const el = document.createElement('div');
    el.className = 'msg msg-bot typing';
    el.innerHTML = '<div class="bubble"><span></span><span></span><span></span></div>';
    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
    return el;
  }

  /*
    Слова, которые встречаются почти в любом вопросе к гиду и потому
    НЕ говорят о теме. Вес у них минимальный: они помогают найти ответ,
    когда больше зацепиться не за что, но никогда не перебивают
    настоящее тематическое слово.

    Зачем: вес совпадения равен длине слова, а «экскурси» длиннее, чем
    «русск». Без этого списка вопрос «экскурсия на русском?» получал
    ответ про маршрут вместо ответа про язык.

    Перечислять только слова, реально встречающиеся ключами в базе выше:
    лишние записи — мёртвая настройка, вводящая в заблуждение.

    «владимир» здесь потому, что имя встречается в вопросах на ЛЮБУЮ
    тему: «Как связаться с Владимиром?» получал ответ про гида вместо
    контактов — длинное имя (8 букв) перевешивало точное «связ» (4).
    Найдено проверкой на живом сайте 28.07.2026.
  */
  const WEAK_KEYS = ['экскурси', 'владимир'];

  /* Вес слабого слова. Ровно 2 — столько же, сколько порог ниже:
     одного слабого слова хватает, чтобы ответить («расскажите про
     экскурсии»), но перебить точное слово оно не может. */
  const WEAK_WEIGHT = 2;

  /*
    Порог, ниже которого тема считается нераспознанной и гость честно
    отправляется к Владимиру.

    Почему именно 2, а не 1. В базе есть двухбуквенный ключ «ия» (Ия —
    посёлок на острове). При пороге 1 он срабатывал сам по себе, и любое
    слово с «ия» внутри уводило в ответ про маршрут: «есть ли гарантия?»,
    «какая аллергия на еду?» — гость получал описание Ии вместо того,
    чтобы быть отправленным к Владимиру. Это ровно то враньё, которого
    в проекте быть не должно. Проверено перебором.
  */
  const MIN_SCORE = 2;

  /** Поиск по базе знаний: считаем совпадения ключевых слов. */
  function findAnswer(qRaw) {
    const q = qRaw.toLowerCase().replace(/ё/g, 'е');
    let best = null;
    let bestScore = 0;
    for (const item of KB) {
      let score = 0;
      for (const k of item.keys) {
        const key = k.replace(/ё/g, 'е');
        if (q.includes(key)) score += WEAK_KEYS.includes(k) ? WEAK_WEIGHT : key.length;
      }
      if (score > bestScore) {
        bestScore = score;
        best = item;
      }
    }
    return bestScore >= MIN_SCORE ? best.a : null;
  }

  async function respond(question) {
    const t = typing();

    if (CHAT_API_URL) {
      // Режим настоящего ИИ (когда владелец подключит Worker).
      try {
        const r = await fetch(CHAT_API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            question,
            /*
              Отдаём последние 10 сообщений, чтобы бот помнил разговор:
              иначе на «а сколько это стоит?» он не поймёт, о чём речь.

              Переписка лежит в браузере гостя и никуда больше не уходит —
              она отправляется только на наш Worker и только затем, чтобы
              ИИ понял контекст. Ни база, ни сервер её не хранят.
            */
            history: history.slice(-10).map((m) => ({
              role: m.w === 'bot' ? 'assistant' : 'user',
              // Убираем разметку: в наших готовых ответах есть ссылки
              // тегами, а ИИ нужен чистый текст — иначе он решит, что
              // так и надо отвечать, и начнёт сыпать тегами сам.
              content: m.t.replace(/<[^>]*>/g, ' ').trim(),
            })),
          }),
        });

        const type = r.headers.get('Content-Type') || '';

        // Основной путь: поток. Бот «печатает» ответ по буквам —
        // как в боте-образце владельца.
        if (r.ok && type.includes('text/event-stream') && r.body) {
          const shown = await streamAnswer(r.body, t);
          if (shown) return;
        } else if (r.ok && type.includes('application/json')) {
          // Запасной путь: обычный целый ответ (если Worker без потока).
          const data = await r.json();
          if (data.answer) {
            t.remove();
            addMsg(renderAiAnswer(data.answer), 'bot');
            return;
          }
        }
      } catch {
        /* сеть или Worker подвели — молча падаем на локальную базу */
      }
    }

    const answer = findAnswer(question);
    await new Promise((res) => setTimeout(res, 420));
    t.remove();
    addMsg(answer || FALLBACK, 'bot');
  }

  /*
    Чтение потока: события «data: {type:'token', content:'…'}» приходят
    кусочками, каждый кусочек дописываем в пузырь. Пока идёт печать,
    текст вставляется как textContent — это безопасно по построению.
    Когда поток закончился, готовый ответ один раз прогоняется через
    renderAiAnswer: обезвреживание, ссылки, карточка контактов.

    Возвращает true, если ответ показан; false — если поток оборвался
    пустым и нужно ответить из локальной базы.
  */
  async function streamAnswer(body, t) {
    const reader = body.getReader();
    const decoder = new TextDecoder();
    let raw = '';
    let el = null;
    let bubble = null;
    let buf = '';
    let finished = false;

    /*
      «Перо» — просьба владельца 29.07.2026, доведено до мягкости в тот
      же вечер («не похоже на ручку… сделай помягче»). Как устроено:
      • буквы появляются ПО ОДНОЙ, каждая мягко проявляется (класс
        pen-ch с коротким затуханием — жёсткого «дописывания» нет);
      • ритм живой и неровный, как у руки: 22–48 мс на букву,
        с микропаузами после точек и запятых — перо «думает»;
      • если в очереди скопился длинный хвост, перо тихо ускоряется —
        гость не ждёт большой ответ вечность;
      • на кончике строки — три мягко дышащие точки «печатает…»
        (pen-caret, было чертой — заменено 01.08.2026 по просьбе
        владельца, черта выглядела как курсор ввода).
      Кто просил «меньше движения» — получает текст сразу, без пера.
    */
    const instant = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let shown = 0;
    let penActive = false;
    const caret = document.createElement('span');
    caret.className = 'pen-caret';
    caret.setAttribute('aria-hidden', 'true');
    caret.append(document.createElement('span'), document.createElement('span'), document.createElement('span'));

    /*
      Перо пишет ЦЕЛЫМИ символами, а не машинными половинками: эмодзи
      и составные знаки занимают несколько машинных единиц, и без этого
      на долю секунды мелькал бы «битый» символ.
    */
    const seg =
      typeof Intl !== 'undefined' && Intl.Segmenter
        ? new Intl.Segmenter('ru', { granularity: 'grapheme' })
        : null;
    const toGraphemes = (s) => (seg ? [...seg.segment(s)].map((x) => x.segment) : Array.from(s));

    const writeNext = () => {
      if (!bubble) {
        penActive = false;
        return;
      }
      const gs = toGraphemes(raw);
      const backlog = gs.length - shown;

      if (backlog <= 0) {
        if (finished) {
          caret.remove();
          penActive = false;
          return;
        }
        // Буквы ещё в пути — перо ждёт у бумаги
        setTimeout(writeNext, 40);
        return;
      }

      const ch = gs[shown];
      shown += 1;
      let piece;
      if (EMOJI_MAP[ch]) {
        // Эмодзи из набора перо рисует сразу красивой картинкой
        piece = document.createElement('img');
        piece.className = 'pen-ch emo';
        piece.src = EMOJI_MAP[ch];
        piece.alt = ch;
      } else {
        piece = document.createElement('span');
        piece.className = 'pen-ch';
        piece.textContent = ch;
      }
      bubble.insertBefore(piece, caret);
      log.scrollTop = log.scrollHeight;

      let delay;
      if (backlog > 220) {
        delay = 6; // длинный хвост — ускоряемся незаметно
      } else if (backlog > 90) {
        delay = 14;
      } else {
        delay = 22 + Math.random() * 26; // живой неровный ритм руки
        if ('.!?…'.includes(ch)) delay += 260;
        else if (',;:—'.includes(ch)) delay += 120;
      }
      setTimeout(writeNext, delay);
    };

    try {
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buf += decoder.decode(value, { stream: true });

        let i;
        while ((i = buf.indexOf('\n\n')) >= 0) {
          const line = buf.slice(0, i).trim();
          buf = buf.slice(i + 2);
          if (!line.startsWith('data: ')) continue;
          let ev;
          try {
            ev = JSON.parse(line.slice(6));
          } catch {
            continue;
          }
          if (ev.type === 'token' && ev.content) {
            raw += ev.content;
            if (!el) {
              // Первая буква пришла — убираем «печатает…», заводим пузырь
              t.remove();
              el = addMsg('', 'bot', false);
              bubble = el.querySelector('.bubble');
              if (!instant) {
                bubble.appendChild(caret);
                penActive = true;
                writeNext();
              }
            }
            if (instant) {
              shown = raw.length;
              bubble.textContent = raw;
              log.scrollTop = log.scrollHeight;
            }
          }
        }
      }
    } catch {
      /* поток оборвался — покажем то, что успело прийти */
    }

    finished = true;

    if (!raw.trim()) {
      caret.remove();
      if (el) el.remove();
      return false;
    }

    // Даём перу дописать остаток до последней буквы
    if (!instant) {
      while (penActive) {
        await new Promise((r) => setTimeout(r, 40));
      }
    }

    const html = renderAiAnswer(raw);
    bubble.innerHTML = swapEmoji(html);
    log.scrollTop = log.scrollHeight;
    // В историю — без картинок: их подставит addMsg при восстановлении
    history.push({ t: html, w: 'bot' });
    saveHistory();
    if (clearBtn) clearBtn.hidden = false;
    return true;
  }

  /** Телефон: чат открывается на весь экран. */
  const isPhone = () => window.matchMedia('(max-width: 640px)').matches;

  function openChat() {
    panel.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    toggle.classList.add('is-open');
    // Класс на странице: по нему на телефоне прячутся кнопка чата
    // и «наверх» (правила в global.css и ScrollTop).
    document.documentElement.classList.add('chat-open');

    if (isPhone()) {
      // Фон не должен прокручиваться под открытым чатом
      document.body.style.overflow = 'hidden';
      // Окно чата — строго на весь экран, без отступов родителя
      const root = document.querySelector('.chat-root');
      if (root) {
        root.style.setProperty('inset', '0', 'important');
        root.style.setProperty('right', '0', 'important');
        root.style.setProperty('bottom', '0', 'important');
      }
    }

    if (!started) {
      started = true;
      history = loadHistory();
      if (history.length) {
        // Возвращаем прошлый разговор: гость продолжает с того же места,
        // даже если открыл сайт заново или перешёл на другую страницу.
        history.forEach((m) => addMsg(m.t, m.w, false));
        clearBtn.hidden = false;
      } else {
        addMsg(greeting(), 'bot');
      }
    }
    // На телефоне не наводим фокус сразу: иначе выскакивает клавиатура
    // и закрывает половину и без того небольшого экрана.
    if (!isPhone()) setTimeout(() => input.focus(), 120);
  }

  function closeChat() {
    panel.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.classList.remove('is-open');
    document.documentElement.classList.remove('chat-open');
    document.body.style.overflow = '';

    // Возвращаем родителю его обычные отступы от края экрана
    const root = document.querySelector('.chat-root');
    if (root) {
      root.style.removeProperty('inset');
      root.style.removeProperty('right');
      root.style.removeProperty('bottom');
    }
  }

  toggle.addEventListener('click', () => (panel.hidden ? openChat() : closeChat()));
  $('chatMin').addEventListener('click', closeChat);
  clearBtn?.addEventListener('click', clearHistory);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) closeChat();
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = input.value.trim();
    if (!q) return;
    addMsg(q.replace(/[<>]/g, ''), 'me');
    input.value = '';
    respond(q);
  });
</script>

<style>
  /*
    Отступы снизу и справа считаются с оглядкой на «безопасную зону» —
    места, занятые системой: полоска-домой внизу iPhone, скруглённые
    углы и жестовая панель на Android.

    max(наш отступ, системный) — берём больший из двух: на обычном
    экране системный равен нулю и работает наш, на телефоне с полоской
    кнопка поднимается ровно настолько, чтобы её не перекрывало.
    Без этого кнопка чата на некоторых телефонах налезает на полоску,
    и нажатие попадает мимо.
  */
  .chat-root {
    position: fixed;
    right: max(clamp(1rem, 3vw, 1.75rem), env(safe-area-inset-right, 0px));
    bottom: max(clamp(1rem, 3vw, 1.75rem), env(safe-area-inset-bottom, 0px));
    /*
      z-index 250 — ВЫШЕ шапки (100) и полоски прогресса (200), и это
      не прихоть. Родитель с position:fixed и z-index создаёт свой
      «этаж» для всего содержимого: внутренний z-index 200 у окна чата
      не мог выпрыгнуть выше родительских 95, и на телефоне ШАПКА
      ПЕРЕКРЫВАЛА ВЕРХ открытого чата (кнопку закрытия в том числе).
      Найдено владельцем 28.07.2026. Поднят весь слой чата целиком.
    */
    z-index: 250;
  }

  /* Пока чат открыт на телефоне — прячем кнопку открытия:
     на весь экран она не нужна, а место занимает. */
  @media (max-width: 640px) {
    :global(html.chat-open) .chat-toggle {
      display: none;
    }
  }

  /* ═══════════════════════════════════════════════════════════════════
     КНОПКА ЧАТА

     Написана начисто 27.07.2026. Прежний вариант накопил противоречия:
     правило :hover со своим transform перебивало анимацию пульсации
     (последнее правило в CSS выигрывает), и пульсации не было видно.

     Устройство простое:
       .chat-toggle  — сама кнопка, только логотип, ничего лишнего;
       ::before      — синее кольцо, расходящееся ПОД логотипом;
       ::after       — мягкое свечение по краю, тоже под логотипом.

     Пульсация живёт в кольце и свечении, а не в самой кнопке. Поэтому
     transform кнопки свободен, и :hover ничего не ломает.
     ═══════════════════════════════════════════════════════════════════ */
  .chat-toggle {
    position: relative;
    display: block;
    width: clamp(68px, 5vw, 84px);
    height: clamp(68px, 5vw, 84px);
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: transform var(--dur) var(--ease);
    /*
      ⛔ НЕ СТАВИТЬ СЮДА filter (в том числе drop-shadow).

      28.07.2026 найдена причина, почему пульсации не было видно НИГДЕ —
      ни на телефоне, ни на компьютере. Здесь стояло
      `filter: drop-shadow(...)`. Любой filter создаёт для элемента свой
      контекст отрисовки, и всё, что выходит за его границы, ОБРЕЗАЕТСЯ.
      А кольца пульсации как раз выходят: они разрастаются до scale(1.5),
      то есть на 21px за край кнопки с каждой стороны. Кольца исправно
      рисовались и анимировались — их просто срезало.

      Тень теперь висит на самом логотипе (.chat-toggle img) — выглядит
      так же, а кольцам ничто не мешает.
    */
  }

  /* Логотип. Круглый, с ободком — вырезан в самом файле картинки. */
  .chat-toggle img {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    /* Тень перенесена сюда с кнопки: на кнопке filter обрезал кольца
       пульсации (см. предупреждение выше). Здесь она никому не мешает —
       картинка и так занимает кнопку целиком. */
    filter: drop-shadow(0 6px 18px rgb(10 47 77 / 0.28));
    /* Нажатие проходит сквозь картинку прямо на кнопку.
       Без этого щелчок иногда достаётся картинке, а не кнопке,
       и чат не открывается. */
    pointer-events: none;
  }

  /*
    Расходящееся кольцо — «круги по воде» от края кнопки.
    Лежит ПОД логотипом (z-index: 1), поэтому расходится по сторонам,
    не закрывая картинку.

    Цвет — «транспортный красный» #cc0605 (токен --c-pulse), выбран
    владельцем лично. Кольца толстые (4px), яркие на старте и с широким
    размахом: его же просьбы — «пульсация должна бросаться в глаза»,
    «+30% силы».
  */
  .chat-toggle::before {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    border-radius: 50%;
    border: 4px solid var(--c-pulse);
    animation: chatRing 2.6s var(--ease) infinite;
    pointer-events: none;
  }

  /* Второе кольцо, с задержкой — волны идут одна за другой */
  .chat-toggle::after {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    border-radius: 50%;
    border: 4px solid var(--c-pulse);
    animation: chatRing 2.6s var(--ease) 1.3s infinite;
    pointer-events: none;
  }

  @keyframes chatRing {
    0% {
      transform: scale(1);
      opacity: 1;
    }
    70% {
      transform: scale(1.7);
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  /*
    Ореол — мягкая тёплая волна-заливка, расходящаяся от кнопки.
    Вместе с двумя кольцами даёт ту самую «пышную» пульсацию,
    которую владелец показал на своём другом сайте (28.07.2026).
  */
  .chat-halo {
    position: absolute;
    z-index: 1;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    animation: chatHalo 2.6s var(--ease) infinite;
  }

  @keyframes chatHalo {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--c-pulse) 55%, transparent);
    }
    75% {
      box-shadow: 0 0 0 26px transparent;
    }
    100% {
      box-shadow: 0 0 0 26px transparent;
    }
  }

  .chat-toggle:hover {
    transform: scale(1.06);
  }

  .chat-toggle:active {
    transform: scale(0.97);
  }

  /* Чат открыт — кольца и ореол не нужны, гость уже нажал */
  .chat-toggle.is-open::before,
  .chat-toggle.is-open::after {
    animation: none;
    opacity: 0;
  }

  .chat-toggle.is-open .chat-halo {
    animation: none;
    box-shadow: none;
  }

  /*
    Щадящий режим — но БЕЗ полного отключения колец.

    Почему не «animation: none»: у владельца в Windows выключена анимация
    окон, и браузер сообщает сайту «убрать движение». Кольца пропадали
    полностью, и кнопку было не отличить от неподвижной картинки —
    ровно то, ради чего пульсацию и делали.

    Компромисс: движение убираем (кольцо не разлетается), но мягкое
    мерцание оставляем. Оно спокойное, не дёргает взгляд, и при этом
    показывает, что кнопка живая.
  */
  @media (prefers-reduced-motion: reduce) {
    .chat-toggle::before {
      animation: chatGlow 3s ease-in-out infinite;
    }

    .chat-toggle::after {
      animation: none;
      opacity: 0;
    }

    .chat-toggle {
      transition: none;
    }
  }

  /* Диапазон яркости поднят вместе с основной пульсацией (28.07.2026):
     на компьютере владельца анимация Windows выключена, и он видит
     именно это мерцание — оно тоже обязано бросаться в глаза. */
  @keyframes chatGlow {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .chat-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 12px);
    /*
      Ширина считается от 100dvw, а НЕ от 100vw.

      На Android 100vw включает в себя ширину полосы прокрутки, то есть
      оказывается чуть больше видимой области. Панель прижата к правому
      краю экрана (родитель position: fixed), поэтому лишние пиксели
      выталкивали её за край, и страница ездила вбок.
      100dvw считается от реально видимой ширины.
    */
    width: min(380px, calc(100dvw - 2rem));
    height: min(560px, calc(100dvh - 8rem));
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    /* Панель должна быть ВЫШЕ кнопки WhatsApp (z-index: 90),
       иначе зелёная кнопка перекрывает поле ввода снизу. */
    z-index: 96;
    animation: chatIn 280ms var(--ease);
  }

  /*
    ТЕЛЕФОН: чат открывается на весь экран.

    Причина: окно 543px на экране 844px закрывало почти всё, при этом
    само уезжало за левый край, а зелёная кнопка WhatsApp перекрывала
    низ панели. Гость не мог ни пользоваться чатом, ни закрыть его.

    На весь экран — понятнее: видно, что это отдельное окно, и крупная
    кнопка закрытия всегда на виду.
  */
  @media (max-width: 640px) {
    /* Отступы родителя обнуляются в global.css (html.chat-open .chat-root):
       правило написано там, потому что .chat-root получает отступы вне
       медиазапросов, и глобальное правило вне @layer гарантированно
       их перебивает. Дублирует его и скрипт openChat — вторая линия. */
    .chat-panel {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100dvh;
      max-height: none;
      border: none;
      border-radius: 0;
      z-index: 200;
    }

    /*
      ОБЯЗАТЕЛЬНО, пока в viewport стоит viewport-fit=cover.

      Этот параметр разрешает странице заходить под вырез, скруглённые
      углы и полоску-домой. Для кнопок внизу это и нужно (они сами
      отступают через env), но панель чата раскрыта во весь экран
      (inset: 0) — и без собственных отступов её шапка ушла бы под
      строку состояния, а поле ввода — под жестовую панель Android.
      То есть кнопка «закрыть» и ввод текста оказались бы недоступны.

      Отступ добавляется К уже имеющемуся: calc(свой + системный).
    */
    .chat-head {
      /* Только системный отступ выреза: свои вертикальные отступы
         шапка отдала текстовому блоку (аватар — во всю высоту).
         Полоска над аватаром остаётся синим градиентом шапки. */
      padding-top: env(safe-area-inset-top, 0px);
    }

    .chat-form {
      /* базовый отступ формы — var(--sp-3), к нему прибавляем системный */
      padding-bottom: calc(var(--sp-3) + env(safe-area-inset-bottom, 0px));
    }
  }

  @keyframes chatIn {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.97);
    }
  }

  /*
    Шапка без собственных вертикальных отступов: аватар растягивается
    на ВСЮ её высоту (просьба владельца 29.07.2026 — «квадратным и на
    всю высоту шапки»). Высоту шапке задаёт текстовый блок своими
    отступами, а аватар подстраивается под неё квадратом.
  */
  .chat-head {
    display: flex;
    align-items: stretch;
    gap: var(--sp-3);
    padding: 0 var(--sp-2) 0 0;
    background: linear-gradient(135deg, var(--c-aegean-600), var(--c-aegean-800));
    color: #fff;
  }

  /*
    Квадрат во всю высоту шапки: высота приходит от растяжения
    (align-items: stretch), ширина считается из пропорции 1:1.
    Углы не скругляем — у панели свой overflow: hidden, он сам
    подрежет угол под скругление окна.
  */
  .chat-avatar {
    align-self: stretch;
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
    overflow: hidden;
  }

  .chat-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Высоту шапки задаёт именно этот блок своими отступами —
     аватар слева растягивается вслед за ним. */
  .chat-head-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    line-height: 1.25;
    flex: 1;
    min-width: 0;
    padding-block: var(--sp-4);
  }

  .chat-head-text strong {
    font-size: 0.95rem;
  }

  .chat-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    /* Тот же зелёный, что у сообщений «отправлено» в тёмной теме —
       на тёмно-синем градиенте шапки читается отлично */
    color: #4ade80;
  }

  .chat-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    animation: statusBlink 1.6s ease-in-out infinite;
  }

  @keyframes statusBlink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }

  /*
    Кнопка закрытия. Заметная и крупная: гость должен закрыть чат
    с первого раза, не разглядывая интерфейс.
  */
  /* Очистка переписки. Приглушённее крестика: действие нужное, но
     не основное — закрывают чат чаще, чем стирают историю. */
  .chat-clear {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    align-self: center;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    color: rgb(255 255 255 / 0.75);
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .chat-clear:hover {
    background: rgb(255 255 255 / 0.16);
    color: #fff;
  }

  .chat-min {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    align-self: center;
    flex-shrink: 0;
    margin-right: -6px;
    border-radius: var(--radius-full);
    background: rgb(255 255 255 / 0.16);
    color: #fff;
    transition: background-color var(--dur) var(--ease);
  }

  .chat-min:hover,
  .chat-min:focus-visible {
    background: rgb(255 255 255 / 0.3);
  }

  /* На телефоне — ещё крупнее, это главная кнопка выхода */
  @media (max-width: 640px) {
    .chat-min {
      width: 48px;
      height: 48px;
    }
  }

  .chat-log {
    flex: 1;
    overflow-y: auto;
    padding: var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    background: var(--bg);
  }

  /*
    ⚠️ ВСЕ стили сообщений — через :global, и это не прихоть.

    Сообщения создаёт СКРИПТ (addMsg), а Astro «прошивает» свои стили
    печатью data-astro-cid только на элементы из шаблона. Скриптовые
    элементы печати не получают — и правило `.bubble {…}` из компонента
    для них просто не существует. Из-за этого до 28.07.2026 вся переписка
    выводилась голым текстом: без пузырей, без синего цвета у гостя.
    Найдено визуальной проверкой окна, а не чтением кода — код выглядел
    правильным. Якорь .chat-log — из шаблона, он печать имеет.
  */
  .chat-log :global(.msg) {
    display: flex;
  }

  .chat-log :global(.msg-me) {
    justify-content: flex-end;
  }

  .chat-log :global(.bubble) {
    max-width: 86%;
    padding: 0.7rem 0.95rem;
    border-radius: 16px;
    font-size: 0.9rem;
    line-height: 1.55;
    overflow-wrap: break-word;
  }

  .chat-log :global(.msg-bot .bubble) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-bottom-left-radius: 5px;
    color: var(--text);
  }

  .chat-log :global(.msg-me .bubble) {
    background: var(--c-aegean-600);
    color: #fff;
    border-bottom-right-radius: 5px;
  }

  .chat-log :global(.bubble a) {
    color: var(--accent);
    text-decoration: underline;
  }

  /* Рисованный эмодзи в строке текста: по размеру буквы, чуть ниже
     базовой линии — как настоящий символ, а не приклеенная картинка */
  .chat-log :global(img.emo) {
    display: inline-block;
    width: 1.2em;
    height: 1.2em;
    vertical-align: -0.24em;
    margin: 0 0.04em;
  }

  /* Буква «пера»: мягко проявляется, а не вспыхивает */
  .chat-log :global(.pen-ch) {
    opacity: 0;
    animation: penIn 0.22s ease-out forwards;
  }

  /* Кончик пера: три мягко дышащие точки, как «печатает…» в мессенджерах.
     Просьба владельца 01.08.2026 — прежняя вертикальная черта походила
     на курсор ввода, а не на живое перо. */
  .chat-log :global(.pen-caret) {
    display: inline-flex;
    gap: 0.16em;
    margin-left: 0.16em;
    vertical-align: -0.1em;
  }

  .chat-log :global(.pen-caret span) {
    display: inline-block;
    width: 0.28em;
    height: 0.28em;
    border-radius: 50%;
    background: currentColor;
    animation: penCaret 1.1s ease-in-out infinite;
  }

  .chat-log :global(.pen-caret span:nth-child(2)) {
    animation-delay: 0.15s;
  }

  .chat-log :global(.pen-caret span:nth-child(3)) {
    animation-delay: 0.3s;
  }

  .chat-log :global(.msg-me .bubble a) {
    color: #fff;
  }

  /* Карточка «Написать Владимиру» — рисуется вместо маркера [CONTACTS]
     из ответа ИИ (как в боте-образце владельца). */
  .chat-log :global(.chat-contacts) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: 0.6rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--border);
  }

  .chat-log :global(.chat-contacts-label) {
    width: 100%;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .chat-log :global(.chat-contacts a) {
    display: inline-flex;
    align-items: center;
    padding: 0.45em 1em;
    border-radius: var(--radius-full);
    background: var(--c-aegean-600);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }

  .chat-log :global(.chat-contacts a:hover) {
    background: var(--c-aegean-800);
  }

  /* Фирменные цвета мессенджеров — по просьбе владельца 03.08.2026 */
  .chat-log :global(.chat-contact-wa) {
    background: #25d366;
  }
  .chat-log :global(.chat-contact-wa:hover) {
    background: #1da851;
  }
  .chat-log :global(.chat-contact-viber) {
    background: #7360f2;
  }
  .chat-log :global(.chat-contact-viber:hover) {
    background: #5b48d9;
  }
  .chat-log :global(.chat-contact-tg) {
    background: #229ed9;
  }
  .chat-log :global(.chat-contact-tg:hover) {
    background: #1b84b8;
  }

  .chat-log :global(.typing .bubble) {
    display: flex;
    gap: 4px;
    padding: 0.85rem 1rem;
  }

  .chat-log :global(.typing span) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-muted);
    animation: blink 1.3s infinite;
  }

  .chat-log :global(.typing span:nth-child(2)) {
    animation-delay: 0.18s;
  }

  .chat-log :global(.typing span:nth-child(3)) {
    animation-delay: 0.36s;
  }

  @keyframes blink {
    0%,
    60%,
    100% {
      opacity: 0.25;
    }
    30% {
      opacity: 1;
    }
  }

  @keyframes penIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes penCaret {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.15;
    }
  }

  .chat-form {
    display: flex;
    gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-4);
    background: var(--bg);
  }

  .chat-form input {
    flex: 1;
