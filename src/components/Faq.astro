---
interface Props {
  items: readonly { q: string; a: string }[];
  title?: string;
  eyebrow?: string;
}

const { items, title = 'Часто задаваемые вопросы', eyebrow = 'Вопросы и ответы' } = Astro.props;
---

<section class="section section-alt">
  <div class="container container-narrow">
    <header class="faq-head reveal">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="section-title">{title}</h2>
    </header>

    <div class="faq-list reveal">
      {
        items.map((item, i) => (
          <details class="faq-item" name="faq" open={i === 0}>
            <summary>
              <span>{item.q}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <div class="faq-answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-head {
    margin-bottom: var(--sp-6);
    text-align: center;
  }

  .faq-head .eyebrow::before {
    display: none;
  }

  .faq-list {
    display: grid;
    gap: var(--sp-3);
  }

  .faq-item {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }

  .faq-item[open] {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    box-shadow: var(--shadow-sm);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-5);
    cursor: pointer;
    font-weight: 600;
    font-size: var(--fs-base);
    list-style: none;
    transition: color var(--dur) var(--ease);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--accent);
  }

  summary svg {
    flex-shrink: 0;
    color: var(--accent);
    transition: transform var(--dur) var(--ease);
  }

  .faq-item[open] summary svg {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 var(--sp-5) var(--sp-5);
    color: var(--text-soft);
    font-size: var(--fs-sm);
    line-height: 1.7;
    animation: faqIn 300ms var(--ease);
  }

  @keyframes faqIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-answer {
      animation: none;
    }
  }
</style>
