---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  text?: string;
  /** Высокий вариант для главной, компактный — для внутренних страниц */
  size?: 'full' | 'compact';
  /**
   * Точка внимания кадра НА ТЕЛЕФОНЕ (значение CSS object-position).
   *
   * Узкий экран обрезает широкую панораму по бокам, и главный сюжет
   * фото может «уехать» за край: у панорамы Ии на главной синие купола
   * стояли правее центра и на телефоне прятались (замечание владельца
   * 06.08.2026). «70% 50%» = смотреть на точку в 70% ширины фото.
   * На компьютере не влияет: там действует обычный центр.
   */
  focusMobile?: string;

  /**
   * Грузить картинку в первую очередь.
   *
   * По умолчанию ДА — и это не перестраховка: шапка занимает верх экрана,
   * её картинка видна сразу при открытии и почти всегда является тем самым
   * «главным элементом», по которому Google меряет скорость сайта (LCP).
   * Ленивая загрузка для неё — прямая потеря: браузер сначала разбирает всю
   * страницу и только потом начинает качать то, что человек уже видит.
   *
   * Раньше умолчанием было «нет», и приоритет проставили только на главной.
   * Остальные 7 страниц с шапкой грузили её лениво.
   *
   * Ставить false осмысленно только там, где Hero уехал ниже первого экрана.
   */
  priority?: boolean;
}

const {
  image,
  alt,
  eyebrow,
  title,
  subtitle,
  text,
  size = 'compact',
  focusMobile,
  priority = true,
} = Astro.props;
---

<section class:list={['hero', `hero-${size}`]}>
  <div class="hero-media parallax-slow" style={focusMobile ? `--hero-focus-mobile: ${focusMobile}` : undefined}>
    <Image
      src={image}
      alt={alt}
      widths={[640, 960, 1440, 1920, 2400]}
      sizes="100vw"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      quality={80}
      format="avif"
    />
    <div class="hero-scrim"></div>
  </div>

  <div class="container hero-content hero-depth">
    {eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}
    <h1 class="hero-title">{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    {text && <p class="hero-text">{text}</p>}
    <div class="hero-actions">
      <slot />
    </div>
  </div>

  {
    size === 'full' && (
      <a href="#content" class="hero-scroll" aria-label="Листать вниз">
        <span />
      </a>
    )
  }
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    isolation: isolate;
    overflow: hidden;
  }

  /*
    Высота шапки.
    Считаем от высоты окна, а не жёсткими пикселями: на ноутбуке 768px
    шапка не должна занимать весь экран, а на мониторе 1440px — выглядеть
    узкой полоской. Верхний предел не даёт шапке стать бесконечной
    на очень высоких экранах.
  */
  .hero-full {
    min-height: clamp(30rem, 88dvh, 68rem);
  }

  .hero-compact {
    min-height: clamp(20rem, 56dvh, 40rem);
  }

  /*
    Телефон в горизонтальном положении: экран низкий, шапка на весь
    экран не оставит места контенту — уменьшаем.
  */
  @media (max-height: 520px) and (orientation: landscape) {
    .hero-full {
      min-height: 26rem;
    }

    .hero-compact {
      min-height: 18rem;
    }
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Точка внимания кадра на узких экранах — см. проп focusMobile выше. */
  @media (max-width: 700px) {
    .hero-media :global(img) {
      object-position: var(--hero-focus-mobile, 50% 50%);
    }
  }

  /*
    «Кен-бёрнс» — медленный наплыв на фото. Включаем только там, где НЕТ
    параллакса при прокрутке: иначе две анимации будут бороться за transform
    и картинка задёргается. Где параллакс есть — он и создаёт движение.
  */
  @supports not (animation-timeline: view()) {
    .hero-media :global(img) {
      animation: kenburns 24s var(--ease) infinite alternate;
    }

    @keyframes kenburns {
      from {
        transform: scale(1);
      }
      to {
        transform: scale(1.07);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-media :global(img) {
      animation: none;
    }
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(6 30 48 / 0.88) 0%, rgb(6 30 48 / 0.45) 42%, rgb(6 30 48 / 0.12) 75%),
      linear-gradient(to right, rgb(6 30 48 / 0.4), transparent 60%);
  }

  .hero-content {
    padding-block: clamp(2.5rem, 7vw, 6rem);
    color: #fff;
  }

  /*
    Ограничиваем длину строки, но НЕ шире экрана.
    min(…, 100%) обязателен: единица ch зависит от размера шрифта, а он
    на больших экранах крупный — без ограничения по 100% заголовок
    вылезал за край телефона на 378 пикселей.
  */
  .hero-content > * {
    max-width: min(34ch, 100%);
  }

  .hero-text {
    max-width: min(52ch, 100%);
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-sunset-200);
    margin-bottom: var(--sp-3);
  }

  .hero-title {
    font-size: var(--fs-4xl);
    color: #fff;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.35);
    max-width: min(18ch, 100%);
  }

  .hero-compact .hero-title {
    font-size: var(--fs-3xl);
    max-width: min(22ch, 100%);
  }

  .hero-subtitle {
    margin-top: var(--sp-3);
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 500;
    font-style: italic;
    color: var(--c-aegean-100);
  }

  .hero-text {
    margin-top: var(--sp-4);
    max-width: min(54ch, 100%);
    font-size: var(--fs-lg);
    color: rgb(255 255 255 / 0.9);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
  }

  .hero-actions:empty {
    display: none;
  }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: var(--sp-5);
    translate: -50% 0;
    width: 26px;
    height: 42px;
    border: 2px solid rgb(255 255 255 / 0.5);
    border-radius: var(--radius-full);
    display: grid;
    place-items: start center;
    padding-top: 7px;
  }

  .hero-scroll span {
    width: 3px;
    height: 8px;
    border-radius: 2px;
    background: #fff;
    animation: scrollDot 1.8s var(--ease) infinite;
  }

  @keyframes scrollDot {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    35% {
      opacity: 1;
    }
    70% {
      opacity: 0;
      transform: translateY(12px);
    }
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll span {
      animation: none;
    }
  }
</style>
