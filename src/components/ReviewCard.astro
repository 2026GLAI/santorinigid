---
/**
 * Карточка одного отзыва.
 *
 * Честность в деталях:
 *  • у каждой карточки — своя площадка-источник и прямая ссылка на оригинал;
 *  • ответ Владимира показываем ТОЛЬКО там, где он реально его написал;
 *  • оценок в звёздах нет — площадки их не используют;
 *  • длинные отзывы разворачиваются на CSS (<details>), текст целиком
 *    остаётся в HTML и виден поисковикам и ИИ.
 */
import type { Review } from '../data/reviews';

interface Props {
  review: Review;
  reveal?: boolean;
}

const { review: r, reveal = false } = Astro.props;

/** Инициалы для аватарки-заглушки — фото авторов у нас нет. */
const initials = r.author
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0]?.toUpperCase() ?? '')
  .join('');

/**
 * Длинные отзывы визуально подрезаем через CSS (line-clamp), а НЕ обрезаем
 * в разметке. Текст в HTML ровно один раз и всегда целиком: так его видят
 * поисковики и ИИ, и так в коде нет дублей.
 */
const isLong = r.text.length > 420;

/** Месяц поездки + состав компании — это честная замена звёздам. */
const context = [r.tripDate, r.tripWith].filter(Boolean).join(' · ');
---

<li class:list={['rv-item', { reveal }]} id={`review-${r.id}`}>
  <article class:list={['rv-card', { 'rv-card-answered': r.reply }]}>
    <header class="rv-card-head">
      <span class="rv-avatar" aria-hidden="true">{initials}</span>
      <span class="rv-who">
        <strong>{r.author}</strong>
        {context && <span class="rv-trip">{context}</span>}
      </span>
    </header>

    <blockquote class:list={['rv-text', { 'rv-text-long': isLong }]}>
      {
        isLong && (
          <input
            type="checkbox"
            id={`more-${r.id}`}
            class="rv-unclamp"
            aria-label={`Показать отзыв целиком: ${r.author}`}
          />
        )
      }
      <p>{r.text}</p>
      {
        isLong && (
          <label for={`more-${r.id}`} class="rv-expand">
            <span class="rv-expand-open">Читать целиком</span>
            <span class="rv-expand-close">Свернуть</span>
          </label>
        )
      }
    </blockquote>

    {
      r.reply && (
        <div class="rv-reply">
          <span class="rv-reply-label">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 14L4 9l5-5" />
              <path d="M4 9h11a5 5 0 015 5v6" />
            </svg>
            Ответ Владимира
          </span>
          <p>{r.reply}</p>
        </div>
      )
    }

    <footer class="rv-card-foot">
      <time datetime={r.datePublished}>{r.published}</time>
      <a href={r.sourceUrl} target="_blank" rel="noopener nofollow" class="rv-src">
        {r.source}
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17L17 7M9 7h8v8" />
        </svg>
      </a>
    </footer>
  </article>
</li>

<style>
  .rv-card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    height: 100%;
    padding: var(--sp-5);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .rv-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .rv-card-head {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .rv-avatar {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, var(--c-aegean-400), var(--c-aegean-800));
    color: #fff;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .rv-who {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    min-width: 0;
  }

  .rv-who strong {
    font-size: var(--fs-base);
  }

  .rv-trip {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .rv-text {
    position: relative;
    font-size: var(--fs-sm);
    line-height: 1.75;
    color: var(--text-soft);
  }

  /* Открывающая кавычка вместо рамки — тише и уместнее в гостевой книге */
  .rv-text > p::before {
    content: '«';
    color: color-mix(in srgb, var(--accent) 55%, transparent);
    font-family: var(--font-display);
    font-size: 1.15em;
  }

  .rv-text > p::after {
    content: '»';
    color: color-mix(in srgb, var(--accent) 55%, transparent);
    font-family: var(--font-display);
    font-size: 1.15em;
  }

  /*
    Длинные отзывы: подрезаем ПОКАЗ, а не текст. Сам текст лежит в HTML
    целиком и один раз — его видят поисковики и ИИ.
  */
  .rv-unclamp {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .rv-text-long > p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 8;
    line-clamp: 8;
    overflow: hidden;
  }

  .rv-unclamp:checked ~ p {
    -webkit-line-clamp: unset;
    line-clamp: unset;
    display: block;
  }

  .rv-expand {
    display: inline-block;
    margin-top: var(--sp-2);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--accent);
    cursor: pointer;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    transition: border-color var(--dur) var(--ease);
  }

  .rv-expand:hover {
    border-bottom-color: var(--accent);
  }

  .rv-expand-close {
    display: none;
  }

  .rv-unclamp:checked ~ .rv-expand .rv-expand-open {
    display: none;
  }

  .rv-unclamp:checked ~ .rv-expand .rv-expand-close {
    display: inline;
  }

  .rv-unclamp:focus-visible ~ .rv-expand {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /*
    Ответ Владимира — то, чего нет у конкурентов: живой диалог с гостем.
    Оформлен как переписка: с отступом, тише голосом гостя, но заметно.
  */
  .rv-reply {
    position: relative;
    margin-left: var(--sp-5);
    padding: var(--sp-3) var(--sp-4);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border-radius: var(--radius) var(--radius) var(--radius) 4px;
    font-size: 0.86rem;
    line-height: 1.65;
    color: var(--text-soft);
  }

  /* Хвостик реплики — как в мессенджере */
  .rv-reply::before {
    content: '';
    position: absolute;
    left: -6px;
    bottom: 0;
    width: 12px;
    height: 12px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
  }

  .rv-reply-label {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-bottom: var(--sp-1);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* Карточка с ответом чуть заметнее — на неё стоит посмотреть */
  .rv-card-answered {
    border-color: color-mix(in srgb, var(--accent) 28%, var(--border));
  }

  .rv-card-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: var(--sp-3);
    border-top: 1px solid var(--border);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .rv-src {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--text-muted);
    font-weight: 600;
    white-space: nowrap;
    transition: color var(--dur) var(--ease);
  }

  .rv-src:hover {
    color: var(--accent);
  }
</style>
